{
  "name": "wander-ui-htmx",
  "version": "1.0.0",
  "private": true,
  "description": "Wander UI - HTMX/Templ/Tailwind implementation",
  "scripts": {
    "prepare": "npm run vendor:alpine",
    "vendor:alpine": "cp node_modules/@alpinejs/csp/dist/cdn.min.js static/js/alpine.min.js",
    "install-tailwind": "./install-tailwind.sh",
    "build:css": "./bin/tailwindcss -i static/css/input.css -o static/css/output.css --minify",
    "build:css:dev": "./bin/tailwindcss -i static/css/input.css -o static/css/output.css",
    "watch:css": "./bin/tailwindcss -i static/css/input.css -o static/css/output.css --watch"
  },
  "dependencies": {
    "@alpinejs/csp": "3.15.4",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
