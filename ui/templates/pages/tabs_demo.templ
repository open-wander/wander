package pages

import (
	"github.com/open-wander/wander/ui/templates/components"
	"github.com/open-wander/wander/ui/templates/layouts"
)

// TabsDemoPage demonstrates the Tabs component with both static and HTMX modes
templ TabsDemoPage() {
	@layouts.PageLayout(
		layouts.PageLayoutProps{
			Title:       "Tabs Component Demo - Wander",
			Description: "Demonstration of the Tabs component with static and HTMX lazy-loading modes",
			CurrentPath: "/demo/tabs",
			Breadcrumbs: []components.Breadcrumb{
				{Label: "Home", URL: "/"},
				{Label: "Components", URL: "/components"},
				{Label: "Tabs Demo", URL: ""},
			},
		},
		tabsDemoContent(),
	)
}

// tabsDemoContent renders the demo page content
templ tabsDemoContent() {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<!-- Page Header -->
		<div class="mb-8">
			<h1 class="text-3xl font-bold text-neutral-900 mb-2">
				Tabs Component
			</h1>
			<p class="text-neutral-600">
				A flexible tabs component supporting both static (pre-loaded) and HTMX (lazy-loaded) modes.
			</p>
		</div>
		<!-- Static Tabs Example -->
		<section class="mb-12">
			<div class="bg-white shadow rounded-lg p-6">
				<h2 class="text-xl font-semibold text-neutral-900 mb-4">
					Static Tabs Example
				</h2>
				<p class="text-sm text-neutral-600 mb-6">
					All tab content is rendered upfront. Alpine.js handles visibility switching with no server requests.
				</p>
				@components.Tabs(components.TabsProps{
					Tabs: []components.Tab{
						{
							ID:      "overview",
							Label:   "Overview",
							Icon:    "home",
							Content: staticOverviewTab(),
							Active:  true,
						},
						{
							ID:      "analytics",
							Label:   "Analytics",
							Icon:    "chart",
							Content: staticAnalyticsTab(),
						},
						{
							ID:      "settings",
							Label:   "Settings",
							Icon:    "cog",
							Content: staticSettingsTab(),
						},
					},
					ActiveTab: "overview",
					Mode:      "static",
					PanelID:   "static-panel",
				})
			</div>
		</section>
		<!-- HTMX Tabs Example -->
		<section class="mb-12">
			<div class="bg-white shadow rounded-lg p-6">
				<h2 class="text-xl font-semibold text-neutral-900 mb-4">
					HTMX Tabs Example
				</h2>
				<p class="text-sm text-neutral-600 mb-6">
					Tab content is lazy-loaded from the server when clicked. Shows loading indicator during fetch.
				</p>
				<div class="bg-amber-50 border border-amber-200 rounded-md p-4 mb-6">
					<div class="flex">
						<div class="flex-shrink-0">
							<svg class="h-5 w-5 text-amber-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
							</svg>
						</div>
						<div class="ml-3">
							<p class="text-sm text-amber-700">
								<strong>Note:</strong> This example requires backend endpoints to be implemented.
								The URLs below are for demonstration purposes only.
							</p>
						</div>
					</div>
				</div>
				@components.Tabs(components.TabsProps{
					Tabs: []components.Tab{
						{
							ID:      "jobs",
							Label:   "Jobs",
							Icon:    "document",
							URL:     "/ui/demo/tabs/jobs",
							Content: htmxPlaceholderTab("jobs"),
							Active:  true,
						},
						{
							ID:      "allocations",
							Label:   "Allocations",
							Icon:    "user",
							URL:     "/ui/demo/tabs/allocations",
						},
						{
							ID:      "history",
							Label:   "History",
							Icon:    "clock",
							URL:     "/ui/demo/tabs/history",
						},
					},
					ActiveTab: "jobs",
					Mode:      "htmx",
					PanelID:   "htmx-panel",
				})
			</div>
		</section>
		<!-- Features Section -->
		<section class="mb-12">
			<div class="bg-white shadow rounded-lg p-6">
				<h2 class="text-xl font-semibold text-neutral-900 mb-4">
					Features
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div>
						<h3 class="text-sm font-medium text-neutral-900 mb-2">Accessibility</h3>
						<ul class="text-sm text-neutral-600 space-y-1">
							<li>• ARIA tabs pattern (role="tablist", role="tab", role="tabpanel")</li>
							<li>• Keyboard navigation (Arrow keys, Home, End)</li>
							<li>• aria-selected for active tab state</li>
							<li>• Focus management with tabindex</li>
						</ul>
					</div>
					<div>
						<h3 class="text-sm font-medium text-neutral-900 mb-2">Modes</h3>
						<ul class="text-sm text-neutral-600 space-y-1">
							<li>• <strong>Static:</strong> All content rendered upfront</li>
							<li>• <strong>HTMX:</strong> Lazy-load content on demand</li>
							<li>• Alpine.js for state management</li>
							<li>• Loading indicators for async requests</li>
						</ul>
					</div>
					<div>
						<h3 class="text-sm font-medium text-neutral-900 mb-2">Styling</h3>
						<ul class="text-sm text-neutral-600 space-y-1">
							<li>• Tailwind CSS utility classes</li>
							<li>• Active tab: border-b-2 border-primary-500</li>
							<li>• Hover states for inactive tabs</li>
							<li>• Focus ring for keyboard navigation</li>
						</ul>
					</div>
					<div>
						<h3 class="text-sm font-medium text-neutral-900 mb-2">Icons</h3>
						<ul class="text-sm text-neutral-600 space-y-1">
							<li>• Optional Heroicons support</li>
							<li>• Built-in icons: home, user, chart, cog, document, clock</li>
							<li>• Color changes with tab state</li>
							<li>• Easy to extend with more icons</li>
						</ul>
					</div>
				</div>
			</div>
		</section>
		<!-- Usage Section -->
		<section>
			<div class="bg-white shadow rounded-lg p-6">
				<h2 class="text-xl font-semibold text-neutral-900 mb-4">
					Usage
				</h2>
				<div class="space-y-6">
					<div>
						<h3 class="text-sm font-medium text-neutral-900 mb-2">Static Tabs</h3>
						<pre class="bg-neutral-900 text-neutral-100 p-4 rounded-md overflow-x-auto text-xs"><code>{ `@components.Tabs(components.TabsProps{
    Tabs: []components.Tab{
        {
            ID:      "overview",
            Label:   "Overview",
            Icon:    "home",
            Content: overviewContent(),
            Active:  true,
        },
        {
            ID:      "details",
            Label:   "Details",
            Content: detailsContent(),
        },
    },
    ActiveTab: "overview",
    Mode:      "static",
    PanelID:   "tab-panel",
})` }</code></pre>
					</div>
					<div>
						<h3 class="text-sm font-medium text-neutral-900 mb-2">HTMX Tabs</h3>
						<pre class="bg-neutral-900 text-neutral-100 p-4 rounded-md overflow-x-auto text-xs"><code>{ `@components.Tabs(components.TabsProps{
    Tabs: []components.Tab{
        {
            ID:      "jobs",
            Label:   "Jobs",
            URL:     "/api/jobs/123/overview",
            Content: placeholderContent(), // Initial content
            Active:  true,
        },
        {
            ID:      "allocations",
            Label:   "Allocations",
            URL:     "/api/jobs/123/allocations",
        },
    },
    ActiveTab: "jobs",
    Mode:      "htmx",
    PanelID:   "content-panel",
})` }</code></pre>
					</div>
				</div>
			</div>
		</section>
	</div>
}

// Static tab content examples
templ staticOverviewTab() {
	<div class="p-6 bg-neutral-50 rounded-md">
		<h3 class="text-lg font-medium text-neutral-900 mb-2">Overview</h3>
		<p class="text-neutral-600 mb-4">
			This is the overview tab. All content is pre-rendered and switching between tabs
			is instant with no server requests.
		</p>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
			<div class="bg-white p-4 rounded-md shadow-sm border border-neutral-200">
				<div class="text-2xl font-bold text-primary-600">24</div>
				<div class="text-sm text-neutral-600">Active Jobs</div>
			</div>
			<div class="bg-white p-4 rounded-md shadow-sm border border-neutral-200">
				<div class="text-2xl font-bold text-green-600">98.5%</div>
				<div class="text-sm text-neutral-600">Success Rate</div>
			</div>
			<div class="bg-white p-4 rounded-md shadow-sm border border-neutral-200">
				<div class="text-2xl font-bold text-blue-600">1,234</div>
				<div class="text-sm text-neutral-600">Total Allocations</div>
			</div>
		</div>
	</div>
}

templ staticAnalyticsTab() {
	<div class="p-6 bg-neutral-50 rounded-md">
		<h3 class="text-lg font-medium text-neutral-900 mb-2">Analytics</h3>
		<p class="text-neutral-600 mb-4">
			Analytics dashboard with charts and metrics. In a real application, this would
			contain interactive charts and data visualizations.
		</p>
		<div class="bg-white p-4 rounded-md shadow-sm border border-neutral-200">
			<div class="h-64 flex items-center justify-center border-2 border-dashed border-neutral-300 rounded">
				<div class="text-center">
					<svg class="mx-auto h-12 w-12 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
					</svg>
					<p class="mt-2 text-sm text-neutral-500">Chart placeholder</p>
				</div>
			</div>
		</div>
	</div>
}

templ staticSettingsTab() {
	<div class="p-6 bg-neutral-50 rounded-md">
		<h3 class="text-lg font-medium text-neutral-900 mb-2">Settings</h3>
		<p class="text-neutral-600 mb-4">
			Configuration options and preferences. This tab demonstrates form elements
			within a tab panel.
		</p>
		<form class="space-y-4">
			<div>
				<label for="setting-name" class="block text-sm font-medium text-neutral-700">Name</label>
				<input
					type="text"
					id="setting-name"
					class="mt-1 block w-full rounded-md border-neutral-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm"
					placeholder="Enter name"
				/>
			</div>
			<div>
				<label for="setting-description" class="block text-sm font-medium text-neutral-700">Description</label>
				<textarea
					id="setting-description"
					rows="3"
					class="mt-1 block w-full rounded-md border-neutral-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm"
					placeholder="Enter description"
				></textarea>
			</div>
			<div class="flex items-center">
				<input
					id="setting-enabled"
					type="checkbox"
					class="h-4 w-4 rounded border-neutral-300 text-primary-600 focus:ring-primary-500"
				/>
				<label for="setting-enabled" class="ml-2 block text-sm text-neutral-900">
					Enable this feature
				</label>
			</div>
			<div class="pt-4">
				<button
					type="submit"
					class="inline-flex justify-center rounded-md border border-transparent bg-primary-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
				>
					Save Settings
				</button>
			</div>
		</form>
	</div>
}

// HTMX tab content placeholder
templ htmxPlaceholderTab(tabName string) {
	<div class="p-6 bg-neutral-50 rounded-md">
		<p class="text-neutral-600">
			Initial content for { tabName } tab. Click other tabs to trigger HTMX requests.
		</p>
	</div>
}
