package jobs

import (
	"github.com/open-wander/wander/ui/templates/layouts"
	"github.com/open-wander/wander/ui/templates/partials/taskgrouppartials"
)

// TaskGroup renders the task group detail page with full page layout
templ TaskGroup(props layouts.PageLayoutProps, jobID string, tg taskgrouppartials.TaskGroupDetail) {
	@layouts.PageLayout(props, taskgrouppartials.DetailContent(jobID, tg))
}
