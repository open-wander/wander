package jobs

import (
	"github.com/open-wander/wander/ui/templates/layouts"
	"github.com/open-wander/wander/ui/templates/partials/jobspartials"
)

// Detail renders the job detail page with full page layout
templ Detail(layoutProps layouts.PageLayoutProps, job jobspartials.JobDetail) {
	@layouts.PageLayout(layoutProps, jobspartials.DetailContent(job))
}
