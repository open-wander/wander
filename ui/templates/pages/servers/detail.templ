package servers

import (
	"github.com/open-wander/wander/ui/templates/layouts"
	"github.com/open-wander/wander/ui/templates/partials/serverspartials"
)

// Detail renders the server detail page with full page layout
templ Detail(layoutProps layouts.PageLayoutProps, server serverspartials.ServerDetail) {
	@layouts.PageLayout(layoutProps, serverspartials.DetailContent(server))
}
