package variables

import (
	"github.com/open-wander/wander/ui/templates/layouts"
	"github.com/open-wander/wander/ui/templates/partials/variablespartials"
)

// Create renders the full variable create page with layout.
templ Create(layoutProps layouts.PageLayoutProps) {
	@layouts.PageLayout(layoutProps, variablespartials.CreateContent())
}
