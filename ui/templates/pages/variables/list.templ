package variables

import (
	"github.com/open-wander/wander/ui/templates/layouts"
	"github.com/open-wander/wander/ui/templates/partials/variablespartials"
)

// List renders the full variables list page with layout.
templ List(layoutProps layouts.PageLayoutProps, listProps variablespartials.ListProps) {
	@layouts.PageLayout(layoutProps, variablespartials.ListContent(listProps))
}
