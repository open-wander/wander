package evaluations

import (
	"github.com/open-wander/wander/ui/templates/layouts"
	"github.com/open-wander/wander/ui/templates/partials/evaluationspartials"
)

// List renders the full evaluations list page with layout.
templ List(layoutProps layouts.PageLayoutProps, props evaluationspartials.ListProps) {
	@layouts.PageLayout(layoutProps, evaluationspartials.ListContent(props))
}
