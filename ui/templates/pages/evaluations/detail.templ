package evaluations

import (
	"github.com/open-wander/wander/ui/templates/layouts"
	"github.com/open-wander/wander/ui/templates/partials/evaluationspartials"
)

// Detail renders the evaluation detail page with full page layout
templ Detail(layoutProps layouts.PageLayoutProps, eval evaluationspartials.EvaluationDetail) {
	@layouts.PageLayout(layoutProps, evaluationspartials.DetailContent(eval))
}
