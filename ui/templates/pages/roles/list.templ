package roles

import (
	"github.com/open-wander/wander/ui/templates/layouts"
	"github.com/open-wander/wander/ui/templates/partials/rolespartials"
)

templ List(props layouts.PageLayoutProps, items []rolespartials.RoleSummary, search string) {
	@layouts.PageLayout(props, rolespartials.ListContent(items, search))
}
