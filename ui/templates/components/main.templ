package components

// MainProps contains parameters for the main content area component
type MainProps struct {
	// Currently no specific props needed, but structure is here for future extension
	// Examples: MaxWidth string, Padding string, etc.
}

// Main provides the main content wrapper with proper padding and scroll container.
// This component wraps the page-specific content and ensures consistent spacing.
templ Main(props MainProps, content templ.Component) {
	<main
		id="main-content"
		class="min-h-0 flex-1 overflow-y-auto bg-neutral-50"
		role="main"
		tabindex="-1"
	>
		<div class="container mx-auto px-4 py-6 lg:px-6 lg:py-8 max-w-7xl">
			@content
		</div>
	</main>
}

// MainFullWidth is a variant without container constraints for pages that need full width
templ MainFullWidth(props MainProps, content templ.Component) {
	<main
		id="main-content"
		class="min-h-0 flex-1 overflow-y-auto bg-neutral-50"
		role="main"
		tabindex="-1"
	>
		@content
	</main>
}
