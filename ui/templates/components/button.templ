package components

import "strings"

// ButtonProps contains parameters for the Button component
type ButtonProps struct {
	Type     string // "button", "submit", "reset" - defaults to "button"
	Variant  string // "primary", "secondary", "danger", "ghost", "success", "warning", "info", etc.
	Size     string // "xs", "sm", "md", "lg", "xl" - defaults to "md"
	Outline  bool   // If true, uses outline variant (e.g., btn-outline-primary)
	Disabled bool   // Whether the button is disabled
	Loading  bool   // Show loading spinner
	Icon     string // Optional Heroicon name (e.g., "plus", "trash", "edit")
	IconPos  string // "left" or "right" - defaults to "left"
	Class    string // Additional CSS classes
	ID       string // Optional ID attribute
	Name     string // Optional name attribute (useful for form buttons)
	Value    string // Optional value attribute (useful for form buttons)
	// HTMX attributes
	HxGet     string // HTMX hx-get attribute
	HxPost    string // HTMX hx-post attribute
	HxPut     string // HTMX hx-put attribute
	HxDelete  string // HTMX hx-delete attribute
	HxPatch   string // HTMX hx-patch attribute
	HxTarget  string // HTMX hx-target attribute
	HxSwap    string // HTMX hx-swap attribute (defaults to "innerHTML")
	HxTrigger string // HTMX hx-trigger attribute
	HxConfirm string // HTMX hx-confirm attribute for confirmation dialogs
	// Alpine.js attributes
	AlpineClick string // Alpine.js @click handler
	// Accessibility
	AriaLabel string // ARIA label for accessibility
}

// Button renders a button component with support for variants, sizes, icons, loading states,
// and HTMX attributes.
//
// Features:
//   - Multiple variants: primary, secondary, danger, ghost, success, warning, info
//   - Outline variants for primary and danger
//   - Size variants: xs, sm, md (default), lg, xl
//   - Icon support with left/right positioning
//   - Loading state with spinner
//   - Full HTMX attribute support
//   - Alpine.js integration
//   - Disabled state styling
//   - Accessible with proper ARIA attributes
//
// Example Usage:
//
//	@Button(ButtonProps{
//	    Variant: "primary",
//	    Size: "md",
//	    Icon: "plus",
//	    HxPost: "/api/items",
//	    HxTarget: "#item-list",
//	}, "Create Item")
//
//	@Button(ButtonProps{
//	    Variant: "danger",
//	    Outline: true,
//	    Icon: "trash",
//	    IconPos: "right",
//	    HxDelete: "/api/items/123",
//	    HxConfirm: "Are you sure you want to delete this item?",
//	}, "Delete")
//
//	@Button(ButtonProps{
//	    Variant: "ghost",
//	    Loading: true,
//	}, "Loading...")
templ Button(props ButtonProps, label string) {
	<button
		if props.ID != "" {
			id={ props.ID }
		}
		if props.Name != "" {
			name={ props.Name }
		}
		if props.Value != "" {
			value={ props.Value }
		}
		type={ buttonType(props.Type) }
		class={ buildButtonClasses(props) }
		if props.Disabled || props.Loading {
			disabled
		}
		if props.HxGet != "" {
			hx-get={ props.HxGet }
		}
		if props.HxPost != "" {
			hx-post={ props.HxPost }
		}
		if props.HxPut != "" {
			hx-put={ props.HxPut }
		}
		if props.HxDelete != "" {
			hx-delete={ props.HxDelete }
		}
		if props.HxPatch != "" {
			hx-patch={ props.HxPatch }
		}
		if props.HxTarget != "" {
			hx-target={ props.HxTarget }
		}
		if props.HxSwap != "" {
			hx-swap={ props.HxSwap }
		}
		if props.HxTrigger != "" {
			hx-trigger={ props.HxTrigger }
		}
		if props.HxConfirm != "" {
			hx-confirm={ props.HxConfirm }
		}
		if props.AlpineClick != "" {
			@click={ props.AlpineClick }
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
	>
		if props.Loading {
			@buttonSpinner(props.Size)
			<span>{ label }</span>
		} else if props.Icon != "" && props.IconPos != "right" {
			@buttonIcon(props.Icon, props.Size)
			<span>{ label }</span>
		} else if props.Icon != "" && props.IconPos == "right" {
			<span>{ label }</span>
			@buttonIcon(props.Icon, props.Size)
		} else {
			<span>{ label }</span>
		}
	</button>
}

// IconButton renders an icon-only button without text label.
// Useful for toolbar buttons, close buttons, etc.
//
// Example Usage:
//
//	@IconButton(ButtonProps{
//	    Variant: "ghost",
//	    Size: "sm",
//	    Icon: "x-mark",
//	    AriaLabel: "Close",
//	    AlpineClick: "closeModal()",
//	})
templ IconButton(props ButtonProps) {
	<button
		if props.ID != "" {
			id={ props.ID }
		}
		if props.Name != "" {
			name={ props.Name }
		}
		if props.Value != "" {
			value={ props.Value }
		}
		type={ buttonType(props.Type) }
		class={ buildIconButtonClasses(props) }
		if props.Disabled || props.Loading {
			disabled
		}
		if props.HxGet != "" {
			hx-get={ props.HxGet }
		}
		if props.HxPost != "" {
			hx-post={ props.HxPost }
		}
		if props.HxPut != "" {
			hx-put={ props.HxPut }
		}
		if props.HxDelete != "" {
			hx-delete={ props.HxDelete }
		}
		if props.HxPatch != "" {
			hx-patch={ props.HxPatch }
		}
		if props.HxTarget != "" {
			hx-target={ props.HxTarget }
		}
		if props.HxSwap != "" {
			hx-swap={ props.HxSwap }
		}
		if props.HxTrigger != "" {
			hx-trigger={ props.HxTrigger }
		}
		if props.HxConfirm != "" {
			hx-confirm={ props.HxConfirm }
		}
		if props.AlpineClick != "" {
			@click={ props.AlpineClick }
		}
		if props.AriaLabel != "" {
			aria-label={ props.AriaLabel }
		}
	>
		if props.Loading {
			@buttonSpinner(props.Size)
		} else if props.Icon != "" {
			@buttonIcon(props.Icon, props.Size)
		}
	</button>
}

// buttonType returns the appropriate button type attribute value
func buttonType(t string) string {
	if t == "submit" || t == "reset" {
		return t
	}
	return "button"
}

// buildButtonClasses constructs the complete CSS class string for a button
func buildButtonClasses(props ButtonProps) string {
	classes := []string{"btn"}

	// Add variant class
	if props.Outline {
		if props.Variant == "primary" || props.Variant == "danger" {
			classes = append(classes, "btn-outline-"+props.Variant)
		} else {
			classes = append(classes, "btn-outline", "btn-"+props.Variant)
		}
	} else {
		variant := props.Variant
		if variant == "" {
			variant = "primary"
		}
		classes = append(classes, "btn-"+variant)
	}

	// Add size class
	size := props.Size
	if size != "" && size != "md" {
		classes = append(classes, "btn-"+size)
	}

	// Add custom classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}

	return strings.Join(classes, " ")
}

// buildIconButtonClasses constructs the CSS class string for an icon-only button
func buildIconButtonClasses(props ButtonProps) string {
	classes := []string{"btn"}

	// Add variant class
	if props.Outline {
		if props.Variant == "primary" || props.Variant == "danger" {
			classes = append(classes, "btn-outline-"+props.Variant)
		} else {
			classes = append(classes, "btn-outline", "btn-"+props.Variant)
		}
	} else {
		variant := props.Variant
		if variant == "" {
			variant = "primary"
		}
		classes = append(classes, "btn-"+variant)
	}

	// Add icon button size class
	size := props.Size
	if size == "xs" || size == "sm" {
		classes = append(classes, "btn-icon-sm")
	} else if size == "lg" || size == "xl" {
		classes = append(classes, "btn-icon-lg")
	} else {
		classes = append(classes, "btn-icon")
	}

	// Add custom classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}

	return strings.Join(classes, " ")
}

// buttonSpinner renders a loading spinner for the button
templ buttonSpinner(size string) {
	<svg
		class={ spinnerSize(size) }
		xmlns="http://www.w3.org/2000/svg"
		fill="none"
		viewBox="0 0 24 24"
	>
		<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
		<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
	</svg>
}

// spinnerSize returns the appropriate size classes for the spinner based on button size
func spinnerSize(size string) string {
	switch size {
	case "xs":
		return "animate-spin h-3 w-3"
	case "sm":
		return "animate-spin h-4 w-4"
	case "lg":
		return "animate-spin h-6 w-6"
	case "xl":
		return "animate-spin h-7 w-7"
	default:
		return "animate-spin h-5 w-5"
	}
}

// buttonIcon renders a Heroicon SVG for the button
templ buttonIcon(iconName string, size string) {
	<svg
		class={ iconSize(size) }
		xmlns="http://www.w3.org/2000/svg"
		fill="none"
		viewBox="0 0 24 24"
		stroke="currentColor"
		aria-hidden="true"
	>
		// Common Heroicons - extend as needed
		if iconName == "plus" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
		} else if iconName == "trash" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
		} else if iconName == "edit" || iconName == "pencil" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
		} else if iconName == "save" || iconName == "check" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
		} else if iconName == "x-mark" || iconName == "close" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
		} else if iconName == "arrow-left" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
		} else if iconName == "arrow-right" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
		} else if iconName == "download" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
		} else if iconName == "upload" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
		} else if iconName == "refresh" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
		} else if iconName == "search" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
		} else if iconName == "filter" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
		} else if iconName == "cog" || iconName == "settings" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
		} else if iconName == "eye" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
		} else if iconName == "eye-slash" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
		} else if iconName == "play" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
		} else if iconName == "stop" {
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"></path>
		} else {
			// Default icon - information circle
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
		}
	</svg>
}

// iconSize returns the appropriate size classes for the icon based on button size
func iconSize(size string) string {
	switch size {
	case "xs":
		return "h-3 w-3"
	case "sm":
		return "h-4 w-4"
	case "lg":
		return "h-6 w-6"
	case "xl":
		return "h-7 w-7"
	default:
		return "h-5 w-5"
	}
}
