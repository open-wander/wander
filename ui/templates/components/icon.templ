		<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
	} else if name == "upload" {
		<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
	} else if name == "filter" {
		<path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z"/>
	} else {
		// Default fallback - question mark circle
		<path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z"/>
	}
}

// iconClass generates the complete class string for the icon based on size and custom classes
func iconClass(props IconProps) string {
	size := props.Size
	if size == "" {
		size = "md"
	}

	var sizeClass string
	switch size {
	case "sm":
		sizeClass = "h-4 w-4"
	case "md":
		sizeClass = "h-5 w-5"
	case "lg":
		sizeClass = "h-6 w-6"
	case "xl":
		sizeClass = "h-8 w-8"
	default:
		sizeClass = "h-5 w-5" // default to md
	}

	if props.Class != "" {
		return sizeClass + " " + props.Class
	}
	return sizeClass
}
