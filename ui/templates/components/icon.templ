package components

// IconProps contains parameters for the Icon component
type IconProps struct {
	Name  string // icon name (e.g., "home", "briefcase", "check-circle")
	Size  string // "sm" (16px), "md" (20px), "lg" (24px), "xl" (32px) - defaults to "md"
	Class string // additional classes for color, margins, etc.
}

// Icon renders an inline SVG from Heroicons (outline style).
//
// Heroicons is the official icon library for Tailwind CSS, providing
// consistent, production-ready SVG icons with 24x24 viewBox.
//
// Features:
//   - Inline SVG for styling flexibility
//   - Size variants (sm: 16px, md: 20px, lg: 24px, xl: 32px)
//   - Inherits text color via currentColor
//   - ARIA-hidden for decorative icons
//
// Example Usage:
//   @Icon(IconProps{Name: "home", Size: "md"})
//   @Icon(IconProps{Name: "check-circle", Size: "sm", Class: "text-green-500 mr-2"})
//   @Icon(IconProps{Name: "exclamation-circle", Size: "lg", Class: "text-red-600"})
//
// All icons use Heroicons outline style (24x24 viewBox, 1.5 stroke width)
templ Icon(props IconProps) {
	<svg
		class={ iconClass(props) }
		xmlns="http://www.w3.org/2000/svg"
		fill="none"
		viewBox="0 0 24 24"
		stroke-width="1.5"
		stroke="currentColor"
		aria-hidden="true"
	>
		@iconPath(props.Name)
	</svg>
}

// iconPath returns the SVG path element(s) for a given icon name.
// Falls back to "question-mark-circle" if icon not found.
templ iconPath(name string) {
	// Navigation Icons
	if name == "home" {
		<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>
	} else if name == "briefcase" {
		<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z"/>
	} else if name == "server" {
		<path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z"/>
	} else if name == "cube" {
