package components

// EvaluationsPanelProps contains parameters for the evaluations panel component
type EvaluationsPanelProps struct {
	ID string // Unique identifier for the panel
}

// EvaluationsPanel renders a slide-out panel from the right side for displaying evaluations.
//
// Features:
//   - Alpine.js state management for open/close
//   - Escape key to close
//   - Click backdrop to close
//   - Body scroll lock when open
//   - Smooth slide animations from right
//   - HTMX loads content on open with auto-refresh
//
// Example Usage:
//   <div x-data="evaluationsPanel()">
//     <button @click="open">Show Evaluations</button>
//     @EvaluationsPanel(EvaluationsPanelProps{ID: "evaluations"})
//   </div>
templ EvaluationsPanel(props EvaluationsPanelProps) {
	<!-- Panel Container -->
	<div
		x-show="isOpen"
		x-cloak
		@keydown.escape.window="close"
		class="fixed inset-0 z-50 overflow-hidden"
		role="dialog"
		aria-modal="true"
		aria-labelledby={ "panel-title-" + props.ID }
	>
		<!-- Backdrop -->
		<div
			x-show="isOpen"
			x-cloak
			@click="close"
			x-transition:enter="transition-opacity ease-linear duration-300"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="transition-opacity ease-linear duration-300"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			class="fixed inset-0 bg-black bg-opacity-50"
			aria-hidden="true"
		></div>
		<!-- Panel -->
		<div class="fixed inset-y-0 right-0 flex max-w-full pl-10">
			<div
				x-show="isOpen"
				x-cloak
				@click.stop
				x-transition:enter="transform transition ease-in-out duration-300"
				x-transition:enter-start="translate-x-full"
				x-transition:enter-end="translate-x-0"
				x-transition:leave="transform transition ease-in-out duration-300"
				x-transition:leave-start="translate-x-0"
				x-transition:leave-end="translate-x-full"
				class="w-screen max-w-md"
			>
				<div class="h-full flex flex-col bg-white shadow-xl">
					<!-- Panel Header -->
					<div class="flex-shrink-0 px-6 py-4 border-b border-neutral-200 bg-white">
						<div class="flex items-center justify-between">
							<h2
								id={ "panel-title-" + props.ID }
								class="text-lg font-semibold text-neutral-900"
							>
								Recent Evaluations
							</h2>
							<button
								type="button"
								@click="close"
								class="rounded-md text-neutral-400 hover:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-primary-500"
								aria-label="Close panel"
							>
								<span class="sr-only">Close panel</span>
								<svg
									class="h-6 w-6"
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									aria-hidden="true"
								>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
					</div>
					<!-- Panel Content -->
					<div
						id={ "panel-content-" + props.ID }
						class="flex-1 overflow-y-auto bg-neutral-50"
						hx-get="/ui/evaluations"
						hx-trigger="load, every 5s"
						hx-swap="innerHTML"
						hx-push-url="false"
					>
						<!-- Content loaded via HTMX -->
						<div class="flex items-center justify-center h-32">
							<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600"></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
