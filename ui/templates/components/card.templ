package components

// CardProps contains parameters for the Card component
type CardProps struct {
	Title    string // Optional title displayed in header
	Subtitle string // Optional subtitle displayed in header
	Padding  string // "none", "sm", "md", "lg" - controls body padding
	Border   bool   // show border
	Shadow   bool   // show shadow
	Hover    bool   // enable hover effects (for clickable cards)
	Loading  bool   // show loading skeleton state
	Class    string // additional CSS classes
}

// Card renders a flexible card container with optional header, body, and footer sections.
//
// Features:
//   - Flexible slot pattern for header/body/footer
//   - Optional title and subtitle in header
//   - Configurable padding levels
//   - Optional border and shadow
//   - Hover effects for clickable cards
//   - Loading skeleton state
//   - Dark mode support
//
// Example Basic Usage:
//   @Card(CardProps{}) {
//       @CardBody() {
//           <p>Simple card content</p>
//       }
//   }
//
// Example Full Featured Usage:
//   @Card(CardProps{Title: "Dashboard", Subtitle: "Overview", Shadow: true, Hover: true}) {
//       @CardHeader() {
//           <div class="flex items-center justify-between">
//               <h3 class="text-lg font-semibold">Custom Header</h3>
//               <button>Action</button>
//           </div>
//       }
//       @CardBody() {
//           <p>Main content here</p>
//       }
//       @CardFooter() {
//           <div class="flex justify-end gap-2">
//               <button>Cancel</button>
//               <button>Save</button>
//           </div>
//       }
//   }
templ Card(props CardProps) {
	<div
		class={
			cardClasses(props)
		}
	>
		{ children... }
	</div>
}

// CardHeader renders the header section of a card.
// Can contain custom content via children or use the Card's Title/Subtitle props.
templ CardHeader() {
	<div class="card-header">
		{ children... }
	</div>
}

// CardHeaderTitle renders a standard header with title and optional subtitle.
// Used when you want the default title/subtitle layout.
templ CardHeaderTitle(title string, subtitle string) {
	<div class="card-header">
		<div>
			<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">
				{ title }
			</h3>
			if subtitle != "" {
				<p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
					{ subtitle }
				</p>
			}
		</div>
	</div>
}

// CardBody renders the main content area of a card.
// Accepts custom content via children slot.
templ CardBody() {
	<div class="card-body">
		{ children... }
	</div>
}

// CardBodyWithPadding renders the card body with custom padding.
// Padding options: "none", "sm", "md", "lg"
templ CardBodyWithPadding(padding string) {
	<div class={ bodyPaddingClass(padding) }>
		{ children... }
	</div>
}

// CardFooter renders the footer section of a card.
// Typically used for actions, buttons, or metadata.
templ CardFooter() {
	<div class="card-footer">
		{ children... }
	</div>
}

// CardSkeleton renders a loading skeleton state for the card.
// Used when content is being loaded asynchronously.
templ CardSkeleton(showHeader bool, showFooter bool) {
	<div class="card animate-pulse">
		if showHeader {
			<div class="card-header">
				<div class="h-4 bg-neutral-200 dark:bg-neutral-700 rounded w-1/3"></div>
				<div class="h-3 bg-neutral-200 dark:bg-neutral-700 rounded w-1/2 mt-2"></div>
			</div>
		}
		<div class="card-body space-y-3">
			<div class="h-4 bg-neutral-200 dark:bg-neutral-700 rounded"></div>
			<div class="h-4 bg-neutral-200 dark:bg-neutral-700 rounded w-5/6"></div>
			<div class="h-4 bg-neutral-200 dark:bg-neutral-700 rounded w-4/6"></div>
		</div>
		if showFooter {
			<div class="card-footer">
				<div class="h-8 bg-neutral-200 dark:bg-neutral-700 rounded w-20"></div>
			</div>
		}
	</div>
}

// cardClasses generates the CSS classes for the card container
func cardClasses(props CardProps) string {
	classes := "card"

	// Override base border/shadow if props specify
	if !props.Border {
		classes += " !border-0"
	}

	if !props.Shadow {
		classes += " !shadow-none"
	}

	// Add hover effects for clickable cards
	if props.Hover {
		classes += " transition-shadow duration-200 hover:shadow-lg cursor-pointer"
	}

	// Add custom classes
	if props.Class != "" {
		classes += " " + props.Class
	}

	return classes
}

// bodyPaddingClass returns the appropriate padding class for card body
func bodyPaddingClass(padding string) string {
	switch padding {
	case "none":
		return "p-0"
	case "sm":
		return "p-2"
	case "md":
		return "p-4" // default
	case "lg":
		return "p-6"
	default:
		return "card-body" // uses default card-body class (p-4)
	}
}
