package components

// ConnectionStatusProps contains parameters for the connection status indicator
type ConnectionStatusProps struct {
	ID string // Optional unique ID for the indicator
}

// ConnectionStatus displays a connection status indicator that monitors SSE/WebSocket connections.
// Shows visual states: connected (green), disconnected (red), reconnecting (yellow with animation).
// Uses Alpine.js for state management and monitors global connection health.
//
// Usage:
//   @components.ConnectionStatus(components.ConnectionStatusProps{ID: "conn-status"})
templ ConnectionStatus(props ConnectionStatusProps) {
	<div
		id={ props.ID }
		x-data="connectionStatus()"
		x-init="init()"
		class="flex items-center space-x-2"
		x-cloak
	>
		<!-- Connection indicator dot -->
		<div class="relative flex items-center">
			<div
				class="h-2 w-2 rounded-full transition-all duration-300"
				:class="{
					'bg-green-500': state === 'connected',
					'bg-red-500': state === 'disconnected',
					'bg-yellow-500': state === 'connecting' || state === 'reconnecting',
					'bg-neutral-400': state === 'error'
				}"
			></div>
			<!-- Pulse animation for connecting/reconnecting state -->
			<div
				x-show="state === 'connecting' || state === 'reconnecting'"
				class="absolute h-2 w-2 rounded-full bg-yellow-400 animate-ping"
			></div>
		</div>
		<!-- Connection status text (optional, shown on hover or always) -->
		<span
			class="text-xs text-neutral-600 hidden md:inline-block"
			:class="{
				'text-green-600': state === 'connected',
				'text-red-600': state === 'disconnected',
				'text-yellow-600': state === 'connecting' || state === 'reconnecting',
				'text-neutral-500': state === 'error'
			}"
			x-text="statusText"
		></span>
		<!-- Tooltip for detailed status (mobile-friendly) -->
		<div
			x-show="showTooltip"
			@click.away="showTooltip = false"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 scale-95"
			x-transition:enter-end="opacity-100 scale-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 scale-100"
			x-transition:leave-end="opacity-0 scale-95"
			class="absolute right-0 top-8 z-50 w-64 rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 p-3 md:hidden"
		>
			<div class="text-sm">
				<div class="font-medium text-neutral-900 mb-1" x-text="statusText"></div>
				<div class="text-neutral-500 text-xs" x-show="lastConnectedAt" x-text="'Last connected: ' + lastConnectedAt"></div>
				<div class="text-neutral-500 text-xs" x-show="retryCount > 0" x-text="'Retry attempts: ' + retryCount"></div>
				<button
					x-show="state === 'disconnected' || state === 'error'"
					@click="reconnect()"
					class="mt-2 w-full px-3 py-1 bg-primary-600 text-white text-xs rounded-md hover:bg-primary-700 transition-colors"
				>
					Reconnect Now
				</button>
			</div>
		</div>
		<!-- Toggle tooltip on mobile -->
		<button
			type="button"
			@click="showTooltip = !showTooltip"
			class="md:hidden p-1 text-neutral-400 hover:text-neutral-600"
			aria-label="Connection status details"
		>
			<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
		</button>
	</div>
}
