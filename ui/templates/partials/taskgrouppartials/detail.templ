package taskgrouppartials

import (
	"fmt"
	"github.com/open-wander/wander/ui/templates/components"
	"time"
)

// TaskGroupDetail represents detailed information about a task group
type TaskGroupDetail struct {
	Name              string
	Count             int
	Tasks             []TaskDetail
	Scaling           *ScalingConfig
	PlacementFailures []PlacementFailure
}

// TaskDetail represents a task within a task group
type TaskDetail struct {
	Name      string
	Driver    string
	Resources ResourceConfig
}

// ResourceConfig represents resource requirements for a task
type ResourceConfig struct {
	CPU      int
	Memory   int
	DiskMB   int
	Networks []NetworkResource
}

// NetworkResource represents network requirements
type NetworkResource struct {
	MBits int
}

// ScalingConfig represents autoscaling configuration
type ScalingConfig struct {
	Enabled bool
	Min     int
	Max     int
	Policy  ScalingPolicy
}

// ScalingPolicy represents scaling policy parameters
type ScalingPolicy struct {
	Cooldown            string
	EvaluationInterval  string
	TargetCPUPercent    int
	TargetMemoryPercent int
}

// PlacementFailure represents a failed placement attempt
type PlacementFailure struct {
	Node      string
	Reason    string
	Timestamp time.Time
}

// DetailContent renders the task group detail page content (without layout)
templ DetailContent(jobID string, tg TaskGroupDetail) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<!-- Task Group Header -->
		<div class="bg-white shadow rounded-lg p-6 mb-6">
			<div class="flex items-center justify-between">
				<div class="flex items-center space-x-4">
					<h1 class="text-3xl font-bold text-neutral-900">{ tg.Name }</h1>
					<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-100 text-primary-800">
						{ fmt.Sprintf("%d instances", tg.Count) }
					</span>
				</div>
			</div>
		</div>
		<!-- Scaling Controls -->
		@ScalingControls(jobID, tg)
		<!-- Placement Failures -->
		if len(tg.PlacementFailures) > 0 {
			<div class="bg-red-50 border border-red-200 rounded-lg p-6 mb-6">
				<div class="flex items-start">
					<div class="flex-shrink-0">
						@components.Icon(components.IconProps{Name: "exclamation-triangle", Size: "md", Class: "text-red-600"})
					</div>
					<div class="ml-3 flex-1">
						<h3 class="text-sm font-medium text-red-800 mb-2">Placement Failures</h3>
						<div class="space-y-2">
							for _, failure := range tg.PlacementFailures {
								<div class="bg-white rounded p-3 border border-red-200">
									<div class="flex items-start justify-between mb-1">
										<span class="text-sm font-medium text-neutral-900">{ failure.Node }</span>
										<span class="text-xs text-neutral-500">{ formatTime(failure.Timestamp) }</span>
									</div>
									<p class="text-sm text-neutral-700">{ failure.Reason }</p>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		}
		<!-- Scaling Configuration -->
		if tg.Scaling != nil && tg.Scaling.Enabled {
			<div class="bg-white shadow rounded-lg p-6 mb-6">
				<h3 class="text-lg font-semibold text-neutral-900 mb-4">Autoscaling Configuration</h3>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
					<div class="bg-neutral-50 border border-neutral-200 rounded-lg p-4">
						<dt class="text-sm font-medium text-neutral-500">Min Instances</dt>
						<dd class="mt-1 text-2xl font-semibold text-neutral-900">{ fmt.Sprintf("%d", tg.Scaling.Min) }</dd>
					</div>
					<div class="bg-neutral-50 border border-neutral-200 rounded-lg p-4">
						<dt class="text-sm font-medium text-neutral-500">Max Instances</dt>
						<dd class="mt-1 text-2xl font-semibold text-neutral-900">{ fmt.Sprintf("%d", tg.Scaling.Max) }</dd>
					</div>
					<div class="bg-neutral-50 border border-neutral-200 rounded-lg p-4">
						<dt class="text-sm font-medium text-neutral-500">CPU Target</dt>
						<dd class="mt-1 text-2xl font-semibold text-neutral-900">{ fmt.Sprintf("%d%%", tg.Scaling.Policy.TargetCPUPercent) }</dd>
					</div>
					<div class="bg-neutral-50 border border-neutral-200 rounded-lg p-4">
						<dt class="text-sm font-medium text-neutral-500">Memory Target</dt>
						<dd class="mt-1 text-2xl font-semibold text-neutral-900">{ fmt.Sprintf("%d%%", tg.Scaling.Policy.TargetMemoryPercent) }</dd>
					</div>
				</div>
				<div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
					<div class="bg-neutral-50 border border-neutral-200 rounded-lg p-4">
						<dt class="text-sm font-medium text-neutral-500">Cooldown Period</dt>
						<dd class="mt-1 text-sm text-neutral-900">{ tg.Scaling.Policy.Cooldown }</dd>
					</div>
					<div class="bg-neutral-50 border border-neutral-200 rounded-lg p-4">
						<dt class="text-sm font-medium text-neutral-500">Evaluation Interval</dt>
						<dd class="mt-1 text-sm text-neutral-900">{ tg.Scaling.Policy.EvaluationInterval }</dd>
					</div>
				</div>
			</div>
		}
		<!-- Tasks List -->
		<div class="bg-white shadow rounded-lg p-6">
			<h3 class="text-lg font-semibold text-neutral-900 mb-4">Tasks</h3>
			<div class="space-y-4">
				for _, task := range tg.Tasks {
					<div class="bg-neutral-50 border border-neutral-200 rounded-lg p-6">
						<div class="flex items-center justify-between mb-4">
							<div class="flex items-center space-x-3">
								<h4 class="text-lg font-medium text-neutral-900">{ task.Name }</h4>
								@components.Badge(components.BadgeProps{
									Variant: "info",
									Size:    "sm",
								}) {
									{ task.Driver }
								}
							</div>
						</div>
						<!-- Resource Requirements -->
						<div>
							<h5 class="text-sm font-medium text-neutral-700 mb-3">Resource Requirements</h5>
							<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
								<div class="bg-white border border-neutral-200 rounded p-3">
									<dt class="text-xs font-medium text-neutral-500 uppercase">CPU</dt>
									<dd class="mt-1 text-lg font-semibold text-neutral-900">{ fmt.Sprintf("%d MHz", task.Resources.CPU) }</dd>
								</div>
								<div class="bg-white border border-neutral-200 rounded p-3">
									<dt class="text-xs font-medium text-neutral-500 uppercase">Memory</dt>
									<dd class="mt-1 text-lg font-semibold text-neutral-900">{ fmt.Sprintf("%d MB", task.Resources.Memory) }</dd>
								</div>
								<div class="bg-white border border-neutral-200 rounded p-3">
									<dt class="text-xs font-medium text-neutral-500 uppercase">Disk</dt>
									<dd class="mt-1 text-lg font-semibold text-neutral-900">{ fmt.Sprintf("%d MB", task.Resources.DiskMB) }</dd>
								</div>
								if len(task.Resources.Networks) > 0 {
									<div class="bg-white border border-neutral-200 rounded p-3">
										<dt class="text-xs font-medium text-neutral-500 uppercase">Network</dt>
										<dd class="mt-1 text-lg font-semibold text-neutral-900">{ fmt.Sprintf("%d Mbps", task.Resources.Networks[0].MBits) }</dd>
									</div>
								}
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
}

// formatTime formats a time.Time for display
func formatTime(t time.Time) string {
	now := time.Now()
	diff := now.Sub(t)

	if diff < time.Minute {
		return "just now"
	} else if diff < time.Hour {
		mins := int(diff.Minutes())
		if mins == 1 {
			return "1 minute ago"
		}
		return fmt.Sprintf("%d minutes ago", mins)
	} else if diff < 24*time.Hour {
		hours := int(diff.Hours())
		if hours == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", hours)
	}

	return t.Format("Jan 2, 2006 3:04 PM")
}

// ScalingControls renders the scaling controls section for a task group
templ ScalingControls(jobID string, tg TaskGroupDetail) {
	<div
		class="bg-white shadow rounded-lg p-6 mb-6"
		x-data={ fmt.Sprintf(`{
			count: %d,
			originalCount: %d,
			minCount: %d,
			maxCount: %d,
			hasConstraints: %t,
			showConfirmModal: false,
			increment() {
				if (!this.hasConstraints || this.count < this.maxCount) {
					this.count++;
				}
			},
			decrement() {
				if (this.count > 0 && (!this.hasConstraints || this.count > this.minCount)) {
					this.count--;
				}
			},
			canIncrement() {
				return !this.hasConstraints || this.count < this.maxCount;
			},
			canDecrement() {
				return this.count > 0 && (!this.hasConstraints || this.count > this.minCount);
			},
			hasChanges() {
				return this.count !== this.originalCount;
			},
			openConfirmModal() {
				if (this.hasChanges()) {
					this.showConfirmModal = true;
				}
			},
			closeConfirmModal() {
				this.showConfirmModal = false;
			},
			resetCount() {
				this.count = this.originalCount;
			}
		}`, tg.Count, tg.Count, getMinCount(tg.Scaling), getMaxCount(tg.Scaling), tg.Scaling != nil && tg.Scaling.Enabled) }
	>
		<div class="flex items-center justify-between mb-4">
			<h3 class="text-lg font-semibold text-neutral-900">Scale Task Group</h3>
			if tg.Scaling != nil && tg.Scaling.Enabled {
				<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
					Autoscaling Enabled
				</span>
			}
		</div>
		<!-- Scaling Constraints Info -->
		if tg.Scaling != nil && tg.Scaling.Enabled {
			<div class="bg-neutral-50 border border-neutral-200 rounded-lg p-4 mb-4">
				<div class="flex items-center space-x-4 text-sm">
					<div class="flex items-center space-x-2">
						<span class="text-neutral-500">Min:</span>
						<span class="font-medium text-neutral-900">{ fmt.Sprintf("%d", tg.Scaling.Min) }</span>
					</div>
					<div class="flex items-center space-x-2">
						<span class="text-neutral-500">Max:</span>
						<span class="font-medium text-neutral-900">{ fmt.Sprintf("%d", tg.Scaling.Max) }</span>
					</div>
					<div class="text-neutral-400">|</div>
					<div class="flex items-center space-x-2">
						<span class="text-neutral-500">Current:</span>
						<span class="font-medium text-neutral-900">{ fmt.Sprintf("%d", tg.Count) }</span>
					</div>
				</div>
			</div>
		}
		<!-- Scaling Controls -->
		<div class="flex items-center space-x-4">
			<!-- Decrement Button -->
			<button
				type="button"
				@click="decrement()"
				:disabled="!canDecrement()"
				class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-neutral-300 bg-white text-neutral-700 hover:bg-neutral-50 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-white transition-colors"
				aria-label="Decrease count"
			>
				@components.Icon(components.IconProps{Name: "minus", Size: "md"})
			</button>
			<!-- Count Input -->
			<div class="relative">
				<input
					type="number"
					x-model.number="count"
					:min="hasConstraints ? minCount : 0"
					:max="hasConstraints ? maxCount : undefined"
					class="w-24 h-10 text-center text-lg font-semibold border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
					aria-label="Instance count"
				/>
			</div>
			<!-- Increment Button -->
			<button
				type="button"
				@click="increment()"
				:disabled="!canIncrement()"
				class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-neutral-300 bg-white text-neutral-700 hover:bg-neutral-50 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-white transition-colors"
				aria-label="Increase count"
			>
				@components.Icon(components.IconProps{Name: "plus", Size: "md"})
			</button>
			<!-- Spacer -->
			<div class="flex-1"></div>
			<!-- Reset Button -->
			<button
				type="button"
				@click="resetCount()"
				x-show="hasChanges()"
				class="inline-flex items-center px-3 py-2 border border-neutral-300 rounded-lg text-sm font-medium text-neutral-700 bg-white hover:bg-neutral-50 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-colors"
			>
				Reset
			</button>
			<!-- Scale Button -->
			@components.Button(components.ButtonProps{
				Variant:     "primary",
				Size:        "md",
				AlpineClick: "openConfirmModal()",
				Class:       "ml-2",
			}, "Scale")
		</div>
		<!-- Change indicator -->
		<div
			x-show="hasChanges()"
			x-cloak
			class="mt-4 flex items-center text-sm"
		>
			<template x-if="count > originalCount">
				<span class="flex items-center text-green-600">
					@components.Icon(components.IconProps{Name: "arrow-up", Size: "sm", Class: "mr-1"})
					<span>Scaling up by <span x-text="count - originalCount" class="font-medium"></span> instance(s)</span>
				</span>
			</template>
			<template x-if="count < originalCount">
				<span class="flex items-center text-amber-600">
					@components.Icon(components.IconProps{Name: "arrow-down", Size: "sm", Class: "mr-1"})
					<span>Scaling down by <span x-text="originalCount - count" class="font-medium"></span> instance(s)</span>
				</span>
			</template>
		</div>
		<!-- Scale Confirmation Modal -->
		@ScaleConfirmModal(jobID, tg.Name)
	</div>
}

// ScaleConfirmModal renders the confirmation modal for scaling operations
templ ScaleConfirmModal(jobID string, taskGroupName string) {
	<!-- Modal Backdrop and Container -->
	<div
		x-show="showConfirmModal"
		x-cloak
		@keydown.escape.window="closeConfirmModal()"
		class="fixed inset-0 z-50 overflow-y-auto"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		role="dialog"
		aria-modal="true"
		aria-labelledby="scale-modal-title"
	>
		<!-- Backdrop -->
		<div
			@click="closeConfirmModal()"
			class="fixed inset-0 bg-black bg-opacity-50 transition-opacity"
			aria-hidden="true"
		></div>
		<!-- Modal positioning container -->
		<div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
			<!-- Modal content -->
			<div
				@click.stop
				class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-md"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
				x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
				x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
			>
				<!-- Modal Header -->
				<div class="sticky top-0 z-10 bg-white border-b border-neutral-200 px-6 py-4">
					<div class="flex items-center justify-between">
						<h3 id="scale-modal-title" class="text-lg font-semibold leading-6 text-neutral-900">
							Confirm Scale Operation
						</h3>
						<button
							type="button"
							@click="closeConfirmModal()"
							class="rounded-md bg-white text-neutral-400 hover:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
							aria-label="Close"
						>
							<span class="sr-only">Close</span>
							@components.Icon(components.IconProps{Name: "x", Size: "lg"})
						</button>
					</div>
				</div>
				<!-- Modal Body -->
				<div class="px-6 py-4">
					<div class="flex items-start space-x-4">
						<div class="flex-shrink-0">
							<div class="h-10 w-10 rounded-full bg-amber-100 flex items-center justify-center">
								@components.Icon(components.IconProps{Name: "exclamation-triangle", Size: "md", Class: "text-amber-600"})
							</div>
						</div>
						<div class="flex-1">
							<p class="text-sm text-neutral-600 mb-4">
								You are about to scale the task group <span class="font-semibold text-neutral-900">{ taskGroupName }</span>.
							</p>
							<div class="bg-neutral-50 rounded-lg p-4 space-y-2">
								<div class="flex justify-between text-sm">
									<span class="text-neutral-500">Current Count:</span>
									<span class="font-medium text-neutral-900" x-text="originalCount"></span>
								</div>
								<div class="flex justify-between text-sm">
									<span class="text-neutral-500">New Count:</span>
									<span class="font-medium text-neutral-900" x-text="count"></span>
								</div>
								<div class="border-t border-neutral-200 pt-2 mt-2">
									<div class="flex justify-between text-sm">
										<span class="text-neutral-500">Change:</span>
										<span
											:class="count > originalCount ? 'text-green-600' : 'text-amber-600'"
											class="font-medium"
										>
											<span x-text="count > originalCount ? '+' : ''"></span><span x-text="count - originalCount"></span> instance(s)
										</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!-- Modal Footer -->
				<div class="sticky bottom-0 z-10 bg-neutral-50 border-t border-neutral-200 px-6 py-4">
					<div class="flex justify-end space-x-3">
						<button
							type="button"
							@click="closeConfirmModal()"
							class="inline-flex items-center px-4 py-2 border border-neutral-300 rounded-lg text-sm font-medium text-neutral-700 bg-white hover:bg-neutral-50 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-colors"
						>
							Cancel
						</button>
						<form
							hx-post={ fmt.Sprintf("/ui/jobs/%s/taskgroups/%s/scale", jobID, taskGroupName) }
							hx-target="#scale-result"
							hx-swap="innerHTML"
							@htmx:after-request="if(event.detail.successful) { closeConfirmModal(); originalCount = count; }"
						>
							<input type="hidden" name="count" :value="count"/>
							<button
								type="submit"
								class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-colors"
							>
								Confirm Scale
							</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Scale Result Notification Area -->
	<div id="scale-result" class="mt-4"></div>
}

// getMinCount returns the minimum count from scaling config, or 0 if not configured
func getMinCount(scaling *ScalingConfig) int {
	if scaling != nil && scaling.Enabled {
		return scaling.Min
	}
	return 0
}

// getMaxCount returns the maximum count from scaling config, or 999 if not configured
func getMaxCount(scaling *ScalingConfig) int {
	if scaling != nil && scaling.Enabled {
		return scaling.Max
	}
	return 999
}
