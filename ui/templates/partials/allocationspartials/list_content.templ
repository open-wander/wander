package allocationspartials

import (
	"fmt"
	"net/url"
	"time"

	"github.com/open-wander/wander/ui/templates/components"
)

// AllocationSummary represents a summary view of an allocation for list display.
type AllocationSummary struct {
	ID                 string
	JobID              string
	JobType            string
	JobVersion         uint64
	TaskGroup          string
	NodeID             string
	NodeName           string
	Status             string
	DesiredStatus      string
	DesiredDescription string
	Created            time.Time
	IDPrefixMatch      bool   // True if this allocation matched by ID prefix search
	MatchedPrefix      string // The search term that matched the ID prefix (for highlighting)
	DetailURL          string
	JobURL             string
	ClientURL          string
	LogsURL            string
}

// FilterOptions contains the available options for each filter.
type FilterOptions struct {
	Statuses        []string // Available client status options
	Jobs            []string // Available job IDs
	JobTypes        []string // Available job kinds
	TaskGroups      []string // Available task groups
	Nodes           []string // Available client names
	DesiredStatuses []string // Available scheduling states
}

// ListFilters contains the current filter selections.
type ListFilters struct {
	Namespace     string // Selected namespace scope
	Region        string // Selected region scope
	Status        string // Selected client status filter
	Job           string // Selected job filter
	JobType       string // Selected job kind filter
	TaskGroup     string // Selected task group filter
	Node          string // Selected client filter
	DesiredStatus string // Selected scheduling filter
	Search        string // Search query
}

// PaginationMeta holds pagination metadata for list views.
type PaginationMeta struct {
	Page       int // Current page (1-indexed)
	PerPage    int // Items per page
	Total      int // Total number of items
	TotalPages int // Total number of pages
}

// ListProps contains all props for the allocations list view.
type ListProps struct {
	Allocations   []AllocationSummary
	FilterOptions FilterOptions
	Filters       ListFilters
	Pagination    PaginationMeta
	SortColumn    string
	SortDir       string
}

// ListContent renders the allocations table content for HTMX partial updates.
templ ListContent(props ListProps) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="sm:flex sm:items-center sm:justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">Allocations</h1>
				<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">
					View and manage Wander allocations
				</p>
			</div>
		</div>
		<form id="allocation-filters" class="mb-6 rounded-lg border border-neutral-200 bg-white p-4 shadow-sm dark:border-neutral-700 dark:bg-neutral-900" method="get" action="/ui/allocations" hx-get="/ui/allocations" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">
			if props.Filters.Namespace != "" {
				<input type="hidden" name="namespace" value={ props.Filters.Namespace }/>
			}
			if props.Filters.Region != "" {
				<input type="hidden" name="region" value={ props.Filters.Region }/>
			}
			<input type="hidden" name="sort" value={ props.SortColumn }/>
			<input type="hidden" name="dir" value={ props.SortDir }/>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
					<span>Search</span>
					<input type="search" name="search" value={ props.Filters.Search } placeholder="ID, job, task group, or client" class="mt-1 block w-full rounded-md border-neutral-300 text-sm shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100"/>
				</label>
				@allocationFilterSelect("status", "Client status", "All client states", props.Filters.Status, props.FilterOptions.Statuses)
				@allocationFilterSelect("scheduling", "Scheduling", "All scheduling states", props.Filters.DesiredStatus, props.FilterOptions.DesiredStatuses)
				@allocationFilterSelect("type", "Job type", "All job types", props.Filters.JobType, props.FilterOptions.JobTypes)
				@allocationFilterSelect("job", "Job", "All jobs", props.Filters.Job, props.FilterOptions.Jobs)
				@allocationFilterSelect("task_group", "Task group", "All task groups", props.Filters.TaskGroup, props.FilterOptions.TaskGroups)
				@allocationFilterSelect("node", "Client", "All clients", props.Filters.Node, props.FilterOptions.Nodes)
				@allocationPageSizeSelect(props.Pagination.PerPage)
			</div>
			<div class="mt-4 flex justify-end gap-3">
				if hasActiveAllocationFilters(props.Filters) {
					<a href={ templ.SafeURL(allocationPageSizeURL(props.Pagination.PerPage, props.Filters.Namespace, props.Filters.Region)) } hx-get={ allocationPageSizeURL(props.Pagination.PerPage, props.Filters.Namespace, props.Filters.Region) } hx-target="#main-content" hx-push-url="true" class="px-3 py-2 text-sm font-medium text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">Clear filters</a>
				}
				<button type="submit" class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">Apply filters</button>
			</div>
		</form>
		<!-- Allocations Table Container -->
		<div id="allocations-table-container" class="bg-white dark:bg-neutral-900 shadow rounded-lg overflow-hidden">
			@AllocationsTable(props)
		</div>
	</div>
}

// AllocationsTable renders just the table and pagination (for HTMX updates).
templ AllocationsTable(props ListProps) {
	@components.Table(components.TableProps{
		Columns: []components.Column{
			{Key: "id", Label: "Short ID", Sortable: true, Align: "left", Width: "w-32"},
			{Key: "job", Label: "Job", Sortable: true, Align: "left"},
			{Key: "type", Label: "Type", Sortable: true, Align: "left"},
			{Key: "taskgroup", Label: "Task Group", Sortable: true, Align: "left"},
			{Key: "version", Label: "Job Version", Sortable: true, Align: "center"},
			{Key: "node", Label: "Client", Sortable: true, Align: "left"},
			{Key: "status", Label: "Status", Sortable: true, Align: "center", Width: "w-28"},
			{Key: "scheduling", Label: "Scheduling", Sortable: true, Align: "left"},
			{Key: "created", Label: "Created", Sortable: true, Align: "right"},
			{Key: "logs", Label: "Logs", Align: "right"},
		},
		SortColumn: props.SortColumn,
		SortDir:    props.SortDir,
		Striped:    true,
		Compact:    true,
		Hover:      true,
		SortURL:    buildAllocationsBaseURL(props.Filters, props.Pagination.PerPage),
		HxTarget:   "#main-content",
		Class:      "min-w-[88rem]",
	}) {
		@components.TableBody() {
			if len(props.Allocations) == 0 {
				@components.TableEmptyState("No allocations found", "Try adjusting your filters or search query")
			} else {
				for _, allocation := range props.Allocations {
					@allocationRow(allocation)
				}
			}
		}
	}
	<!-- Pagination -->
	@components.Pagination(components.PaginationProps{
		Page:     props.Pagination.Page,
		PerPage:  props.Pagination.PerPage,
		Total:    props.Pagination.Total,
		BaseURL:  buildAllocationsURL(props.Filters, props.SortColumn, props.SortDir, 0),
		HxTarget: "#allocations-table-container",
		HxSwap:   "innerHTML",
	})
}

// allocationRow renders a single allocation row in the table
templ allocationRow(allocation AllocationSummary) {
	<tr
		data-alloc-id={ allocation.ID }
		class="transition-colors duration-100 hover:bg-neutral-50 dark:hover:bg-neutral-800 cursor-pointer"
		hx-get={ allocation.DetailURL }
		hx-target="#main-content"
		hx-swap="innerHTML"
		hx-push-url="true"
	>
		@components.TableCell("left", "w-32") {
			<a
				href={ templ.SafeURL(allocation.DetailURL) }
				class="font-mono text-sm text-primary-600 dark:text-primary-400 hover:underline"
				@click.stop
				hx-get={ allocation.DetailURL }
				hx-target="#main-content"
				hx-swap="innerHTML"
				hx-push-url="true"
			>
				if allocation.IDPrefixMatch && allocation.MatchedPrefix != "" {
					@highlightedShortID(allocation.ID, allocation.MatchedPrefix)
				} else {
					{ shortID(allocation.ID) }
				}
			</a>
		}
		@components.TableCell("left", "w-1/5") {
			<a
				href={ templ.SafeURL(allocation.JobURL) }
				class="font-medium text-neutral-900 dark:text-neutral-100 hover:text-primary-600 dark:hover:text-primary-400"
				@click.stop
				hx-get={ allocation.JobURL }
				hx-target="#main-content"
				hx-swap="innerHTML"
				hx-push-url="true"
			>
				{ allocation.JobID }
			</a>
		}
		@textAllocationCell(valueOrDash(allocation.JobType))
		@components.TableCell("left", "w-1/6") {
			<span class="text-neutral-700 dark:text-neutral-300">
				{ allocation.TaskGroup }
			</span>
		}
		@components.TableCell("center", "") {
			{ fmt.Sprintf("%d", allocation.JobVersion) }
		}
		@components.TableCell("left", "w-1/5") {
			<a href={ templ.SafeURL(allocation.ClientURL) } hx-get={ allocation.ClientURL } hx-target="#main-content" hx-push-url="true" @click.stop class="text-neutral-900 hover:text-primary-600 dark:text-neutral-100 dark:hover:text-primary-400">{ valueOrDash(allocation.NodeName) }</a>
			<div class="text-xs font-mono text-neutral-500 dark:text-neutral-400">
				{ shortID(allocation.NodeID) }
			</div>
		}
		@components.TableCell("center", "w-28") {
			@components.Badge(components.BadgeProps{
				Variant: statusVariant(allocation.Status),
				Dot:     true,
				Size:    "sm",
			}) {
				{ allocation.Status }
			}
		}
		@components.TableCell("left", "") {
			<div class="font-medium text-neutral-800 dark:text-neutral-200">{ capitalizeFirst(valueOrDash(allocation.DesiredStatus)) }</div>
			if allocation.DesiredDescription != "" {
				<div class="max-w-48 truncate text-xs text-neutral-500 dark:text-neutral-400" title={ allocation.DesiredDescription }>{ allocation.DesiredDescription }</div>
			}
		}
		@components.TableCell("right", "") {
			<span class="text-neutral-600 dark:text-neutral-400">
				{ formatTimeAgo(allocation.Created) }
			</span>
		}
		@components.TableCell("right", "") {
			<a href={ templ.SafeURL(allocation.LogsURL) } hx-get={ allocation.LogsURL } hx-target="#main-content" hx-push-url="true" @click.stop class="text-sm font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400">View Logs</a>
		}
	</tr>
}

templ textAllocationCell(value string) {
	@components.TableCell("left", "") {
		<span class="text-neutral-700 dark:text-neutral-300">{ value }</span>
	}
}

templ allocationFilterSelect(name, label, placeholder, selected string, options []string) {
	<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
		<span>{ label }</span>
		<select name={ name } class="mt-1 block w-full rounded-md border-neutral-300 text-sm shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100">
			<option value="">{ placeholder }</option>
			for _, option := range options {
				<option value={ option } selected?={ selected == option }>{ capitalizeFirst(option) }</option>
			}
		</select>
	</label>
}

templ allocationPageSizeSelect(selected int) {
	<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
		<span>Rows per page</span>
		<select name="per_page" class="mt-1 block w-full rounded-md border-neutral-300 text-sm shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100">
			for _, option := range []int{10, 25, 50, 100} {
				<option value={ fmt.Sprintf("%d", option) } selected?={ selected == option }>{ fmt.Sprintf("%d", option) }</option>
			}
		</select>
	</label>
}

// buildAllocationsBaseURL constructs the base URL for table sorting
func buildAllocationsBaseURL(filters ListFilters, perPage int) string {
	return buildAllocationsURL(filters, "", "", perPage)
}

// buildAllocationsURL constructs the full URL with all filters and sort params
func buildAllocationsURL(filters ListFilters, sortColumn, sortDir string, perPage int) string {
	params := url.Values{}
	if filters.Namespace != "" {
		params.Set("namespace", filters.Namespace)
	}
	if filters.Region != "" {
		params.Set("region", filters.Region)
	}
	if filters.Status != "" {
		params.Set("status", filters.Status)
	}
	if filters.Job != "" {
		params.Set("job", filters.Job)
	}
	if filters.JobType != "" {
		params.Set("type", filters.JobType)
	}
	if filters.TaskGroup != "" {
		params.Set("task_group", filters.TaskGroup)
	}
	if filters.Node != "" {
		params.Set("node", filters.Node)
	}
	if filters.DesiredStatus != "" {
		params.Set("scheduling", filters.DesiredStatus)
	}
	if filters.Search != "" {
		params.Set("search", filters.Search)
	}
	if sortColumn != "" {
		params.Set("sort", sortColumn)
	}
	if sortDir != "" {
		params.Set("dir", sortDir)
	}
	if perPage > 0 {
		params.Set("per_page", fmt.Sprintf("%d", perPage))
	}
	if encoded := params.Encode(); encoded != "" {
		return "/ui/allocations?" + encoded
	}
	return "/ui/allocations"
}

func allocationPageSizeURL(perPage int, namespace, region string) string {
	return buildAllocationsURL(ListFilters{Namespace: namespace, Region: region}, "", "", perPage)
}

func hasActiveAllocationFilters(filters ListFilters) bool {
	return filters.Status != "" || filters.Job != "" || filters.JobType != "" || filters.TaskGroup != "" || filters.Node != "" || filters.DesiredStatus != "" || filters.Search != ""
}

func valueOrDash(value string) string {
	if value == "" {
		return "—"
	}
	return value
}

// capitalizeFirst capitalizes the first letter of a string
func capitalizeFirst(s string) string {
	if len(s) == 0 {
		return s
	}
	if s[0] >= 'a' && s[0] <= 'z' {
		return string(s[0]-32) + s[1:]
	}
	return s
}

// statusVariant maps allocation status to badge variant
func statusVariant(status string) string {
	switch status {
	case "running":
		return "success"
	case "pending":
		return "warning"
	case "complete":
		return "info"
	case "failed":
		return "error"
	case "lost":
		return "error"
	default:
		return "neutral"
	}
}

// shortID truncates a UUID to show only the first 8 characters
func shortID(id string) string {
	if len(id) > 8 {
		return id[:8]
	}
	return id
}

// highlightedShortID renders a short ID with the matched prefix highlighted
templ highlightedShortID(id string, matchedPrefix string) {
	{{
		short := shortID(id)
		prefixLen := len(matchedPrefix)
		if prefixLen > len(short) {
			prefixLen = len(short)
		}
		matchedPart := short[:prefixLen]
		remainingPart := short[prefixLen:]
	}}
	<span class="bg-warning-100 dark:bg-warning-900/50 text-warning-800 dark:text-warning-200 rounded px-0.5">{ matchedPart }</span>{ remainingPart }
}

// formatTimeAgo formats a time.Time as a relative time string
func formatTimeAgo(t time.Time) string {
	duration := time.Since(t)

	if duration < time.Minute {
		return "just now"
	} else if duration < time.Hour {
		minutes := int(duration.Minutes())
		if minutes == 1 {
			return "1 minute ago"
		}
		return fmt.Sprintf("%d minutes ago", minutes)
	} else if duration < 24*time.Hour {
		hours := int(duration.Hours())
		if hours == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", hours)
	} else {
		days := int(duration.Hours() / 24)
		if days == 1 {
			return "1 day ago"
		}
		return fmt.Sprintf("%d days ago", days)
	}
}
