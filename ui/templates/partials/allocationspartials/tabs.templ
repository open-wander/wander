package allocationspartials

import (
	"fmt"
	"net/url"
	"time"

	"github.com/open-wander/wander/ui/templates/components"
)

// LiveResourcePanel renders the independently refreshed aggregate and task
// samples. Keeping polling inside this panel preserves the active tab, focus,
// and scroll position on the surrounding allocation page.
templ LiveResourcePanel(alloc AllocationDetail) {
	<section
		id="allocation-live-stats"
		data-testid="allocation-live-stats"
		class="mb-8"
		aria-live="polite"
		if alloc.Status == "running" && alloc.StatsURL != "" {
			hx-get={ templ.SafeURL(alloc.StatsURL) }
			hx-trigger="every 3s"
			hx-swap="outerHTML"
		}
	>
		<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
			<h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">Live Resource Statistics</h3>
			if alloc.Status == "running" {
				<span class="inline-flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
					<span class="h-2 w-2 rounded-full bg-success-500"></span>
					Updates every 3 seconds
				</span>
			}
		</div>
		if !alloc.StatsReady {
			<div class="rounded-lg bg-warning-50 p-4 text-sm text-warning-800">
				<p class="font-medium">Statistics unavailable</p>
				<p class="mt-1">{ alloc.StatsError }</p>
			</div>
		} else if alloc.Stats == nil {
			<p class="rounded-lg border border-neutral-200 dark:border-neutral-700 p-4 text-sm text-neutral-500 dark:text-neutral-400">No live resource sample is available.</p>
		} else {
			<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
				<div class="rounded-lg bg-neutral-50 dark:bg-neutral-900 p-4">
					<div class="mb-1 text-sm text-neutral-600 dark:text-neutral-400">CPU</div>
					<div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">{ fmt.Sprintf("%.1f%%", alloc.Stats.CPUPercent) }</div>
				</div>
				<div class="rounded-lg bg-neutral-50 dark:bg-neutral-900 p-4">
					<div class="mb-1 text-sm text-neutral-600 dark:text-neutral-400">Memory usage</div>
					<div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">{ formatAllocationBytes(alloc.Stats.MemoryUsage) }</div>
					<div class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">RSS { formatAllocationBytes(alloc.Stats.MemoryRSS) }</div>
				</div>
				<div
					class="rounded-lg bg-neutral-50 dark:bg-neutral-900 p-4"
					if !alloc.Stats.Timestamp.IsZero() {
						data-live-stats-sampled-at={ fmt.Sprintf("%d", alloc.Stats.Timestamp.UnixNano()) }
					}
				>
					<div class="mb-1 text-sm text-neutral-600 dark:text-neutral-400">Sampled</div>
					<div class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
						if !alloc.Stats.Timestamp.IsZero() {
							{ alloc.Stats.Timestamp.Format("Jan 2, 15:04:05") }
						} else {
							Unknown
						}
					</div>
				</div>
			</div>
			if hasTaskLiveStats(alloc.Tasks) {
				<div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2" aria-label="Live task resource usage">
					for _, task := range alloc.Tasks {
						if task.Resources.LiveStats != nil {
							<div data-live-resource-task={ task.Name } class="rounded-lg border border-neutral-200 dark:border-neutral-700 p-4">
								<h4 class="mb-3 text-sm font-semibold text-neutral-900 dark:text-neutral-100">{ task.Name } <span class="font-normal text-neutral-500 dark:text-neutral-400">Live Resource Usage</span></h4>
								<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
									<div>
										<div class="mb-1 flex items-center justify-between text-xs">
											<span class="text-neutral-600 dark:text-neutral-400">CPU</span>
											<span class="font-medium text-neutral-900 dark:text-neutral-100">{ fmt.Sprintf("%.1f%%", task.Resources.LiveStats.CPUPercent) } <span class="text-neutral-500 dark:text-neutral-400">({ fmt.Sprintf("%d MHz reserved", task.Resources.CPU) })</span></span>
										</div>
										<div class="h-2 w-full rounded-full bg-neutral-200"><div class={ resourceBarClasses(task.Resources.LiveStats.CPUPercent) } style={ fmt.Sprintf("width: %.1f%%", resourceBarWidth(task.Resources.LiveStats.CPUPercent)) }></div></div>
									</div>
									<div>
										<div class="mb-1 flex items-center justify-between text-xs">
											<span class="text-neutral-600 dark:text-neutral-400">Memory</span>
											<span class="font-medium text-neutral-900 dark:text-neutral-100">{ formatAllocationBytes(task.Resources.LiveStats.MemoryUsage) } <span class="text-neutral-500 dark:text-neutral-400">of { fmt.Sprintf("%d MB", task.Resources.Memory) }</span></span>
										</div>
										<div class="h-2 w-full rounded-full bg-neutral-200"><div class={ resourceBarClasses(memoryUsagePercent(task.Resources.LiveStats.MemoryUsage, task.Resources.Memory)) } style={ fmt.Sprintf("width: %.1f%%", resourceBarWidth(memoryUsagePercent(task.Resources.LiveStats.MemoryUsage, task.Resources.Memory))) }></div></div>
									</div>
								</div>
								if !task.Resources.LiveStats.Timestamp.IsZero() {
									<p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">Sampled { task.Resources.LiveStats.Timestamp.Format("Jan 2, 15:04:05") }</p>
								}
							</div>
						}
					}
				</div>
			}
		}
	</section>
}

func hasTaskLiveStats(tasks []TaskStatus) bool {
	for _, task := range tasks {
		if task.Resources.LiveStats != nil {
			return true
		}
	}
	return false
}

// TasksTab renders the tasks tab content with detailed task information
// including status, resource usage, events timeline, and links to logs
templ TasksTab(alloc AllocationDetail) {
	<div class="p-6">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
			<section data-testid="allocation-ports">
				<h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100 mb-3">Network Ports</h3>
				<div class="border border-neutral-200 dark:border-neutral-700 rounded-lg overflow-hidden">
					if len(alloc.Ports) == 0 {
						<p class="p-4 text-sm text-neutral-500 dark:text-neutral-400">No allocated ports.</p>
					} else {
						<div class="overflow-x-auto">
							<table class="min-w-full divide-y divide-neutral-200 dark:divide-neutral-700 text-sm">
								<thead class="bg-neutral-50 dark:bg-neutral-900 text-left text-xs uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
									<tr>
										<th class="px-4 py-3 font-medium">Label</th>
										<th class="px-4 py-3 font-medium">Host address</th>
										<th class="px-4 py-3 font-medium">To</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-neutral-200 dark:divide-neutral-700 bg-white dark:bg-neutral-800">
									for _, port := range alloc.Ports {
										<tr>
											<td class="px-4 py-3 font-medium text-neutral-900 dark:text-neutral-100">{ port.Label }</td>
											<td class="px-4 py-3 font-mono text-neutral-700 dark:text-neutral-300">
												if port.HostIP != "" {
													{ fmt.Sprintf("%s:%d", port.HostIP, port.HostPort) }
												} else {
													{ fmt.Sprintf("port %d", port.HostPort) }
												}
											</td>
											<td class="px-4 py-3 font-mono text-neutral-700 dark:text-neutral-300">
												if port.To > 0 {
													{ fmt.Sprintf("%d", port.To) }
												} else {
													<span class="text-neutral-400">—</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</section>
			<section data-testid="allocation-services">
				<h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100 mb-3">Live Services</h3>
				<div class="border border-neutral-200 dark:border-neutral-700 rounded-lg overflow-hidden">
					if !alloc.ServicesReady {
						<div class="p-4 bg-warning-50 text-sm text-warning-800">
							<p class="font-medium">Services unavailable</p>
							<p class="mt-1">{ alloc.ServicesError }</p>
						</div>
					} else if len(alloc.Services) == 0 {
						<p class="p-4 text-sm text-neutral-500 dark:text-neutral-400">No live service registrations.</p>
					} else {
						<ul class="divide-y divide-neutral-200 dark:divide-neutral-700 bg-white dark:bg-neutral-800">
							for _, service := range alloc.Services {
								<li class="p-4">
									<div class="flex items-start justify-between gap-4">
										<div>
											<a href={ templ.URL(service.DetailURL) } class="font-medium text-primary-600 hover:underline">{ service.Name }</a>
											if service.Tags != "" {
												<p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">{ service.Tags }</p>
											}
										</div>
										<span class="font-mono text-sm text-neutral-700 dark:text-neutral-300">
											if service.Address != "" {
												{ fmt.Sprintf("%s:%d", service.Address, service.Port) }
											} else {
												{ fmt.Sprintf("port %d", service.Port) }
											}
										</span>
									</div>
								</li>
							}
						</ul>
					}
				</div>
			</section>
		</div>
		@LiveResourcePanel(alloc)
		<div class="flex items-center justify-between mb-6">
			<h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">Tasks ({ fmt.Sprintf("%d", len(alloc.Tasks)) })</h3>
		</div>
		<!-- Task Cards -->
		<div class="space-y-4">
			for _, task := range alloc.Tasks {
				@components.Card(components.CardProps{
					Border: true,
					Shadow: false,
					Class:  "overflow-hidden",
				}) {
					@components.CardBody() {
						<!-- Task Header -->
						<div class="flex items-center justify-between mb-4">
							<div class="flex items-center space-x-3">
								<!-- Task Icon -->
								<div class={ taskIconClasses(task.State) }>
									@taskStateIcon(task.State)
								</div>
								<div>
									<h4 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">{ task.Name }</h4>
									<div class="flex items-center space-x-2 mt-1">
										@components.Badge(components.BadgeProps{
											Variant: taskStateToBadgeVariant(task.State),
											Dot:     true,
											Size:    "sm",
										}) {
											{ task.State }
										}
										if task.Restarts > 0 {
											@components.Badge(components.BadgeProps{
												Variant: "warning",
												Size:    "sm",
											}) {
												{ fmt.Sprintf("%d restart", task.Restarts) }
												if task.Restarts > 1 {
													s
												}
											}
										}
										if task.LifecycleHook != "" {
											<span data-task-lifecycle={ task.Name }>
												@components.Badge(components.BadgeProps{
													Variant: "info",
													Size:    "sm",
												}) {
													{ task.LifecycleHook }
													if task.LifecycleSidecar {
														sidecar
													}
												}
											</span>
										}
									</div>
								</div>
							</div>
							<!-- Actions -->
							<div class="flex items-center space-x-2">
								if task.State == "running" {
									<button
										type="button"
										hx-post={ templ.SafeURL("/ui/allocations/" + alloc.ID + "/restart?task=" + url.QueryEscape(task.Name)) }
										hx-swap="none"
										hx-confirm={ "Restart task " + task.Name + " in place?" }
										data-task-restart={ task.Name }
										class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-warning-700 bg-warning-50 rounded-md hover:bg-warning-100 focus:outline-none focus:ring-2 focus:ring-warning-500 focus:ring-offset-2 transition-colors"
									>Restart</button>
								}
								<a
									href={ templ.URL("/ui/allocations/" + alloc.ID + "/logs?task=" + task.Name) }
									class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-primary-600 bg-primary-50 rounded-md hover:bg-primary-100 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-colors"
								>
									<svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
									</svg>
									Logs
								</a>
							</div>
						</div>
						<!-- Task Timing Info -->
						<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4 p-3 bg-neutral-50 dark:bg-neutral-900 rounded-lg">
							<div>
								<div class="text-xs text-neutral-500 dark:text-neutral-400 uppercase tracking-wide">Started</div>
								<div class="text-sm font-medium text-neutral-900 dark:text-neutral-100 mt-1">
									if !task.StartedAt.IsZero() {
										{ task.StartedAt.Format("Jan 2, 15:04:05") }
									} else {
										<span class="text-neutral-400">--</span>
									}
								</div>
							</div>
							<div>
								<div class="text-xs text-neutral-500 dark:text-neutral-400 uppercase tracking-wide">Finished</div>
								<div class="text-sm font-medium text-neutral-900 dark:text-neutral-100 mt-1">
									if !task.FinishedAt.IsZero() {
										{ task.FinishedAt.Format("Jan 2, 15:04:05") }
									} else {
										if task.State == "running" {
											<span class="text-success-600">Running</span>
										} else {
											<span class="text-neutral-400">--</span>
										}
									}
								</div>
							</div>
							<div>
								<div class="text-xs text-neutral-500 dark:text-neutral-400 uppercase tracking-wide">Restarts</div>
								<div class="text-sm font-medium text-neutral-900 dark:text-neutral-100 mt-1">
									{ fmt.Sprintf("%d", task.Restarts) }
								</div>
							</div>
							<div>
								<div class="text-xs text-neutral-500 dark:text-neutral-400 uppercase tracking-wide">Duration</div>
								<div class="text-sm font-medium text-neutral-900 dark:text-neutral-100 mt-1">
									if !task.StartedAt.IsZero() {
										{ formatDuration(task.StartedAt, task.FinishedAt) }
									} else {
										<span class="text-neutral-400">--</span>
									}
								</div>
							</div>
						</div>
						<!-- Task Resources -->
						if task.Resources.CPU > 0 || task.Resources.Memory > 0 {
							<div class="mb-4">
								<h5 class="text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2">Reserved Resources</h5>
								<div class="grid grid-cols-2 gap-4 text-sm">
									<div class="bg-neutral-50 dark:bg-neutral-900 rounded p-3"><span class="text-neutral-600 dark:text-neutral-400">CPU</span><span class="float-right font-medium">{ fmt.Sprintf("%d MHz", task.Resources.CPU) }</span></div>
									<div class="bg-neutral-50 dark:bg-neutral-900 rounded p-3"><span class="text-neutral-600 dark:text-neutral-400">Memory</span><span class="float-right font-medium">{ fmt.Sprintf("%d MB", task.Resources.Memory) }</span></div>
								</div>
							</div>
						}
						<!-- Events Timeline -->
						if len(task.Events) > 0 {
							<div>
								<h5 class="text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2">Recent Events</h5>
								<div class="relative">
									<!-- Timeline line -->
									<div class="absolute left-2 top-2 bottom-2 w-0.5 bg-neutral-200"></div>
									<div class="space-y-3">
										for i, event := range task.Events {
											<div class="relative flex items-start pl-6">
												<!-- Timeline dot -->
												<div class={ timelineDotClasses(event.FailsTask, i == 0) }></div>
												<div class="flex-1 min-w-0">
													<div class="flex items-center justify-between">
														<span class={ eventTypeClasses(event.FailsTask) }>{ event.Type }</span>
														<span class="text-xs text-neutral-500 dark:text-neutral-400">{ event.Time.Format("Jan 2, 15:04:05") }</span>
													</div>
													if event.DisplayMsg != "" {
														<p class="text-sm text-neutral-600 dark:text-neutral-400 mt-0.5">{ event.DisplayMsg }</p>
													}
												</div>
											</div>
										}
									</div>
								</div>
							</div>
						}
					}
				}
			}
		</div>
		if len(alloc.Tasks) == 0 {
			<div class="text-center py-12 bg-neutral-50 dark:bg-neutral-900 rounded-lg">
				<svg class="mx-auto h-12 w-12 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
				</svg>
				<h3 class="mt-2 text-sm font-medium text-neutral-900 dark:text-neutral-100">No tasks</h3>
				<p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">This allocation has no tasks defined.</p>
			</div>
		}
		<!-- Allocation Resources Summary -->
		<div class="mt-6 border-t border-neutral-200 dark:border-neutral-700 pt-6">
			<h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100 mb-4">Allocation Resources</h3>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				<div class="bg-neutral-50 dark:bg-neutral-900 rounded-lg p-4">
					<div class="text-sm text-neutral-600 dark:text-neutral-400 mb-1">Total CPU</div>
					<div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">{ fmt.Sprintf("%d", alloc.Resources.CPU) } <span class="text-sm font-normal text-neutral-600 dark:text-neutral-400">MHz</span></div>
				</div>
				<div class="bg-neutral-50 dark:bg-neutral-900 rounded-lg p-4">
					<div class="text-sm text-neutral-600 dark:text-neutral-400 mb-1">Total Memory</div>
					<div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">{ fmt.Sprintf("%d", alloc.Resources.Memory) } <span class="text-sm font-normal text-neutral-600 dark:text-neutral-400">MB</span></div>
				</div>
				<div class="bg-neutral-50 dark:bg-neutral-900 rounded-lg p-4">
					<div class="text-sm text-neutral-600 dark:text-neutral-400 mb-1">Total Disk</div>
					<div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">{ fmt.Sprintf("%d", alloc.Resources.Disk) } <span class="text-sm font-normal text-neutral-600 dark:text-neutral-400">MB</span></div>
				</div>
			</div>
		</div>
		<section data-testid="allocation-history" class="mt-6 border-t border-neutral-200 dark:border-neutral-700 pt-6">
			<h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100 mb-4">Allocation History</h3>
			if allocationHistoryEmpty(alloc.History) {
				<p class="text-sm text-neutral-500 dark:text-neutral-400">No reschedule or preemption history.</p>
			}
			if !allocationHistoryEmpty(alloc.History) {
				<div class="space-y-5 text-sm">
					if alloc.History.Previous.ID != "" || alloc.History.Next.ID != "" {
						<div class="flex flex-wrap gap-x-8 gap-y-2">
							if alloc.History.Previous.ID != "" {
								<div><span class="text-neutral-600 dark:text-neutral-400">Previous:</span> <a href={ templ.URL(alloc.History.Previous.URL) } class="font-mono text-primary-600 hover:underline">{ shortID(alloc.History.Previous.ID) }</a></div>
							}
							if alloc.History.Next.ID != "" {
								<div><span class="text-neutral-600 dark:text-neutral-400">Next:</span> <a href={ templ.URL(alloc.History.Next.URL) } class="font-mono text-primary-600 hover:underline">{ shortID(alloc.History.Next.ID) }</a></div>
							}
						</div>
					}
					if len(alloc.History.Reschedules) > 0 {
						<div>
							<h4 class="font-medium text-neutral-900 dark:text-neutral-100 mb-2">Reschedule attempts</h4>
							<ul class="divide-y divide-neutral-200 dark:divide-neutral-700 border border-neutral-200 dark:border-neutral-700 rounded-lg">
								for _, event := range alloc.History.Reschedules {
									<li class="p-3 flex flex-wrap items-center justify-between gap-2">
										<div>
											Previous allocation <a href={ templ.URL(event.PreviousAllocation.URL) } class="font-mono text-primary-600 hover:underline">{ shortID(event.PreviousAllocation.ID) }</a>
											if event.PreviousNode.ID != "" {
												on client <a href={ templ.URL(event.PreviousNode.URL) } class="font-mono text-primary-600 hover:underline">{ shortID(event.PreviousNode.ID) }</a>
											}
										</div>
										if !event.Time.IsZero() {
											<time class="text-neutral-500 dark:text-neutral-400">{ event.Time.Format("Jan 2, 15:04:05") }</time>
										}
									</li>
								}
							</ul>
						</div>
					}
					if alloc.History.PreemptedBy.ID != "" {
						<div><span class="text-neutral-600 dark:text-neutral-400">Preempted by:</span> <a href={ templ.URL(alloc.History.PreemptedBy.URL) } class="font-mono text-primary-600 hover:underline">{ shortID(alloc.History.PreemptedBy.ID) }</a></div>
					}
					if len(alloc.History.PreemptedAllocations) > 0 {
						<div>
							<span class="text-neutral-600 dark:text-neutral-400">Preempted allocations:</span>
							for index, related := range alloc.History.PreemptedAllocations {
								if index > 0 {
									<span>, </span>
								}
								<a href={ templ.URL(related.URL) } class="font-mono text-primary-600 hover:underline">{ shortID(related.ID) }</a>
							}
						</div>
					}
				</div>
			}
		</section>
		<!-- Allocation Events -->
		if len(alloc.Events) > 0 {
			<div class="mt-6 border-t border-neutral-200 dark:border-neutral-700 pt-6">
				<h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100 mb-4">Allocation Events</h3>
				<div class="space-y-2">
					for _, event := range alloc.Events {
						<div class="flex items-start space-x-4 text-sm border-l-2 border-primary-500 pl-4 py-2">
							<div class="flex-shrink-0 w-32 text-neutral-500 dark:text-neutral-400">
								{ event.Time.Format("Jan 2, 15:04:05") }
							</div>
							<div class="flex-1">
								<span class="font-medium text-neutral-900 dark:text-neutral-100">{ event.Type }:</span>
								<span class="text-neutral-600 dark:text-neutral-400 ml-1">{ event.Message }</span>
							</div>
						</div>
					}
				</div>
			</div>
		}
	</div>
}

// FilesTab renders the files tab - delegates to FilesTabFull from files.templ
// This is a compatibility wrapper that creates default props
templ FilesTab(allocID string, tasks []string, selectedTask string, files []FileEntry) {
	@FilesTabFull(FilesTabProps{
		AllocID:      allocID,
		Tasks:        tasks,
		SelectedTask: selectedTask,
		Files:        files,
	})
}

// RawTab renders allocation data returned by the API.
templ RawTab(raw string) {
	<div class="p-6">
		<h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100 mb-4">Raw Allocation Data</h3>
		<div class="bg-neutral-900 text-neutral-100 rounded-lg p-4 font-mono text-sm overflow-x-auto">
			<pre>{ raw }</pre>
		</div>
	</div>
}

// taskStateToBadgeVariant maps task state to badge variant
func taskStateToBadgeVariant(state string) string {
	switch state {
	case "running":
		return "success"
	case "pending":
		return "warning"
	case "dead":
		return "neutral"
	case "failed":
		return "error"
	default:
		return "info"
	}
}

// taskIconClasses returns CSS classes for task state icon container
func taskIconClasses(state string) string {
	base := "flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center "
	switch state {
	case "running":
		return base + "bg-success-100 text-success-600"
	case "pending":
		return base + "bg-warning-100 text-warning-600"
	case "dead":
		return base + "bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400"
	case "failed":
		return base + "bg-error-100 text-error-600"
	default:
		return base + "bg-info-100 text-info-600"
	}
}

// taskStateIcon renders an icon based on task state
templ taskStateIcon(state string) {
	switch state {
		case "running":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
		case "pending":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
		case "dead":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 110 2h-4a1 1 0 01-1-1z"></path>
			</svg>
		case "failed":
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
		default:
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
	}
}

// resourceBarClasses returns CSS classes for resource usage bar based on usage percentage
func resourceBarClasses(usage float64) string {
	base := "h-2 rounded-full transition-all duration-300 "
	if usage >= 90 {
		return base + "bg-error-500"
	} else if usage >= 70 {
		return base + "bg-warning-500"
	}
	return base + "bg-success-500"
}

func resourceBarWidth(usage float64) float64 {
	if usage < 0 {
		return 0
	}
	if usage > 100 {
		return 100
	}
	return usage
}

func memoryUsagePercent(usage uint64, reservedMB int) float64 {
	if reservedMB <= 0 {
		return 0
	}
	return float64(usage) * 100 / (float64(reservedMB) * 1024 * 1024)
}

func formatAllocationBytes(bytes uint64) string {
	const unit = 1024
	if bytes < unit {
		return fmt.Sprintf("%d B", bytes)
	}
	div, exp := uint64(unit), 0
	for value := bytes / unit; value >= unit; value /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %ciB", float64(bytes)/float64(div), "KMGTPE"[exp])
}

func allocationHistoryEmpty(history AllocationHistory) bool {
	return history.Previous.ID == "" && history.Next.ID == "" && len(history.Reschedules) == 0 && len(history.PreemptedAllocations) == 0 && history.PreemptedBy.ID == ""
}

// timelineDotClasses returns CSS classes for timeline event dots
func timelineDotClasses(failsTask bool, isFirst bool) string {
	base := "absolute left-0 w-4 h-4 rounded-full border-2 border-white "
	if failsTask {
		return base + "bg-error-500"
	}
	if isFirst {
		return base + "bg-primary-500"
	}
	return base + "bg-neutral-300"
}

// eventTypeClasses returns CSS classes for event type text
func eventTypeClasses(failsTask bool) string {
	if failsTask {
		return "text-sm font-medium text-error-600"
	}
	return "text-sm font-medium text-neutral-900 dark:text-neutral-100"
}

// formatDuration formats the duration between start and finish times
func formatDuration(start, finish time.Time) string {
	var end time.Time
	if finish.IsZero() {
		end = time.Now()
	} else {
		end = finish
	}

	duration := end.Sub(start)

	if duration < time.Minute {
		return fmt.Sprintf("%ds", int(duration.Seconds()))
	} else if duration < time.Hour {
		minutes := int(duration.Minutes())
		seconds := int(duration.Seconds()) % 60
		return fmt.Sprintf("%dm %ds", minutes, seconds)
	} else if duration < 24*time.Hour {
		hours := int(duration.Hours())
		minutes := int(duration.Minutes()) % 60
		return fmt.Sprintf("%dh %dm", hours, minutes)
	}

	days := int(duration.Hours() / 24)
	hours := int(duration.Hours()) % 24
	return fmt.Sprintf("%dd %dh", days, hours)
}
