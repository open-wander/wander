package jobspartials

import (
	"fmt"

	"github.com/open-wander/wander/api"
	"github.com/open-wander/wander/ui/templates/components"
	"github.com/open-wander/wander/ui/templates/partials/servicespartials"
)

// JobClient is a client observed in a job's allocation history. It does not
// imply that the scheduler currently considers the client eligible.
type JobClient struct {
	ID                string
	Name              string
	Allocations       int
	ActiveAllocations int
	LatestStatus      string
	LatestModified    uint64
}

templ ServicesTab(registrations []*api.ServiceRegistration) {
	<div class="p-6">
		<div class="mb-4">
			<h3 class="text-lg font-medium text-neutral-900">Services</h3>
			<p class="mt-1 text-sm text-neutral-500">Nomad-native service registrations created by this job</p>
		</div>
		<div class="border border-neutral-200 rounded-lg overflow-hidden">
			@servicespartials.RegistrationTable(registrations)
		</div>
	</div>
}

templ ClientsTab(clientList []JobClient) {
	<div class="p-6">
		<div class="mb-4">
			<h3 class="text-lg font-medium text-neutral-900">Clients</h3>
			<p class="mt-1 text-sm text-neutral-500">Clients observed in this job's allocation history; this is not a scheduler eligibility list</p>
		</div>
		<div class="border border-neutral-200 rounded-lg overflow-hidden">
			@components.Table(components.TableProps{
				Columns: []components.Column{
					{Key: "client", Label: "Client", Align: "left"},
					{Key: "allocations", Label: "Allocations", Align: "right", Width: "w-32"},
					{Key: "active", Label: "Active", Align: "right", Width: "w-28"},
					{Key: "status", Label: "Latest allocation", Align: "center", Width: "w-40"},
				},
				Hover: true,
			}) {
				@components.TableBody() {
					if len(clientList) == 0 {
						@components.TableEmptyState("No clients found", "This job has no allocation history")
					} else {
						for _, client := range clientList {
							<tr class="hover:bg-neutral-50">
								@components.TableCell("left", "") {
									<a href={ templ.SafeURL("/ui/clients/" + client.ID) } class="text-primary-600 hover:underline">{ jobClientName(client) }</a>
									<div class="font-mono text-xs text-neutral-500">{ client.ID }</div>
								}
								@components.TableCell("right", "w-32") { { fmt.Sprintf("%d", client.Allocations) } }
								@components.TableCell("right", "w-28") { { fmt.Sprintf("%d", client.ActiveAllocations) } }
								@components.TableCell("center", "w-40") {
									@components.Badge(components.BadgeProps{Variant: allocationStatusVariant(client.LatestStatus), Dot: true, Size: "sm"}) {
										{ client.LatestStatus }
									}
								}
							</tr>
						}
					}
				}
			}
		</div>
	</div>
}

func jobClientName(client JobClient) string {
	if client.Name != "" {
		return client.Name
	}
	return shortJobClientID(client.ID)
}

func shortJobClientID(id string) string {
	if len(id) <= 8 {
		return id
	}
	return id[:8]
}
