package jobspartials

import (
	"fmt"
	"net/url"
	"strings"
	"time"
	"github.com/open-wander/wander/ui/templates/components"
)

type AllocationSummary struct {
	Available  bool
	TaskGroups int
	Queued     int
	Complete   int
	Failed     int
	Running    int
	Starting   int
	Lost       int
	Unknown    int
}

func (summary AllocationSummary) Total() int {
	return summary.Queued + summary.Complete + summary.Failed + summary.Running + summary.Starting + summary.Lost + summary.Unknown
}

func (summary AllocationSummary) Pending() int { return summary.Queued + summary.Starting }
func (summary AllocationSummary) Unhealthy() int { return summary.Failed + summary.Lost + summary.Unknown }

// JobSummary represents the fields returned by the live jobs list API.
type JobSummary struct {
	ID          string
	Name        string
	Namespace   string
	Datacenters []string
	NodePool    string
	Status      string
	Type        string
	Priority    int
	Submitted   time.Time
	PackName    string
	PackVersion string
	Allocations AllocationSummary
}

type JobListFilters struct {
	Search     string
	Prefix     string
	Statuses   []string
	Types      []string
	Datacenter string
	NodePool   string
}

type JobFilterOptions struct {
	Statuses    []string
	Types       []string
	Datacenters []string
	NodePools   []string
}

type PaginationMeta struct {
	Page       int
	PerPage    int
	Total      int
	TotalPages int
}

type ListProps struct {
	Jobs          []JobSummary
	Filters       JobListFilters
	FilterOptions JobFilterOptions
	SortColumn    string
	SortDir       string
	Pagination    PaginationMeta
}

templ ListContent(props ListProps) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="sm:flex sm:items-center sm:justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">Jobs</h1>
				<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">View and manage Wander jobs</p>
			</div>
		</div>
		<form id="jobs-filters" class="mb-6 rounded-lg border border-neutral-200 bg-white p-4 shadow-sm dark:border-neutral-700 dark:bg-neutral-900" method="get" action="/ui/jobs" hx-get="/ui/jobs" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">
			<input type="hidden" name="sort" value={ props.SortColumn }/>
			<input type="hidden" name="dir" value={ props.SortDir }/>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
				@jobFilterInput("search", "Search", "Search by job name or ID", props.Filters.Search)
				@jobFilterInput("prefix", "ID prefix", "Job ID starts with…", props.Filters.Prefix)
				@jobFilterSelect("datacenter", "Datacenter", "All datacenters", props.Filters.Datacenter, props.FilterOptions.Datacenters)
				@jobFilterSelect("node_pool", "Node pool", "All node pools", props.Filters.NodePool, props.FilterOptions.NodePools)
				@jobPageSizeSelect(props.Pagination.PerPage)
			</div>
			<div class="mt-4 flex flex-wrap items-start gap-4">
				@multiValueFilter("status", "Status", props.Filters.Statuses, props.FilterOptions.Statuses)
				@multiValueFilter("type", "Type", props.Filters.Types, props.FilterOptions.Types)
				<div class="ml-auto flex items-center gap-3 pt-1">
					if hasActiveJobFilters(props.Filters) {
						<a href={ templ.SafeURL(jobPageSizeURL(props.Pagination.PerPage)) } hx-get={ jobPageSizeURL(props.Pagination.PerPage) } hx-target="#main-content" hx-push-url="true" class="text-sm font-medium text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">Clear filters</a>
					}
					<button type="submit" class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">Apply filters</button>
				</div>
			</div>
		</form>
		<div id="jobs-table-container" class="overflow-hidden rounded-lg bg-white shadow dark:bg-neutral-900">
			@components.Table(components.TableProps{
				Columns: []components.Column{
					{Key: "name", Label: "Name", Sortable: true, Align: "left"},
					{Key: "namespace", Label: "Namespace", Sortable: true, Align: "left"},
					{Key: "datacenter", Label: "Datacenter", Sortable: true, Align: "left"},
					{Key: "status", Label: "Status", Sortable: true, Align: "center"},
					{Key: "type", Label: "Type", Sortable: true, Align: "left"},
					{Key: "node_pool", Label: "Node Pool", Sortable: true, Align: "left"},
					{Key: "task_groups", Label: "Task Groups", Sortable: true, Align: "center"},
					{Key: "allocations", Label: "Allocations", Sortable: true, Align: "left"},
					{Key: "priority", Label: "Priority", Sortable: true, Align: "center"},
					{Key: "submitted", Label: "Submitted", Sortable: true, Align: "right"},
				},
				SortColumn: props.SortColumn,
				SortDir: props.SortDir,
				Striped: true,
				Compact: true,
				Hover: true,
				SortURL: buildJobsURL(props.Filters, "", "", props.Pagination.PerPage),
				HxTarget: "#main-content",
				Class: "min-w-[90rem]",
			}) {
				@components.TableBody() {
					if len(props.Jobs) == 0 {
						@components.TableEmptyState("No jobs found", "Try adjusting the job filters")
					} else {
						for _, job := range props.Jobs {
							@jobRow(job)
						}
					}
				}
			}
			@components.Pagination(components.PaginationProps{
				Page: props.Pagination.Page,
				PerPage: props.Pagination.PerPage,
				Total: props.Pagination.Total,
				BaseURL: buildJobsURL(props.Filters, props.SortColumn, props.SortDir, 0),
				HxTarget: "#main-content",
				HxSwap: "innerHTML",
			})
		</div>
		@components.TableLoadingIndicator()
	</div>
}

templ jobFilterInput(name, label, placeholder, value string) {
	<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
		<span>{ label }</span>
		<input type="search" name={ name } value={ value } placeholder={ placeholder } class="mt-1 block w-full rounded-md border-neutral-300 text-sm shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100"/>
	</label>
}

templ jobFilterSelect(name, label, placeholder, selected string, options []string) {
	<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
		<span>{ label }</span>
		<select name={ name } class="mt-1 block w-full rounded-md border-neutral-300 text-sm shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100">
			<option value="">{ placeholder }</option>
			for _, option := range options {
				<option value={ option } selected?={ selected == option }>{ option }</option>
			}
		</select>
	</label>
}

templ jobPageSizeSelect(selected int) {
	<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
		<span>Rows per page</span>
		<select name="per_page" class="mt-1 block w-full rounded-md border-neutral-300 text-sm shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100">
			for _, option := range []int{10, 25, 50, 100} {
				<option value={ fmt.Sprintf("%d", option) } selected?={ selected == option }>{ fmt.Sprintf("%d", option) }</option>
			}
		</select>
	</label>
}

templ multiValueFilter(name, label string, selected, options []string) {
	<fieldset class="min-w-48">
		<legend class="mb-1 text-sm font-medium text-neutral-700 dark:text-neutral-300">{ label }</legend>
		<div class="flex min-h-10 flex-wrap items-center gap-x-4 gap-y-2 rounded-md border border-neutral-300 px-3 py-2 dark:border-neutral-600">
			if len(options) == 0 {
				<span class="text-sm text-neutral-500 dark:text-neutral-400">No options</span>
			} else {
				for _, option := range options {
					<label class="inline-flex items-center gap-2 text-sm text-neutral-700 dark:text-neutral-300">
						<input type="checkbox" name={ name } value={ option } checked?={ stringSelected(selected, option) } class="rounded border-neutral-300 text-primary-600 focus:ring-primary-500"/>
						<span>{ option }</span>
					</label>
				}
			}
		</div>
	</fieldset>
}

templ jobRow(job JobSummary) {
	<tr data-job-id={ job.ID } class="cursor-pointer transition-colors duration-100 hover:bg-neutral-50 dark:hover:bg-neutral-800" hx-get={ fmt.Sprintf("/ui/jobs/%s", job.ID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">
		@components.TableCell("left", "") {
			<a href={ templ.SafeURL(fmt.Sprintf("/ui/jobs/%s", job.ID)) } class="font-medium text-neutral-900 hover:text-primary-600 dark:text-neutral-100 dark:hover:text-primary-400" @click.stop hx-get={ fmt.Sprintf("/ui/jobs/%s", job.ID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">{ job.Name }</a>
			<div class="text-xs text-neutral-500 dark:text-neutral-400">{ job.ID }</div>
			if job.PackName != "" {
				<span class="mt-1 inline-flex rounded-full bg-violet-100 px-2 py-0.5 text-xs font-medium text-violet-700 dark:bg-violet-900/40 dark:text-violet-300" title={ packTitle(job) }>Pack · { job.PackName }</span>
			}
		}
		@textCell(valueOrDash(job.Namespace))
		@textCell(valueOrDash(strings.Join(job.Datacenters, ", ")))
		@components.TableCell("center", "") { @components.Badge(components.BadgeProps{Variant: statusVariant(job.Status), Dot: true, Size: "sm"}) { { job.Status } } }
		@textCell(valueOrDash(job.Type))
		@textCell(valueOrDash(job.NodePool))
		@components.TableCell("center", "") { { taskGroupCount(job.Allocations) } }
		@components.TableCell("left", "") {
			if job.Allocations.Available {
				<div class="font-medium text-neutral-800 dark:text-neutral-200">{ fmt.Sprintf("%d running / %d total", job.Allocations.Running, job.Allocations.Total()) }</div>
				<div class="text-xs text-neutral-500 dark:text-neutral-400">{ allocationDetails(job.Allocations) }</div>
			} else {
				<span class="text-neutral-500 dark:text-neutral-400">Unavailable</span>
			}
		}
		@components.TableCell("center", "") { { fmt.Sprintf("%d", job.Priority) } }
		@components.TableCell("right", "") { <span class="text-neutral-600 dark:text-neutral-400">{ formatTimeAgo(job.Submitted) }</span> }
	</tr>
}

templ textCell(value string) {
	@components.TableCell("left", "") {
		<span class="text-neutral-700 dark:text-neutral-300">{ value }</span>
	}
}

func buildJobsURL(filters JobListFilters, sortColumn, sortDir string, perPage int) string {
	params := url.Values{}
	if filters.Search != "" { params.Set("search", filters.Search) }
	if filters.Prefix != "" { params.Set("prefix", filters.Prefix) }
	for _, status := range filters.Statuses { params.Add("status", status) }
	for _, jobType := range filters.Types { params.Add("type", jobType) }
	if filters.Datacenter != "" { params.Set("datacenter", filters.Datacenter) }
	if filters.NodePool != "" { params.Set("node_pool", filters.NodePool) }
	if sortColumn != "" { params.Set("sort", sortColumn) }
	if sortDir != "" { params.Set("dir", sortDir) }
	if perPage > 0 { params.Set("per_page", fmt.Sprintf("%d", perPage)) }
	if encoded := params.Encode(); encoded != "" { return "/ui/jobs?" + encoded }
	return "/ui/jobs"
}

func jobPageSizeURL(perPage int) string { return fmt.Sprintf("/ui/jobs?per_page=%d", perPage) }

func hasActiveJobFilters(filters JobListFilters) bool {
	return filters.Search != "" || filters.Prefix != "" || len(filters.Statuses) > 0 || len(filters.Types) > 0 || filters.Datacenter != "" || filters.NodePool != ""
}

func stringSelected(values []string, target string) bool {
	for _, value := range values { if value == target { return true } }
	return false
}

func valueOrDash(value string) string { if value == "" { return "—" }; return value }
func packTitle(job JobSummary) string { if job.PackVersion == "" { return "Nomad Pack: " + job.PackName }; return fmt.Sprintf("Nomad Pack: %s %s", job.PackName, job.PackVersion) }
func allocationDetails(summary AllocationSummary) string { return fmt.Sprintf("%d pending · %d complete · %d unhealthy", summary.Pending(), summary.Complete, summary.Unhealthy()) }
func taskGroupCount(summary AllocationSummary) string { if !summary.Available { return "—" }; return fmt.Sprintf("%d", summary.TaskGroups) }

func statusVariant(status string) string {
	switch status { case "running": return "success"; case "pending": return "warning"; default: return "neutral" }
}

func formatTimeAgo(t time.Time) string {
	if t.IsZero() { return "Unknown" }
	duration := time.Since(t)
	if duration < time.Minute { return "just now" }
	if duration < time.Hour { minutes := int(duration.Minutes()); if minutes == 1 { return "1 minute ago" }; return fmt.Sprintf("%d minutes ago", minutes) }
	if duration < 24*time.Hour { hours := int(duration.Hours()); if hours == 1 { return "1 hour ago" }; return fmt.Sprintf("%d hours ago", hours) }
	days := int(duration.Hours() / 24); if days == 1 { return "1 day ago" }; return fmt.Sprintf("%d days ago", days)
}
