package jobspartials

import (
	"fmt"
	"net/url"
	"time"

	"github.com/open-wander/wander/ui/templates/components"
)

type JobTemplate struct {
	Name        string
	Path        string
	Definition  string
	Modified    time.Time
	ModifyIndex uint64
	Readable    bool
	Valid       bool
}

type JobTemplatesProps struct {
	Templates []JobTemplate
	Namespace string
	Manage    bool
}

type JobTemplateCreateProps struct {
	Namespace string
}

templ JobTemplatesContent(props JobTemplatesProps) {
	<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
					if props.Manage {
						Manage Job Templates
					} else {
						Job Templates
					}
				</h1>
				<p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
					Stored in namespace <span class="font-medium text-neutral-900 dark:text-neutral-100">{ props.Namespace }</span> under <code>nomad/job-templates/</code>.
				</p>
			</div>
			<div class="flex gap-2">
				if props.Manage {
					<a href={ templ.SafeURL(templateRoute("/ui/jobs/run/templates", props.Namespace)) } class="inline-flex items-center rounded-md border border-neutral-300 dark:border-neutral-600 px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-200 hover:bg-neutral-50 dark:hover:bg-neutral-800">Choose Template</a>
				} else {
					<a href={ templ.SafeURL(templateRoute("/ui/jobs/run/templates/manage", props.Namespace)) } class="inline-flex items-center rounded-md border border-neutral-300 dark:border-neutral-600 px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-200 hover:bg-neutral-50 dark:hover:bg-neutral-800">Manage</a>
				}
				<a href={ templ.SafeURL(templateRoute("/ui/jobs/run/templates/new", props.Namespace)) } class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Create Template</a>
			</div>
		</div>
		if len(props.Templates) == 0 {
			<div class="rounded-lg border border-dashed border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900">
				@components.EmptyState(components.EmptyStateProps{Icon: "briefcase", Title: "No job templates", Description: "Create a reusable HCL job template in this namespace.", ActionLabel: "Create Template", ActionURL: templateRoute("/ui/jobs/run/templates/new", props.Namespace), Class: "min-h-[320px]"})
			</div>
		} else {
			<div class="space-y-4">
				for _, item := range props.Templates {
					if props.Manage {
						@jobTemplateManageCard(item, props.Namespace)
					} else {
						@jobTemplateChooseCard(item, props.Namespace)
					}
				}
			</div>
		}
	</div>
}

templ jobTemplateChooseCard(item JobTemplate, namespace string) {
	<div class="rounded-lg border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-5 shadow-sm">
		<div class="flex items-start justify-between gap-4">
			<div>
				<h2 class="font-semibold text-neutral-900 dark:text-neutral-100">{ item.Name }</h2>
				<p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">{ item.Path }</p>
				if !item.Readable {
					<p class="mt-3 text-sm text-warning-700 dark:text-warning-300">You can list this template but do not have permission to read it.</p>
				} else if !item.Valid {
					<p class="mt-3 text-sm text-error-700 dark:text-error-300">Malformed template: the required <code>template</code> item is missing.</p>
				}
			</div>
			if item.Readable && item.Valid {
				<a href={ templ.SafeURL(runTemplateRoute(item.Name, namespace)) } class="inline-flex shrink-0 items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Use Template</a>
			}
		</div>
	</div>
}

templ jobTemplateManageCard(item JobTemplate, namespace string) {
	<div class="rounded-lg border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-5 shadow-sm" x-data="{ editing: false }">
		<div class="flex items-start justify-between gap-4">
			<div>
				<h2 class="font-semibold text-neutral-900 dark:text-neutral-100">{ item.Name }</h2>
				<p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Modify index { fmt.Sprintf("%d", item.ModifyIndex) }</p>
			</div>
			<div class="flex gap-2">
				if item.Readable {
					<button type="button" @click="editing = !editing" class="rounded-md border border-neutral-300 dark:border-neutral-600 px-3 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-200 hover:bg-neutral-50 dark:hover:bg-neutral-800">Edit</button>
				}
				<button type="button" hx-delete={ manageTemplateRoute(item.Name, namespace) } hx-confirm={ "Delete job template " + item.Name + "?" } class="rounded-md border border-error-300 px-3 py-2 text-sm font-medium text-error-700 hover:bg-error-50 dark:border-error-700 dark:text-error-300 dark:hover:bg-error-950">Delete</button>
			</div>
		</div>
		if item.Readable {
			<form x-show="editing" x-cloak hx-post={ manageTemplateRoute(item.Name, namespace) } class="mt-5">
				<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300" for={ "template-" + item.Name }>HCL job definition</label>
				<textarea id={ "template-" + item.Name } name="template" rows="16" required spellcheck="false" class="mt-2 block w-full rounded-md border-neutral-300 bg-white font-mono text-sm text-neutral-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-neutral-600 dark:bg-neutral-950 dark:text-neutral-100">{ item.Definition }</textarea>
				<div class="mt-3 flex justify-end gap-2">
					<button type="button" @click="editing = false" class="rounded-md border border-neutral-300 dark:border-neutral-600 px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-200">Cancel</button>
					<button type="submit" class="rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Save Template</button>
				</div>
			</form>
		} else {
			<p class="mt-3 text-sm text-warning-700 dark:text-warning-300">Read permission is required to edit this template.</p>
		}
	</div>
}

templ JobTemplateCreateContent(props JobTemplateCreateProps) {
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="mb-6">
			<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">Create Job Template</h1>
			<p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Store reusable HCL source in the <span class="font-medium">{ props.Namespace }</span> namespace.</p>
		</div>
		<form method="post" action={ templ.SafeURL(templateRoute("/ui/jobs/run/templates/new", props.Namespace)) } hx-post={ templateRoute("/ui/jobs/run/templates/new", props.Namespace) } class="rounded-lg bg-white dark:bg-neutral-900 p-6 shadow space-y-6">
			<input type="hidden" name="namespace" value={ props.Namespace }/>
			<div>
				<label for="template-name" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Name</label>
				<input id="template-name" name="name" required placeholder="web-service" class="mt-2 block w-full rounded-md border-neutral-300 bg-white text-neutral-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-neutral-600 dark:bg-neutral-950 dark:text-neutral-100"/>
				<p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">Stored at <code>nomad/job-templates/&lt;name&gt;</code>.</p>
			</div>
			<div>
				<label for="template-source" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">HCL job definition</label>
				<textarea id="template-source" name="template" rows="22" required spellcheck="false" class="mt-2 block w-full rounded-md border-neutral-300 bg-white font-mono text-sm text-neutral-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-neutral-600 dark:bg-neutral-950 dark:text-neutral-100"></textarea>
			</div>
			<div class="flex justify-end gap-3 border-t border-neutral-200 dark:border-neutral-700 pt-5">
				<a href={ templ.SafeURL(templateRoute("/ui/jobs/run/templates", props.Namespace)) } class="rounded-md border border-neutral-300 dark:border-neutral-600 px-4 py-2 text-sm font-medium text-neutral-700 dark:text-neutral-200">Cancel</a>
				<button type="submit" class="rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Create Template</button>
			</div>
		</form>
	</div>
}

func templateRoute(path, namespace string) string {
	return path + "?namespace=" + url.QueryEscape(namespace)
}

func runTemplateRoute(name, namespace string) string {
	return "/ui/jobs/run?template=" + url.QueryEscape(name) + "&namespace=" + url.QueryEscape(namespace)
}

func manageTemplateRoute(name, namespace string) string {
	return "/ui/jobs/run/templates/manage/" + url.PathEscape(name) + "?namespace=" + url.QueryEscape(namespace)
}
