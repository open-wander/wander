package settingspartials

// SettingsContent renders the main content for the settings page.
templ SettingsContent(tokenInfo TokenInfo, oidcMethods []OIDCAuthMethod, authError string) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<!-- Page Header -->
		<div class="mb-8">
			<h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">Settings</h1>
			<p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
				Configure authorization and access control for Wander
			</p>
		</div>

		<!-- Token Section -->
		<div class="bg-white dark:bg-neutral-800 shadow rounded-lg">
			<div class="px-6 py-5 border-b border-neutral-200 dark:border-neutral-700">
				<h2 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">
					Authorization
				</h2>
				<p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
					Manage your ACL token for API access
				</p>
			</div>
			<div class="px-6 py-6">
				@TokenFormContent(tokenInfo, oidcMethods, authError)
			</div>
		</div>
	</div>
}
