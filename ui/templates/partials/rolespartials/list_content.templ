package rolespartials

import (
	"fmt"
	"net/url"

	"github.com/open-wander/wander/ui/templates/components"
	"github.com/open-wander/wander/ui/templates/partials/tokenspartials"
)

type RoleSummary struct {
	ID          string
	Name        string
	Description string
	PolicyCount int
}

templ ListContent(items []RoleSummary, search string) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="sm:flex sm:items-center sm:justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">ACL Roles</h1>
				<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">Group policies into reusable token roles.</p>
			</div>
			<a href="/ui/roles/new" hx-get="/ui/roles/new" hx-target="#main-content" hx-push-url="true" class="mt-4 sm:mt-0 inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">New Role</a>
		</div>
		@tokenspartials.ACLTabs("roles")
		<div class="mb-6">
			@components.SearchBar(components.SearchBarProps{Name: "search", Placeholder: "Search roles by name or description...", Value: search, SearchURL: "/ui/roles", ResultsID: "roles-table-container", Debounce: 300})
		</div>
		<div id="roles-table-container" class="overflow-hidden rounded-lg bg-white shadow dark:bg-neutral-900">
			@components.Table(components.TableProps{
				Columns: []components.Column{
					{Key: "name", Label: "Name", Align: "left"},
					{Key: "description", Label: "Description", Align: "left"},
					{Key: "policies", Label: "Policies", Align: "right"},
				},
				Striped: true,
				Hover:   true,
			}) {
				@components.TableBody() {
					if len(items) == 0 {
						@components.TableEmptyState("No roles found", "Create an ACL role or change the search query.")
					} else {
						for _, item := range items {
							<tr class="hover:bg-neutral-50 dark:hover:bg-neutral-800">
								@components.TableCell("left", "") {
									<a class="font-medium text-primary-600 hover:text-primary-800" href={ templ.SafeURL(roleDetailPath(item.ID)) } hx-get={ roleDetailPath(item.ID) } hx-target="#main-content" hx-push-url="true">{ item.Name }</a>
									<div class="mt-1 font-mono text-xs text-neutral-500">{ item.ID }</div>
								}
								@components.TableCell("left", "") {
									<span>{ item.Description }</span>
								}
								@components.TableCell("right", "") {
									<span>{ fmt.Sprintf("%d", item.PolicyCount) }</span>
								}
							</tr>
						}
					}
				}
			}
		</div>
	</div>
}

func roleDetailPath(roleID string) string {
	return "/ui/roles/" + url.PathEscape(roleID)
}
