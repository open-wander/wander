package topologypartials

import (
	"fmt"
	"github.com/open-wander/wander/ui/templates/components"
	"net/url"
	"strings"
)

// TopologyData represents the cluster topology data.
type TopologyData struct {
	Datacenters        []Datacenter
	TotalNodes         int
	ReadyNodes         int
	TotalAllocations   int
	TotalCPU           int
	UsedCPU            int
	TotalMemory        int64
	UsedMemory         int64
	VisibleNodes       int
	VisibleAllocations int
	Filters            Filters
	FilterOptions      FilterOptions
	Namespace          string
	Region             string
}

type Filters struct {
	Metric             string
	AllocationStatus   string
	NodePool           string
	Datacenter         string
	NodeClass          string
	State              string
	Version            string
	SelectedNode       string
	SelectedAllocation string
}

type FilterOptions struct {
	AllocationStatuses []string
	NodePools          []string
	Datacenters        []string
	NodeClasses        []string
	States             []string
	Versions           []string
}

// Datacenter represents a datacenter with its nodes.
type Datacenter struct {
	Name   string `json:"name"`
	Region string `json:"region"`
	Nodes  []Node `json:"nodes"`
}

// Node represents a client node in the topology.
type Node struct {
	ID                 string       `json:"id"`
	Name               string       `json:"name"`
	Status             string       `json:"status"`
	Datacenter         string       `json:"datacenter"`
	NodeClass          string       `json:"nodeClass"`
	NodePool           string       `json:"nodePool"`
	Version            string       `json:"version"`
	Allocations        int          `json:"allocations"`
	AllocationItems    []Allocation `json:"allocationItems"`
	CPUUsed            int          `json:"cpuUsed"`
	CPUTotal           int          `json:"cpuTotal"`
	MemoryUsed         int64        `json:"memoryUsed"`
	MemoryTotal        int64        `json:"memoryTotal"`
	ResourcesAvailable bool         `json:"resourcesAvailable"`
	DetailURL          string       `json:"detailUrl"`
	Selected           bool         `json:"selected"`
}

type Allocation struct {
	ID            string `json:"id"`
	JobID         string `json:"jobId"`
	TaskGroup     string `json:"taskGroup"`
	Namespace     string `json:"namespace"`
	ClientStatus  string `json:"clientStatus"`
	DesiredStatus string `json:"desiredStatus"`
	CPU           int64  `json:"cpu"`
	MemoryBytes   int64  `json:"memoryBytes"`
	DetailURL     string `json:"detailUrl"`
	JobURL        string `json:"jobUrl"`
	Selected      bool   `json:"selected"`
}

// ListContent renders the topology visualization content.
templ ListContent(data TopologyData) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="sm:flex sm:items-center sm:justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">Cluster Topology</h1>
				<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">
					Visual representation of cluster datacenters and nodes
				</p>
			</div>
		</div>
		<form id="topology-filters" class="mb-6 rounded-lg border border-neutral-200 bg-white p-4 shadow-sm dark:border-neutral-700 dark:bg-neutral-900" method="get" action="/ui/topology" hx-get="/ui/topology" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">
			if data.Namespace != "" {
				<input type="hidden" name="namespace" value={ data.Namespace }/>
			}
			if data.Region != "" {
				<input type="hidden" name="region" value={ data.Region }/>
			}
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				@topologyFilterSelect("metric", "Metrics", "", data.Filters.Metric, []string{"all", "allocations", "cpu", "memory"})
				@topologyFilterSelect("allocation_status", "Allocation Status", "", data.Filters.AllocationStatus, topologyAllocationStatusOptions(data.FilterOptions.AllocationStatuses))
				@topologyFilterSelect("node_pool", "Node Pool", "All node pools", data.Filters.NodePool, data.FilterOptions.NodePools)
				@topologyFilterSelect("datacenter", "Datacenter", "All datacenters", data.Filters.Datacenter, data.FilterOptions.Datacenters)
				@topologyFilterSelect("class", "Class", "All classes", data.Filters.NodeClass, data.FilterOptions.NodeClasses)
				@topologyFilterSelect("state", "State", "All states", data.Filters.State, data.FilterOptions.States)
				@topologyFilterSelect("version", "Version", "All versions", data.Filters.Version, data.FilterOptions.Versions)
			</div>
			<div class="mt-4 flex items-center justify-between gap-3">
				<p class="text-sm text-neutral-600 dark:text-neutral-400">Showing { fmt.Sprintf("%d client(s) and %d allocation(s)", data.VisibleNodes, data.VisibleAllocations) }</p>
				<div class="flex gap-3">
					if hasActiveTopologyFilters(data.Filters) {
						<a href={ templ.SafeURL(topologyClearURL(data)) } hx-get={ topologyClearURL(data) } hx-target="#main-content" hx-push-url="true" class="px-3 py-2 text-sm font-medium text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">Clear filters</a>
					}
					<button type="submit" class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">Apply filters</button>
				</div>
			</div>
		</form>
		<!-- Cluster Statistics -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
			<!-- Total Nodes -->
			<div class="bg-white dark:bg-neutral-900 shadow rounded-lg p-4">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-medium text-neutral-600 dark:text-neutral-400">Total Nodes</p>
						<p class="mt-1 text-2xl font-semibold text-neutral-900 dark:text-neutral-100">
							{ fmt.Sprintf("%d", data.TotalNodes) }
						</p>
					</div>
					<div class="p-3 bg-primary-100 dark:bg-primary-900 rounded-full">
						<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
						</svg>
					</div>
				</div>
			</div>
			<!-- Ready Nodes -->
			<div class="bg-white dark:bg-neutral-900 shadow rounded-lg p-4">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-medium text-neutral-600 dark:text-neutral-400">Ready Nodes</p>
						<p class="mt-1 text-2xl font-semibold text-green-600 dark:text-green-400">
							{ fmt.Sprintf("%d", data.ReadyNodes) }
						</p>
					</div>
					<div class="p-3 bg-green-100 dark:bg-green-900 rounded-full">
						<svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					</div>
				</div>
			</div>
			<!-- Total Allocations -->
			<div class="bg-white dark:bg-neutral-900 shadow rounded-lg p-4">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-medium text-neutral-600 dark:text-neutral-400">Allocations</p>
						<p class="mt-1 text-2xl font-semibold text-neutral-900 dark:text-neutral-100">
							{ fmt.Sprintf("%d", data.TotalAllocations) }
						</p>
					</div>
					<div class="p-3 bg-blue-100 dark:bg-blue-900 rounded-full">
						<svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
						</svg>
					</div>
				</div>
			</div>
			<!-- CPU Usage -->
			<div class="bg-white dark:bg-neutral-900 shadow rounded-lg p-4">
				<div class="flex items-center justify-between">
					<div class="flex-1 mr-3">
						<p class="text-sm font-medium text-neutral-600 dark:text-neutral-400">CPU Allocated</p>
						<p class="mt-1 text-lg font-semibold text-neutral-900 dark:text-neutral-100">
							{ fmt.Sprintf("%d%%", calculateCPUPercentage(data.UsedCPU, data.TotalCPU)) }
						</p>
						<p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">
							{ fmt.Sprintf("%d / %d MHz", data.UsedCPU, data.TotalCPU) }
						</p>
					</div>
					<div class="w-12 h-12">
						@components.CircularProgress(components.CircularProgressProps{
							Value: calculateCPUPercentage(data.UsedCPU, data.TotalCPU),
							Max:   100,
							Size:  "sm",
							Color: resourceColor(calculateCPUPercentage(data.UsedCPU, data.TotalCPU)),
						})
					</div>
				</div>
			</div>
		</div>
		<!-- Datacenters Grid -->
		<div class="space-y-6">
			<h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">Datacenters</h2>
			if len(data.Datacenters) == 0 {
				<div class="rounded-lg border border-neutral-200 bg-white p-8 text-center shadow-sm dark:border-neutral-700 dark:bg-neutral-900">
					<h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">No clients match these filters</h3>
					<p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Adjust or clear the topology filters to restore the graph.</p>
				</div>
			} else {
				for _, dc := range data.Datacenters {
					@datacenterCard(dc, data)
				}
			}
		</div>
	</div>
}

// datacenterCard renders a single datacenter with its nodes.
templ datacenterCard(dc Datacenter, data TopologyData) {
	<div class="bg-white dark:bg-neutral-900 shadow rounded-lg overflow-hidden">
		<!-- Datacenter Header -->
		<div class="bg-neutral-100 dark:bg-neutral-800 px-6 py-4 border-b border-neutral-200 dark:border-neutral-700">
			<div class="flex items-center justify-between">
				<div>
					<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">{ dc.Name }</h3>
					<p class="text-sm text-neutral-600 dark:text-neutral-400">Region: { dc.Region }</p>
				</div>
				<div class="text-sm text-neutral-600 dark:text-neutral-400">
					{ fmt.Sprintf("%d node(s)", len(dc.Nodes)) }
				</div>
			</div>
		</div>
		<!-- Nodes Grid -->
		<div class="p-6">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
				for _, node := range dc.Nodes {
					@nodeCard(node, data)
				}
			</div>
		</div>
	</div>
}

// nodeCard renders a single node card.
templ nodeCard(node Node, data TopologyData) {
	<div data-topology-node-id={ node.ID } data-selected={ fmt.Sprintf("%t", node.Selected) } class={ topologyNodeClasses(node.Selected) }>
		<!-- Node Header -->
		<div class="flex items-start justify-between mb-3">
			<div class="flex-1">
				<a
					href={ templ.SafeURL(node.DetailURL) }
					class="text-sm font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
				>
					{ node.Name }
				</a>
				<p class="text-xs text-neutral-500 dark:text-neutral-400 font-mono mt-0.5">
					{ truncateID(node.ID) }
				</p>
			</div>
			<div>
				@components.Badge(components.BadgeProps{
					Variant: nodeStatusVariant(node.Status),
					Dot:     true,
					Size:    "sm",
				}) {
					{ node.Status }
				}
			</div>
		</div>
		<!-- Node Class -->
		if node.NodeClass != "" {
			<div class="mb-3">
				<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
					{ node.NodeClass }
				</span>
			</div>
		}
		<div class="mb-3 flex flex-wrap gap-2 text-xs text-neutral-500 dark:text-neutral-400">
			if node.NodePool != "" {
				<span>Pool: { node.NodePool }</span>
			}
			if node.Version != "" {
				<span>Version: { node.Version }</span>
			}
		</div>
		<!-- Allocations Count -->
		<div class="mb-3">
			<div class="flex items-center justify-between text-xs">
				<span class="text-neutral-600 dark:text-neutral-400">Allocations</span>
				<span class="font-semibold text-neutral-900 dark:text-neutral-100">
					{ fmt.Sprintf("%d", node.Allocations) }
				</span>
			</div>
		</div>
		<!-- Resource Bars -->
		if node.ResourcesAvailable && data.Filters.Metric != "allocations" {
			<div class="space-y-2" aria-label="Allocated resources and schedulable capacity">
				<!-- CPU -->
				if data.Filters.Metric == "all" || data.Filters.Metric == "cpu" {
					<div>
						<div class="flex items-center justify-between text-xs mb-1">
							<span class="text-neutral-600 dark:text-neutral-400">CPU allocated</span>
							<span class="text-neutral-700 dark:text-neutral-300">
								{ fmt.Sprintf("%d / %d MHz (%d%%)", node.CPUUsed, node.CPUTotal, calculatePercentage(node.CPUUsed, node.CPUTotal)) }
							</span>
						</div>
						@components.ProgressBar(components.ProgressProps{
							Value: calculatePercentage(node.CPUUsed, node.CPUTotal),
							Max:   100,
							Size:  "xs",
							Color: resourceColor(calculatePercentage(node.CPUUsed, node.CPUTotal)),
						})
					</div>
				}
				<!-- Memory -->
				if data.Filters.Metric == "all" || data.Filters.Metric == "memory" {
					<div>
						<div class="flex items-center justify-between text-xs mb-1">
							<span class="text-neutral-600 dark:text-neutral-400">Memory allocated</span>
							<span class="text-neutral-700 dark:text-neutral-300">
								{ fmt.Sprintf("%s / %s (%d%%)", formatMemory(node.MemoryUsed), formatMemory(node.MemoryTotal), calculateMemoryPercentage(node.MemoryUsed, node.MemoryTotal)) }
							</span>
						</div>
						@components.ProgressBar(components.ProgressProps{
							Value: calculateMemoryPercentage(node.MemoryUsed, node.MemoryTotal),
							Max:   100,
							Size:  "xs",
							Color: resourceColor(calculateMemoryPercentage(node.MemoryUsed, node.MemoryTotal)),
						})
					</div>
				}
			</div>
		} else if !node.ResourcesAvailable && data.Filters.Metric != "allocations" {
			<p class="text-xs text-neutral-500 dark:text-neutral-400">Resource data unavailable</p>
		}
		if len(node.AllocationItems) > 0 && (node.ResourcesAvailable || data.Filters.Metric == "allocations") {
			@topologyCapacityMap(node, data.Filters.Metric)
		}
		<div class="mt-4 border-t border-neutral-200 pt-3 dark:border-neutral-700">
			<div class="flex items-center justify-between gap-2">
				<p class="text-xs font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">Allocation overlay</p>
				<a href={ templ.SafeURL(topologySelectionURL(data, node.ID, "")) } hx-get={ topologySelectionURL(data, node.ID, "") } hx-target="#main-content" hx-push-url="true" class="text-xs font-medium text-primary-600 hover:underline dark:text-primary-400">Select client</a>
			</div>
			if len(node.AllocationItems) == 0 {
				<p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">No allocations match the selected status.</p>
			} else {
				<div class="mt-3 ml-2 space-y-2 border-l-2 border-primary-200 pl-4 dark:border-primary-800" role="list" aria-label={ "Allocations connected to " + node.Name }>
					for _, allocation := range node.AllocationItems {
						@topologyAllocation(allocation, data, node.ID)
					}
				</div>
			}
		</div>
	</div>
}

templ topologyCapacityMap(node Node, metric string) {
	<div data-topology-capacity-map={ node.ID } class="mt-4 rounded-md border border-neutral-200 bg-neutral-50 p-3 dark:border-neutral-700 dark:bg-neutral-800/50">
		<p class="text-xs font-semibold uppercase tracking-wide text-neutral-600 dark:text-neutral-300">Allocation reservation map</p>
		<p class="mt-1 text-[11px] text-neutral-500 dark:text-neutral-400">Segments show scheduler reservations against this client's full capacity, not live utilization.</p>
		<div class="mt-3 space-y-3">
			if metric == "all" || metric == "cpu" {
				@topologyCapacityTrack(node, "cpu")
			}
			if metric == "all" || metric == "memory" {
				@topologyCapacityTrack(node, "memory")
			}
			if metric == "allocations" {
				@topologyPlacementTrack(node)
			}
		</div>
	</div>
}

templ topologyCapacityTrack(node Node, resource string) {
	<div data-topology-resource={ resource }>
		<div class="mb-1 flex items-center justify-between gap-2 text-[11px]">
			<span class="font-medium text-neutral-700 dark:text-neutral-300">{ topologyResourceLabel(resource) }</span>
			<span class="text-neutral-500 dark:text-neutral-400">{ topologyCapacityLabel(node, resource) }</span>
		</div>
		<div class="flex h-7 overflow-hidden rounded border border-neutral-300 bg-white dark:border-neutral-600 dark:bg-neutral-900" role="list" aria-label={ topologyTrackAriaLabel(node, resource) }>
			for _, allocation := range node.AllocationItems {
				if topologyReservationPercent(allocation, node, resource) > 0 {
					<a
						data-topology-resource-segment={ allocation.ID }
						href={ templ.SafeURL(allocation.DetailURL) }
						class={ topologyReservationSegmentClasses(allocation.ClientStatus) }
						style={ fmt.Sprintf("width: %.2f%%", topologyReservationPercent(allocation, node, resource)) }
						aria-label={ topologyReservationAriaLabel(allocation, resource) }
						title={ topologyReservationAriaLabel(allocation, resource) }
						role="listitem"
					></a>
				}
			}
		</div>
	</div>
}

templ topologyPlacementTrack(node Node) {
	<div data-topology-resource="allocations">
		<div class="mb-1 flex items-center justify-between gap-2 text-[11px]">
			<span class="font-medium text-neutral-700 dark:text-neutral-300">Allocation placement</span>
			<span class="text-neutral-500 dark:text-neutral-400">{ fmt.Sprintf("%d visible", len(node.AllocationItems)) }</span>
		</div>
		<div class="grid h-7 gap-1" style={ fmt.Sprintf("grid-template-columns: repeat(%d, minmax(0, 1fr))", len(node.AllocationItems)) } role="list" aria-label={ "Allocations placed on " + node.Name }>
			for _, allocation := range node.AllocationItems {
				<a
					data-topology-resource-segment={ allocation.ID }
					href={ templ.SafeURL(allocation.DetailURL) }
					class={ topologyPlacementSegmentClasses(allocation.ClientStatus) }
					aria-label={ topologyReservationAriaLabel(allocation, "allocations") }
					title={ topologyReservationAriaLabel(allocation, "allocations") }
					role="listitem"
				></a>
			}
		</div>
	</div>
}

templ topologyAllocation(allocation Allocation, data TopologyData, nodeID string) {
	<div data-topology-allocation-id={ allocation.ID } data-selected={ fmt.Sprintf("%t", allocation.Selected) } class={ topologyAllocationClasses(allocation.Selected) } role="listitem">
		<div class="flex items-start justify-between gap-2">
			<div class="min-w-0">
				<a href={ templ.SafeURL(allocation.DetailURL) } class="font-mono text-xs font-semibold text-primary-600 hover:underline dark:text-primary-400">{ truncateID(allocation.ID) }</a>
				<p class="truncate text-xs text-neutral-700 dark:text-neutral-300"><a href={ templ.SafeURL(allocation.JobURL) } class="hover:underline">{ allocation.JobID }</a> / { allocation.TaskGroup }</p>
			</div>
			@components.Badge(components.BadgeProps{Variant: allocationStatusVariant(allocation.ClientStatus), Size: "sm"}) {
				{ allocation.ClientStatus }
			}
		</div>
		<div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-neutral-500 dark:text-neutral-400">
			<span>{ fmt.Sprintf("%d MHz", allocation.CPU) }</span>
			<span>{ formatMemory(allocation.MemoryBytes) }</span>
			if allocation.DesiredStatus != "" {
				<span>Desired: { allocation.DesiredStatus }</span>
			}
		</div>
		<a href={ templ.SafeURL(topologySelectionURL(data, nodeID, allocation.ID)) } hx-get={ topologySelectionURL(data, nodeID, allocation.ID) } hx-target="#main-content" hx-push-url="true" class="mt-2 inline-block text-xs font-medium text-primary-600 hover:underline dark:text-primary-400">Select allocation</a>
	</div>
}

// nodeStatusVariant maps node status to badge variant.
func nodeStatusVariant(status string) string {
	switch status {
	case "ready":
		return "success"
	case "down":
		return "error"
	case "draining":
		return "warning"
	default:
		return "neutral"
	}
}

// resourceColor returns the appropriate color based on usage percentage.
func resourceColor(percentage int) string {
	if percentage >= 90 {
		return "error"
	} else if percentage >= 75 {
		return "warning"
	}
	return "success"
}

// calculatePercentage calculates usage percentage for integers.
func calculatePercentage(used int, total int) int {
	if total == 0 {
		return 0
	}
	return (used * 100) / total
}

// calculateMemoryPercentage calculates usage percentage for int64.
func calculateMemoryPercentage(used int64, total int64) int {
	if total == 0 {
		return 0
	}
	return int((used * 100) / total)
}

// calculateCPUPercentage calculates cluster-wide CPU usage percentage.
func calculateCPUPercentage(used int, total int) int {
	if total == 0 {
		return 0
	}
	return (used * 100) / total
}

func topologyResourceLabel(resource string) string {
	if resource == "memory" {
		return "Memory capacity"
	}
	return "CPU capacity"
}

func topologyCapacityLabel(node Node, resource string) string {
	if resource == "memory" {
		return fmt.Sprintf("%s visible reservations of %s", formatMemory(topologyVisibleMemory(node)), formatMemory(node.MemoryTotal))
	}
	return fmt.Sprintf("%d visible reservations of %d MHz", topologyVisibleCPU(node), node.CPUTotal)
}

func topologyVisibleCPU(node Node) int64 {
	var total int64
	for _, allocation := range node.AllocationItems {
		total += allocation.CPU
	}
	return total
}

func topologyVisibleMemory(node Node) int64 {
	var total int64
	for _, allocation := range node.AllocationItems {
		total += allocation.MemoryBytes
	}
	return total
}

func topologyTrackAriaLabel(node Node, resource string) string {
	return fmt.Sprintf("%s reservations against full capacity for %s", topologyResourceLabel(resource), node.Name)
}

func topologyReservationPercent(allocation Allocation, node Node, resource string) float64 {
	var reserved, capacity float64
	if resource == "memory" {
		reserved, capacity = float64(allocation.MemoryBytes), float64(node.MemoryTotal)
	} else {
		reserved, capacity = float64(allocation.CPU), float64(node.CPUTotal)
	}
	if reserved <= 0 || capacity <= 0 {
		return 0
	}
	percentage := reserved * 100 / capacity
	if percentage > 100 {
		return 100
	}
	return percentage
}

func topologyReservationAriaLabel(allocation Allocation, resource string) string {
	switch resource {
	case "memory":
		return fmt.Sprintf("%s, %s, %s memory reserved", allocation.JobID, allocation.TaskGroup, formatMemory(allocation.MemoryBytes))
	case "cpu":
		return fmt.Sprintf("%s, %s, %d MHz CPU reserved", allocation.JobID, allocation.TaskGroup, allocation.CPU)
	default:
		return fmt.Sprintf("%s, %s, %s allocation", allocation.JobID, allocation.TaskGroup, allocation.ClientStatus)
	}
}

func topologyReservationSegmentClasses(status string) string {
	classes := "block h-full min-w-px border-r border-white/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary-900 dark:border-neutral-900/70"
	switch status {
	case "running":
		return classes + " bg-success-500 hover:bg-success-600"
	case "pending":
		return classes + " bg-warning-400 hover:bg-warning-500"
	case "failed", "lost":
		return classes + " bg-error-500 hover:bg-error-600"
	default:
		return classes + " bg-neutral-400 hover:bg-neutral-500"
	}
}

func topologyPlacementSegmentClasses(status string) string {
	return topologyReservationSegmentClasses(status) + " rounded border-0"
}

// truncateID truncates a node ID to first 8 characters.
func truncateID(id string) string {
	if len(id) <= 8 {
		return id
	}
	return id[:8]
}

templ topologyFilterSelect(name, label, emptyLabel, selected string, options []string) {
	<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
		<span>{ label }</span>
		<select name={ name } class="mt-1 block w-full rounded-md border-neutral-300 bg-white text-sm shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100">
			if emptyLabel != "" {
				<option value="">{ emptyLabel }</option>
			}
			for _, option := range options {
				<option value={ option } selected?={ option == selected }>{ topologyOptionLabel(option) }</option>
			}
		</select>
	</label>
}

func topologyAllocationStatusOptions(statuses []string) []string {
	result := []string{"active", "all"}
	for _, status := range statuses {
		if status != "active" && status != "all" {
			result = append(result, status)
		}
	}
	return result
}

func topologyOptionLabel(value string) string {
	switch value {
	case "all":
		return "All"
	case "active":
		return "Active (pending and running)"
	case "allocations":
		return "Allocation count"
	case "cpu":
		return "CPU reservations"
	case "memory":
		return "Memory reservations"
	}
	return strings.ToUpper(value[:1]) + value[1:]
}

func topologyNodeClasses(selected bool) string {
	classes := "rounded-lg border p-4 transition-shadow hover:shadow-md"
	if selected {
		return classes + " border-primary-500 bg-primary-50 ring-2 ring-primary-200 dark:border-primary-400 dark:bg-primary-950/30 dark:ring-primary-800"
	}
	return classes + " border-neutral-200 dark:border-neutral-700"
}

func topologyAllocationClasses(selected bool) string {
	classes := "relative rounded-md border p-3 before:absolute before:-left-[1.1rem] before:top-5 before:w-4 before:border-t-2"
	if selected {
		return classes + " border-primary-500 bg-primary-50 before:border-primary-500 dark:border-primary-400 dark:bg-primary-950/30"
	}
	return classes + " border-neutral-200 bg-neutral-50 before:border-primary-200 dark:border-neutral-700 dark:bg-neutral-800/60 dark:before:border-primary-800"
}

func allocationStatusVariant(status string) string {
	switch status {
	case "running":
		return "success"
	case "pending":
		return "warning"
	case "failed", "lost":
		return "error"
	default:
		return "neutral"
	}
}

func hasActiveTopologyFilters(filters Filters) bool {
	return filters.Metric != "all" || filters.AllocationStatus != "active" || filters.NodePool != "" || filters.Datacenter != "" || filters.NodeClass != "" || filters.State != "" || filters.Version != ""
}

func topologySelectionURL(data TopologyData, selectedNode, selectedAllocation string) string {
	query := topologyQuery(data)
	if selectedNode != "" {
		query.Set("selected_node", selectedNode)
	}
	if selectedAllocation != "" {
		query.Set("selected_allocation", selectedAllocation)
	}
	return topologyURL(query)
}

func topologyClearURL(data TopologyData) string {
	query := url.Values{}
	if data.Namespace != "" {
		query.Set("namespace", data.Namespace)
	}
	if data.Region != "" {
		query.Set("region", data.Region)
	}
	return topologyURL(query)
}

func topologyQuery(data TopologyData) url.Values {
	query := url.Values{}
	setTopologyQuery(query, "namespace", data.Namespace)
	setTopologyQuery(query, "region", data.Region)
	if data.Filters.Metric != "all" {
		setTopologyQuery(query, "metric", data.Filters.Metric)
	}
	if data.Filters.AllocationStatus != "active" {
		setTopologyQuery(query, "allocation_status", data.Filters.AllocationStatus)
	}
	setTopologyQuery(query, "node_pool", data.Filters.NodePool)
	setTopologyQuery(query, "datacenter", data.Filters.Datacenter)
	setTopologyQuery(query, "class", data.Filters.NodeClass)
	setTopologyQuery(query, "state", data.Filters.State)
	setTopologyQuery(query, "version", data.Filters.Version)
	return query
}

func setTopologyQuery(query url.Values, key, value string) {
	if value != "" {
		query.Set(key, value)
	}
}

func topologyURL(query url.Values) string {
	if encoded := query.Encode(); encoded != "" {
		return "/ui/topology?" + encoded
	}
	return "/ui/topology"
}

func formatMemory(bytes int64) string {
	const megabyte = 1024 * 1024
	const gigabyte = 1024 * megabyte
	if bytes >= gigabyte {
		return fmt.Sprintf("%.1f GB", float64(bytes)/float64(gigabyte))
	}
	return fmt.Sprintf("%.1f MB", float64(bytes)/float64(megabyte))
}
