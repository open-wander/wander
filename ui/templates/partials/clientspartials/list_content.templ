package clientspartials

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/open-wander/wander/ui/templates/components"
)

// ClientSummary represents a summary view of a client for list display.
type ClientSummary struct {
	ID                   string
	Name                 string
	Address              string
	Status               string
	Datacenter           string
	NodePool             string
	NodeClass            string
	Version              string
	Volumes              []string
	DetailURL            string
	Allocations          int
	CPUUsed              int
	CPUTotal             int
	MemUsed              int64
	MemTotal             int64
	DiskUsed             int64
	DiskTotal            int64
	ResourcesAvailable   bool
	AllocationsAvailable bool
}

// ClientFilters holds the current filter values for the clients list.
type ClientFilters struct {
	Namespace  string
	Region     string
	Status     string
	Datacenter string
	NodePool   string
	NodeClass  string
	Version    string
	Volume     string
	Search     string
}

// ClientFilterOptions holds the available options for each filter.
type ClientFilterOptions struct {
	Datacenters []string
	NodeClasses []string
	NodePools   []string
	Versions    []string
	Volumes     []string
}

type PaginationMeta struct {
	Page       int
	PerPage    int
	Total      int
	TotalPages int
}

type ListProps struct {
	Clients       []ClientSummary
	FilterOptions ClientFilterOptions
	Filters       ClientFilters
	Pagination    PaginationMeta
	SortColumn    string
	SortDir       string
}

// ListContent renders the clients table content for HTMX partial updates.
templ ListContent(props ListProps) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="sm:flex sm:items-center sm:justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">Clients</h1>
				<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">
					View and manage Wander client nodes
				</p>
			</div>
		</div>
		<form class="mb-6 rounded-lg border border-neutral-200 bg-white p-4 shadow-sm dark:border-neutral-700 dark:bg-neutral-900" method="get" action="/ui/clients" hx-get="/ui/clients" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">
			if props.Filters.Namespace != "" {
				<input type="hidden" name="namespace" value={ props.Filters.Namespace }/>
			}
			if props.Filters.Region != "" {
				<input type="hidden" name="region" value={ props.Filters.Region }/>
			}
			<input type="hidden" name="sort" value={ props.SortColumn }/>
			<input type="hidden" name="dir" value={ props.SortDir }/>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300"><span>Search</span><input type="search" name="search" value={ props.Filters.Search } placeholder="Name, address, ID, pool, version, or volume" class="mt-1 block w-full rounded-md border-neutral-300 text-sm shadow-sm dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100"/></label>
				@clientFilterSelect("status", "State", "All states", props.Filters.Status, []string{"initializing", "ready", "down", "disconnected", "ineligible", "draining"})
				@clientFilterSelect("nodepool", "Node pool", "All node pools", props.Filters.NodePool, props.FilterOptions.NodePools)
				@clientFilterSelect("nodeclass", "Class", "All classes", props.Filters.NodeClass, props.FilterOptions.NodeClasses)
				@clientFilterSelect("datacenter", "Datacenter", "All datacenters", props.Filters.Datacenter, props.FilterOptions.Datacenters)
				@clientFilterSelect("version", "Version", "All versions", props.Filters.Version, props.FilterOptions.Versions)
				@clientFilterSelect("volume", "Volume", "All volumes", props.Filters.Volume, props.FilterOptions.Volumes)
				@clientPageSizeSelect(props.Pagination.PerPage)
			</div>
			<div class="mt-4 flex justify-end gap-3">
				if hasActiveFilters(props.Filters) {
					<a href={ templ.SafeURL(clientClearFiltersURL(props)) } hx-get={ clientClearFiltersURL(props) } hx-target="#main-content" hx-push-url="true" class="px-3 py-2 text-sm font-medium text-neutral-600 dark:text-neutral-400">Clear filters</a>
				}
				<button type="submit" class="rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500">Apply filters</button>
			</div>
		</form>
		<!-- Clients Table Container -->
		<div id="clients-table-container" class="bg-white dark:bg-neutral-900 shadow rounded-lg overflow-hidden">
			@ClientsTable(props)
		</div>
	</div>
}

templ ClientsTable(props ListProps) {
	@components.Table(components.TableProps{
		Columns: []components.Column{
			{Key: "name", Label: "Name", Sortable: true, Align: "left"},
			{Key: "address", Label: "Address", Sortable: true, Align: "left"},
			{Key: "status", Label: "State", Sortable: true, Align: "center", Width: "w-28"},
			{Key: "nodepool", Label: "Node Pool", Sortable: true, Align: "left"},
			{Key: "nodeclass", Label: "Class", Sortable: true, Align: "left"},
			{Key: "datacenter", Label: "DC", Sortable: true, Align: "left", Width: "w-24"},
			{Key: "version", Label: "Version", Sortable: true, Align: "left"},
			{Key: "volumes", Label: "Volumes", Sortable: true, Align: "left"},
			{Key: "allocations", Label: "Running Allocs", Sortable: true, Align: "center", Width: "w-20"},
			{Key: "resources", Label: "Allocated / Capacity", Sortable: false, Align: "left"},
		},
		SortColumn: props.SortColumn,
		SortDir:    props.SortDir,
		Striped:    true,
		Compact:    true,
		Hover:      true,
		SortURL:    buildClientsURL(props.Filters, "", "", props.Pagination.PerPage),
		HxTarget:   "#main-content",
		Class:      "min-w-[96rem]",
	}) {
		@components.TableBody() {
			if len(props.Clients) == 0 {
				@components.TableEmptyState("No clients found", "There are no client nodes to display")
			} else {
				for _, client := range props.Clients {
					@clientRow(client)
				}
			}
		}
	}
	@components.Pagination(components.PaginationProps{Page: props.Pagination.Page, PerPage: props.Pagination.PerPage, Total: props.Pagination.Total, BaseURL: buildClientsURL(props.Filters, props.SortColumn, props.SortDir, 0), HxTarget: "#clients-table-container", HxSwap: "innerHTML"})
}

// clientRow renders a single client row in the table
templ clientRow(client ClientSummary) {
	<tr
		data-client-id={ client.ID }
		class="transition-colors duration-100 hover:bg-neutral-50 dark:hover:bg-neutral-800 cursor-pointer"
		hx-get={ client.DetailURL }
		hx-target="#main-content"
		hx-swap="innerHTML"
		hx-push-url="true"
	>
		@components.TableCell("left", "") {
			<a
				href={ templ.SafeURL(client.DetailURL) }
				class="font-medium text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
				@click.stop
			>
				{ client.Name }
			</a>
			<div class="text-xs text-neutral-500 dark:text-neutral-400 font-mono">
				{ truncateID(client.ID) }
			</div>
		}
		@components.TableCell("left", "") {
			<span class="text-neutral-700 dark:text-neutral-300 font-mono text-sm">
				{ client.Address }
			</span>
		}
		@components.TableCell("center", "w-28") {
			@components.Badge(components.BadgeProps{
				Variant: statusVariant(client.Status),
				Dot:     true,
				Size:    "sm",
			}) {
				{ client.Status }
			}
		}
		@textClientCell(client.NodePool)
		@textClientCell(client.NodeClass)
		@components.TableCell("left", "w-24") {
			<span class="text-neutral-700 dark:text-neutral-300">
				{ client.Datacenter }
			</span>
		}
		@textClientCell(client.Version)
		@textClientCell(formatClientVolumes(client.Volumes))
		@components.TableCell("center", "w-20") {
			if client.AllocationsAvailable {
				<span class="text-neutral-700 dark:text-neutral-300 font-medium">
					{ fmt.Sprintf("%d", client.Allocations) }
				</span>
			} else {
				<span class="text-neutral-500 dark:text-neutral-400">Unavailable</span>
			}
		}
		@components.TableCell("left", "") {
			if !client.ResourcesAvailable {
				<span class="text-sm text-neutral-500 dark:text-neutral-400">Unavailable</span>
			} else {
				<div class="space-y-2 min-w-[200px]" aria-label="Allocated resources and schedulable capacity">
					<!-- CPU Resource Bar -->
					<div>
						<div class="flex items-center justify-between text-xs mb-1">
							<span class="text-neutral-600 dark:text-neutral-400">CPU allocated</span>
							<span class="text-neutral-700 dark:text-neutral-300 font-medium">
								{ fmt.Sprintf("%d / %d MHz", client.CPUUsed, client.CPUTotal) }
							</span>
						</div>
						@components.ProgressBar(components.ProgressProps{
							Value: calculatePercentage(client.CPUUsed, client.CPUTotal),
							Max:   100,
							Size:  "sm",
							Color: resourceColor(calculatePercentage(client.CPUUsed, client.CPUTotal)),
						})
					</div>
					<!-- Memory Resource Bar -->
					<div>
						<div class="flex items-center justify-between text-xs mb-1">
							<span class="text-neutral-600 dark:text-neutral-400">Memory allocated</span>
							<span class="text-neutral-700 dark:text-neutral-300 font-medium">
								{ formatMemory(client.MemUsed) } / { formatMemory(client.MemTotal) }
							</span>
						</div>
						@components.ProgressBar(components.ProgressProps{
							Value: calculateMemoryPercentage(client.MemUsed, client.MemTotal),
							Max:   100,
							Size:  "sm",
							Color: resourceColor(calculateMemoryPercentage(client.MemUsed, client.MemTotal)),
						})
					</div>
					<!-- Disk Resource Bar -->
					<div>
						<div class="flex items-center justify-between text-xs mb-1">
							<span class="text-neutral-600 dark:text-neutral-400">Disk allocated</span>
							<span class="text-neutral-700 dark:text-neutral-300 font-medium">
								{ formatMemory(client.DiskUsed) } / { formatMemory(client.DiskTotal) }
							</span>
						</div>
						@components.ProgressBar(components.ProgressProps{
							Value: calculateMemoryPercentage(client.DiskUsed, client.DiskTotal),
							Max:   100,
							Size:  "sm",
							Color: resourceColor(calculateMemoryPercentage(client.DiskUsed, client.DiskTotal)),
						})
					</div>
				</div>
			}
		}
	</tr>
}

templ textClientCell(value string) {
	@components.TableCell("left", "") {
		if value == "" {
			<span class="text-neutral-400 dark:text-neutral-500">—</span>
		} else {
			<span class="text-sm text-neutral-700 dark:text-neutral-300">{ value }</span>
		}
	}
}

// statusVariant maps client status to badge variant
func statusVariant(status string) string {
	switch status {
	case "ready":
		return "success"
	case "initializing":
		return "info"
	case "down":
		return "error"
	case "disconnected":
		return "error"
	case "draining":
		return "warning"
	case "ineligible":
		return "neutral"
	default:
		return "neutral"
	}
}

// resourceColor returns the appropriate color for the ProgressBar based on usage percentage
// Green: <50%, Yellow: 50-75%, Orange: 75-90%, Red: >=90%
func resourceColor(percentage int) string {
	if percentage >= 90 {
		return "error"
	} else if percentage >= 75 {
		return "warning"
	} else if percentage >= 50 {
		return "warning"
	}
	return "success"
}

// calculatePercentage calculates the usage percentage for CPU
func calculatePercentage(used int, total int) int {
	if total == 0 {
		return 0
	}
	return (used * 100) / total
}

// calculateMemoryPercentage calculates the usage percentage for memory/disk
func calculateMemoryPercentage(used int64, total int64) int {
	if total == 0 {
		return 0
	}
	return int((used * 100) / total)
}

// formatMemory formats bytes into human-readable format
func formatMemory(bytes int64) string {
	const (
		KB = 1024
		MB = KB * 1024
		GB = MB * 1024
		TB = GB * 1024
	)

	switch {
	case bytes >= TB:
		return fmt.Sprintf("%.1f TB", float64(bytes)/float64(TB))
	case bytes >= GB:
		return fmt.Sprintf("%.1f GB", float64(bytes)/float64(GB))
	case bytes >= MB:
		return fmt.Sprintf("%.1f MB", float64(bytes)/float64(MB))
	case bytes >= KB:
		return fmt.Sprintf("%.1f KB", float64(bytes)/float64(KB))
	default:
		return fmt.Sprintf("%d B", bytes)
	}
}

// truncateID truncates a client ID to show first 8 characters
func truncateID(id string) string {
	if len(id) <= 8 {
		return id
	}
	return id[:8]
}

func buildClientsURL(filters ClientFilters, sortColumn, sortDir string, perPage int) string {
	params := url.Values{}
	setClientParam(params, "namespace", filters.Namespace)
	setClientParam(params, "region", filters.Region)
	setClientParam(params, "status", filters.Status)
	setClientParam(params, "datacenter", filters.Datacenter)
	setClientParam(params, "nodepool", filters.NodePool)
	setClientParam(params, "nodeclass", filters.NodeClass)
	setClientParam(params, "version", filters.Version)
	setClientParam(params, "volume", filters.Volume)
	setClientParam(params, "search", filters.Search)
	setClientParam(params, "sort", sortColumn)
	setClientParam(params, "dir", sortDir)
	if perPage > 0 {
		params.Set("per_page", fmt.Sprintf("%d", perPage))
	}
	if encoded := params.Encode(); encoded != "" {
		return "/ui/clients?" + encoded
	}
	return "/ui/clients"
}

func setClientParam(params url.Values, name, value string) {
	if value != "" {
		params.Set(name, value)
	}
}

func clientClearFiltersURL(props ListProps) string {
	return buildClientsURL(ClientFilters{Namespace: props.Filters.Namespace, Region: props.Filters.Region}, "", "", props.Pagination.PerPage)
}

// hasActiveFilters returns true if any filter is active.
func hasActiveFilters(filters ClientFilters) bool {
	return filters.Status != "" || filters.Datacenter != "" || filters.NodePool != "" || filters.NodeClass != "" || filters.Version != "" || filters.Volume != "" || filters.Search != ""
}

func formatClientVolumes(volumes []string) string {
	return strings.Join(volumes, ", ")
}

templ clientFilterSelect(name, label, placeholder, selected string, options []string) {
	<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
		<span>{ label }</span>
		<select name={ name } class="mt-1 block w-full rounded-md border-neutral-300 text-sm shadow-sm dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100">
			<option value="">{ placeholder }</option>
			for _, option := range options {
				<option value={ option } selected?={ selected == option }>{ option }</option>
			}
		</select>
	</label>
}

templ clientPageSizeSelect(selected int) {
	<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
		<span>Rows per page</span>
		<select name="per_page" class="mt-1 block w-full rounded-md border-neutral-300 text-sm shadow-sm dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100">
			for _, option := range []int{10, 25, 50, 100} {
				<option value={ fmt.Sprintf("%d", option) } selected?={ selected == option }>{ fmt.Sprintf("%d", option) }</option>
			}
		</select>
	</label>
}
