package clientspartials

import (
	"fmt"
	"math/bits"
	"net/url"
	"sort"
	"time"

	"github.com/open-wander/wander/ui/templates/components"
)

// ClientDetail represents detailed information about a client node
type ClientDetail struct {
	ID                      string
	Name                    string
	Status                  string
	Datacenter              string
	Address                 string
	Version                 string
	Uptime                  string
	NodeClass               string
	Drain                   bool
	Draining                bool // True if currently draining
	Eligible                bool
	Resources               ClientResources
	Allocations             []AllocationSummary
	AllocationFilters       ClientAllocationFilters
	AllocationFilterOptions ClientAllocationFilterOptions
	AllocationsAvailable    bool
	AllocationError         string
	Attributes              map[string]string
	Meta                    map[string]string
	StaticMeta              map[string]string
	DynamicMeta             map[string]*string
	MetadataAvailable       bool
	MetadataError           string
	CanWriteNode            bool
	Events                  []ClientEvent
	Drivers                 []DriverInfo
	HostVolumes             []HostVolumeInfo
	ActiveTab               string
	Namespace               string
	Region                  string
	// Current resource statistics sample from the client, when available.
	Stats          *ClientStats
	StatsAvailable bool
	StatsError     string
}

// ClientEvent represents an event in the client's lifecycle
type ClientEvent struct {
	Time    time.Time
	Type    string
	Message string
}

// DriverInfo represents driver information on a client
type DriverInfo struct {
	Name              string
	Detected          bool
	Healthy           bool
	Version           string
	HealthDescription string
	Attributes        map[string]string
}

type HostVolumeInfo struct {
	Name     string
	Path     string
	ReadOnly bool
}

type ClientAllocationFilters struct {
	Status    string
	Namespace string
	Job       string
	TaskGroup string
}

type ClientAllocationFilterOptions struct {
	Statuses   []string
	Namespaces []string
	Jobs       []string
	TaskGroups []string
}

// ClientResources represents resource allocation and usage for a client
type ClientResources struct {
	CPUUsed   int
	CPUTotal  int
	MemUsed   int64
	MemTotal  int64
	DiskUsed  int64
	DiskTotal int64
}

// ClientStats represents real-time resource utilization stats from a client node
type ClientStats struct {
	// CPU utilization percentage (0-100) averaged across all cores
	CPUUtilization float64
	// Per-core CPU stats
	CPUCores []CPUCoreStat
	// Memory stats
	MemoryTotal     uint64
	MemoryUsed      uint64
	MemoryAvailable uint64
	// Disk stats
	DiskStats []DiskStat
	// Uptime in seconds
	Uptime    uint64
	HasCPU    bool
	HasMemory bool
	HasDisk   bool
}

// CPUCoreStat represents stats for a single CPU core
type CPUCoreStat struct {
	Core   string
	User   float64
	System float64
	Idle   float64
}

// DiskStat represents stats for a disk mount
type DiskStat struct {
	Device      string
	Mountpoint  string
	Size        uint64
	Used        uint64
	Available   uint64
	UsedPercent float64
}

// AllocationSummary represents a summary of an allocation running on this client
type AllocationSummary struct {
	ID            string
	JobID         string
	Namespace     string
	TaskGroup     string
	Status        string
	DesiredStatus string
	DetailURL     string
	JobURL        string
	CPUUsed       int
	MemUsed       int64
	DiskUsed      int64
}

// DetailContent renders the client detail page content (without layout)
templ DetailContent(client ClientDetail) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" x-data="{ drainModal: false, cancelDrainModal: false }">
		@ClientSubnav(client.ID, "overview")
		<!-- Client Header -->
		@components.Card(components.CardProps{
			Shadow: true,
			Border: false,
			Class:  "mb-6",
		}) {
			@components.CardBody() {
				<div class="flex items-start justify-between">
					<div class="flex-1">
						<div class="flex items-center space-x-4 mb-4">
							<h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">{ client.Name }</h1>
							@components.Badge(components.BadgeProps{
								Variant: statusToBadgeVariant(client.Status),
								Dot:     true,
								Size:    "md",
							}) {
								{ client.Status }
							}
							if client.Draining {
								@components.Badge(components.BadgeProps{
									Variant: "warning",
									Size:    "md",
								}) {
									draining
								}
							}
							if !client.Eligible {
								@components.Badge(components.BadgeProps{
									Variant: "neutral",
									Size:    "md",
								}) {
									ineligible
								}
							}
						</div>
						<div class="grid grid-cols-2 md:grid-cols-5 gap-4 text-sm">
							<div>
								<span class="text-neutral-600 dark:text-neutral-400">ID:</span>
								<span class="font-mono text-xs text-neutral-700 dark:text-neutral-300 ml-2" title={ client.ID }>{ truncateID(client.ID) }</span>
							</div>
							<div>
								<span class="text-neutral-600 dark:text-neutral-400">Datacenter:</span>
								<span class="font-medium text-neutral-900 dark:text-neutral-100 ml-2">{ client.Datacenter }</span>
							</div>
							<div>
								<span class="text-neutral-600 dark:text-neutral-400">Address:</span>
								<span class="font-medium text-neutral-900 dark:text-neutral-100 ml-2">{ client.Address }</span>
							</div>
							<div>
								<span class="text-neutral-600 dark:text-neutral-400">Version:</span>
								<span class="font-medium text-neutral-900 dark:text-neutral-100 ml-2">{ client.Version }</span>
							</div>
							<div>
								<span class="text-neutral-600 dark:text-neutral-400">Node Class:</span>
								if client.NodeClass != "" {
									<span class="font-medium text-neutral-900 dark:text-neutral-100 ml-2">{ client.NodeClass }</span>
								} else {
									<span class="text-neutral-400 dark:text-neutral-500 ml-2 italic">none</span>
								}
							</div>
						</div>
						<div class="mt-2 text-sm">
							<span class="text-neutral-600 dark:text-neutral-400">Uptime:</span>
							<span class="font-medium text-neutral-900 dark:text-neutral-100 ml-2">{ client.Uptime }</span>
						</div>
					</div>
					<!-- Drain Controls -->
					<div class="flex items-center space-x-2 ml-4">
						if client.Draining {
							@components.Button(components.ButtonProps{
								Variant:     "warning",
								Outline:     true,
								Size:        "sm",
								Icon:        "x-mark",
								AlpineClick: "cancelDrainModal = true",
							}, "Cancel Drain")
						} else if client.Status == "ready" {
							@components.Button(components.ButtonProps{
								Variant:     "warning",
								Size:        "sm",
								AlpineClick: "drainModal = true",
							}, "Drain Node")
						}
					</div>
				</div>
			}
		}
		<!-- Tabs Section -->
		@components.Card(components.CardProps{
			Shadow: true,
			Border: false,
		}) {
			@components.CardBody() {
				@components.Tabs(components.TabsProps{
					Tabs: []components.Tab{
						{
							ID:      "overview",
							Label:   "Overview",
							Icon:    "chart",
							Content: OverviewTab(client),
							Active:  client.ActiveTab == "overview",
						},
						{
							ID:      "allocations",
							Label:   fmt.Sprintf("Allocations (%d)", len(client.Allocations)),
							Icon:    "cube",
							Content: AllocationsTab(client),
							Active:  client.ActiveTab == "allocations",
						},
						{
							ID:      "events",
							Label:   fmt.Sprintf("Events (%d)", len(client.Events)),
							Icon:    "clock",
							Content: EventsTab(client),
							Active:  client.ActiveTab == "events",
						},
					},
					ActiveTab: client.ActiveTab,
					Mode:      "static",
					PanelID:   "client-detail-panel",
				})
			}
		}
		<!-- Drain Modals -->
		@DrainNodeModal(client)
		@CancelDrainModal(client)
	</div>
}

// OverviewTab renders the overview tab with resources, attributes, meta, and drivers
templ OverviewTab(client ClientDetail) {
	<div class="space-y-6 pt-4">
		<!-- Resource Usage Section -->
		<div>
			<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-4">Resource Usage</h3>
			if !client.AllocationsAvailable {
				<div class="rounded-lg border border-warning-200 bg-warning-50 p-4 text-sm text-warning-800 dark:border-warning-800 dark:bg-warning-900/20 dark:text-warning-200">Allocated resource totals are unavailable because the allocation read failed.</div>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<!-- CPU Usage -->
					<div class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-4">
						<div class="flex items-center justify-between text-sm mb-2">
							<span class="text-neutral-600 dark:text-neutral-400 font-medium">CPU</span>
							<span class="text-neutral-900 dark:text-neutral-100 font-semibold">
								{ fmt.Sprintf("%d / %d MHz allocated", client.Resources.CPUUsed, client.Resources.CPUTotal) }
							</span>
						</div>
						@resourceBar(client.Resources.CPUUsed, client.Resources.CPUTotal)
						<div class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">
							{ fmt.Sprintf("%d%% allocated", calculatePercentage(client.Resources.CPUUsed, client.Resources.CPUTotal)) }
						</div>
					</div>
					<!-- Memory Usage -->
					<div class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-4">
						<div class="flex items-center justify-between text-sm mb-2">
							<span class="text-neutral-600 dark:text-neutral-400 font-medium">Memory</span>
							<span class="text-neutral-900 dark:text-neutral-100 font-semibold">
								{ formatMemory(client.Resources.MemUsed) } / { formatMemory(client.Resources.MemTotal) }
							</span>
						</div>
						@memoryBar(client.Resources.MemUsed, client.Resources.MemTotal)
						<div class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">
							{ fmt.Sprintf("%d%% allocated", calculateMemoryPercentage(client.Resources.MemUsed, client.Resources.MemTotal)) }
						</div>
					</div>
					<!-- Disk Usage -->
					<div class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-4">
						<div class="flex items-center justify-between text-sm mb-2">
							<span class="text-neutral-600 dark:text-neutral-400 font-medium">Disk</span>
							<span class="text-neutral-900 dark:text-neutral-100 font-semibold">
								{ formatMemory(client.Resources.DiskUsed) } / { formatMemory(client.Resources.DiskTotal) }
							</span>
						</div>
						@memoryBar(client.Resources.DiskUsed, client.Resources.DiskTotal)
						<div class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">
							{ fmt.Sprintf("%d%% allocated", calculateMemoryPercentage(client.Resources.DiskUsed, client.Resources.DiskTotal)) }
						</div>
					</div>
				</div>
			}
		</div>
		<!-- Current Host Statistics Section -->
		<div class="border-t border-neutral-200 dark:border-neutral-700 pt-6">
			<div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
				<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">Current Host Statistics</h3>
				<span class="text-xs text-neutral-500 dark:text-neutral-400">Current client sample; historical samples are not provided by this API</span>
			</div>
			if !client.StatsAvailable {
				<div class="rounded-lg border border-warning-200 bg-warning-50 p-4 text-sm text-warning-800 dark:border-warning-800 dark:bg-warning-900/20 dark:text-warning-200">{ client.StatsError }</div>
			} else if !hasCurrentStats(client.Stats) {
				<div class="rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-50 p-4 text-sm text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">The client returned no current CPU, memory, or disk samples.</div>
			} else {
				if client.Stats.Uptime > 0 {
					<p class="mb-3 text-sm text-neutral-600 dark:text-neutral-400">Host uptime: <span class="font-medium text-neutral-900 dark:text-neutral-100">{ formatHostUptime(client.Stats.Uptime) }</span></p>
				}
				<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
					<!-- CPU Utilization -->
					<div class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-4">
						<div class="flex items-center justify-between text-sm mb-2">
							<span class="text-neutral-600 dark:text-neutral-400 font-medium">CPU Utilization</span>
							if client.Stats.HasCPU {
								<span class="text-neutral-900 dark:text-neutral-100 font-semibold">{ fmt.Sprintf("%.1f%%", client.Stats.CPUUtilization) }</span>
							}
						</div>
						if client.Stats.HasCPU {
							@utilizationBar(client.Stats.CPUUtilization)
							<div class="mt-3 text-xs text-neutral-600 dark:text-neutral-400">
								<details class="cursor-pointer">
									<summary class="hover:text-neutral-900 dark:hover:text-neutral-100">
										{ fmt.Sprintf("%d cores", len(client.Stats.CPUCores)) }
									</summary>
									<div class="mt-2 space-y-1 pl-2">
										for _, core := range client.Stats.CPUCores {
											<div class="flex justify-between">
												<span>{ core.Core }:</span>
												<span>{ fmt.Sprintf("%.1f%% (U:%.1f%% S:%.1f%%)", 100-core.Idle, core.User, core.System) }</span>
											</div>
										}
									</div>
								</details>
							</div>
						} else {
							<p class="text-sm text-neutral-500 dark:text-neutral-400">No CPU sample returned</p>
						}
					</div>
					<!-- Memory Usage -->
					<div class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-4">
						<div class="flex items-center justify-between text-sm mb-2">
							<span class="text-neutral-600 dark:text-neutral-400 font-medium">Memory Usage</span>
							if client.Stats.HasMemory {
								<span class="text-neutral-900 dark:text-neutral-100 font-semibold">{ formatBytes(client.Stats.MemoryUsed) } / { formatBytes(client.Stats.MemoryTotal) }</span>
							}
						</div>
						if client.Stats.HasMemory {
							@bytesBar(client.Stats.MemoryUsed, client.Stats.MemoryTotal)
							<div class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">{ fmt.Sprintf("%d%% used, %s available", calculateBytesPercentage(client.Stats.MemoryUsed, client.Stats.MemoryTotal), formatBytes(client.Stats.MemoryAvailable)) }</div>
						} else {
							<p class="text-sm text-neutral-500 dark:text-neutral-400">No memory sample returned</p>
						}
					</div>
					<!-- Disk Usage -->
					<div class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-4">
						<div class="flex items-center justify-between text-sm mb-2">
							<span class="text-neutral-600 dark:text-neutral-400 font-medium">Disk Usage</span>
						</div>
						if client.Stats.HasDisk {
							<div class="space-y-2">
								for _, disk := range client.Stats.DiskStats {
									<div class="text-xs">
										<div class="flex justify-between mb-1">
											<span class="text-neutral-600 dark:text-neutral-400 truncate" title={ disk.Mountpoint }>{ disk.Mountpoint }</span>
											<span class="text-neutral-900 dark:text-neutral-100 font-medium">{ fmt.Sprintf("%.1f%%", disk.UsedPercent) }</span>
										</div>
										@utilizationBar(disk.UsedPercent)
										<div class="text-neutral-500 dark:text-neutral-500 mt-1">
											{ formatBytes(disk.Used) } / { formatBytes(disk.Size) }
										</div>
									</div>
								}
							</div>
						} else {
							<div class="text-sm text-neutral-500 dark:text-neutral-400">No disk sample returned</div>
						}
					</div>
				</div>
			}
		</div>
		<!-- Drivers Section -->
		if len(client.Drivers) > 0 {
			<div class="border-t border-neutral-200 dark:border-neutral-700 pt-6">
				<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-4">Drivers</h3>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					for _, driver := range client.Drivers {
						<div class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-3">
							<div class="flex items-center justify-between">
								<div>
									<div class="font-medium text-neutral-900 dark:text-neutral-100 text-sm">{ driver.Name }</div>
									if driver.Version != "" {
										<div class="text-xs text-neutral-500 dark:text-neutral-400">v{ driver.Version }</div>
									}
								</div>
								<div class="flex items-center space-x-2">
									if driver.Detected {
										@components.Badge(components.BadgeProps{
											Variant: driverHealthVariant(driver.Healthy),
											Dot:     true,
											Size:    "sm",
										}) {
											if driver.Healthy {
												healthy
											} else {
												unhealthy
											}
										}
									} else {
										@components.Badge(components.BadgeProps{
											Variant: "neutral",
											Size:    "sm",
										}) {
											not detected
										}
									}
								</div>
							</div>
							if driver.HealthDescription != "" {
								<p class="mt-2 text-xs text-neutral-600 dark:text-neutral-400">{ driver.HealthDescription }</p>
							}
							if len(driver.Attributes) > 0 {
								<dl class="mt-3 space-y-1 border-t border-neutral-200 dark:border-neutral-700 pt-2">
									for _, key := range sortedKeys(driver.Attributes) {
										<div class="flex gap-2 text-xs"><dt class="min-w-0 flex-1 break-all font-medium text-neutral-600 dark:text-neutral-400">{ key }</dt><dd class="min-w-0 flex-1 break-all font-mono text-neutral-900 dark:text-neutral-100">{ driver.Attributes[key] }</dd></div>
									}
								</dl>
							}
						</div>
					}
				</div>
			</div>
		}
		<div class="border-t border-neutral-200 dark:border-neutral-700 pt-6">
			<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-4">Host Volumes</h3>
			if len(client.HostVolumes) == 0 {
				<p class="text-neutral-500 dark:text-neutral-400 text-sm">No host volumes configured</p>
			} else {
				<div class="overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-700">
					<table class="min-w-full divide-y divide-neutral-200 dark:divide-neutral-700 text-sm">
						<thead class="bg-neutral-50 dark:bg-neutral-800"><tr><th class="px-4 py-2 text-left">Name</th><th class="px-4 py-2 text-left">Path</th><th class="px-4 py-2 text-left">Access</th></tr></thead>
						<tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
							for _, volume := range client.HostVolumes {
								<tr>
									<td class="px-4 py-2 font-medium">{ volume.Name }</td>
									<td class="px-4 py-2 font-mono break-all">{ volume.Path }</td>
									<td class="px-4 py-2">
										if volume.ReadOnly {
											<span>Read only</span>
										} else {
											<span>Read/write</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
		<!-- Node Attributes Section -->
		<div class="border-t border-neutral-200 dark:border-neutral-700 pt-6">
			<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-4">Node Attributes</h3>
			if len(client.Attributes) == 0 {
				<p class="text-neutral-500 dark:text-neutral-400 text-sm">No attributes defined</p>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2">
					for _, key := range sortedKeys(client.Attributes) {
						<div class="flex items-start py-2 border-b border-neutral-100 dark:border-neutral-800">
							<span class="text-sm font-medium text-neutral-600 dark:text-neutral-400 w-1/2 break-all">{ key }</span>
							<span class="text-sm text-neutral-900 dark:text-neutral-100 w-1/2 font-mono break-all">{ client.Attributes[key] }</span>
						</div>
					}
				</div>
			}
		</div>
		<!-- Node Metadata Section -->
		<div class="border-t border-neutral-200 dark:border-neutral-700 pt-6">
			<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-4">Node Metadata</h3>
			if !client.MetadataAvailable {
				<div class="mb-4 rounded-lg border border-warning-200 bg-warning-50 p-4 text-sm text-warning-800 dark:border-warning-800 dark:bg-warning-900/20 dark:text-warning-200">{ client.MetadataError }</div>
				@metadataValues("Merged metadata", client.Meta)
			} else {
				<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
					@metadataValues("Static metadata", client.StaticMeta)
					@dynamicMetadataValues(client)
				</div>
				if client.CanWriteNode {
					<form class="mt-6 rounded-lg border border-neutral-200 dark:border-neutral-700 p-4" method="post" action={ scopedClientActionURL(client, "/metadata") }>
						<input type="hidden" name="operation" value="set"/>
						<h4 class="mb-3 text-sm font-semibold text-neutral-900 dark:text-neutral-100">Create or update dynamic metadata</h4>
						<div class="grid grid-cols-1 gap-3 sm:grid-cols-[1fr_1fr_auto]">
							<label class="text-sm text-neutral-700 dark:text-neutral-300">Key<input class="form-input mt-1 w-full" type="text" name="key" required placeholder="example.key"/></label>
							<label class="text-sm text-neutral-700 dark:text-neutral-300">Value<input class="form-input mt-1 w-full" type="text" name="value" placeholder="value"/></label>
							<button class="btn btn-primary btn-sm self-end" type="submit">Save metadata</button>
						</div>
						<p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">Keys must be valid dotted identifiers. Empty values are allowed.</p>
					</form>
				}
			}
		</div>
	</div>
}

templ metadataValues(title string, values map[string]string) {
	<div>
		<h4 class="mb-2 text-sm font-semibold text-neutral-700 dark:text-neutral-300">{ title }</h4>
		if len(values) == 0 {
			<p class="text-sm text-neutral-500 dark:text-neutral-400">None</p>
		} else {
			<dl class="divide-y divide-neutral-100 rounded-lg border border-neutral-200 dark:border-neutral-700 dark:divide-neutral-800">
				for _, key := range sortedKeys(values) {
					<div class="flex gap-3 px-3 py-2 text-sm"><dt class="min-w-0 flex-1 break-all font-medium text-neutral-600 dark:text-neutral-400">{ key }</dt><dd class="min-w-0 flex-1 break-all font-mono text-neutral-900 dark:text-neutral-100">{ values[key] }</dd></div>
				}
			</dl>
		}
	</div>
}

templ dynamicMetadataValues(client ClientDetail) {
	<div>
		<h4 class="mb-2 text-sm font-semibold text-neutral-700 dark:text-neutral-300">Dynamic metadata</h4>
		if len(client.DynamicMeta) == 0 {
			<p class="text-sm text-neutral-500 dark:text-neutral-400">None</p>
		} else {
			<div class="divide-y divide-neutral-100 rounded-lg border border-neutral-200 dark:border-neutral-700 dark:divide-neutral-800">
				for _, key := range sortedPointerKeys(client.DynamicMeta) {
					<div class="flex items-center gap-3 px-3 py-2 text-sm" data-meta-key={ key }>
						<div class="min-w-0 flex-1 break-all font-medium text-neutral-600 dark:text-neutral-400">{ key }</div>
						<div class="min-w-0 flex-1 break-all font-mono text-neutral-900 dark:text-neutral-100">
							if client.DynamicMeta[key] == nil {
								<span class="italic text-neutral-500 dark:text-neutral-400">static value masked</span>
							} else {
								{ *client.DynamicMeta[key] }
							}
						</div>
						if client.CanWriteNode {
							<form method="post" action={ scopedClientActionURL(client, "/metadata") }>
								<input type="hidden" name="operation" value="unset"/>
								<input type="hidden" name="key" value={ key }/>
								<button class="btn btn-secondary btn-xs" type="submit">Unset</button>
							</form>
						}
					</div>
				}
			</div>
		}
	</div>
}

// AllocationsTab renders the allocations tab with a table of allocations on this client
templ AllocationsTab(client ClientDetail) {
	<div class="pt-4">
		<form method="get" action={ clientDetailPath(client) } class="mb-4 rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-50 p-4 dark:bg-neutral-800">
			<input type="hidden" name="tab" value="allocations"/>
			if client.Namespace != "" {
				<input type="hidden" name="namespace" value={ client.Namespace }/>
			}
			if client.Region != "" {
				<input type="hidden" name="region" value={ client.Region }/>
			}
			<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
				@clientAllocationFilter("allocation_status", "Status", "All statuses", client.AllocationFilters.Status, client.AllocationFilterOptions.Statuses)
				@clientAllocationFilter("allocation_namespace", "Namespace", "All namespaces", client.AllocationFilters.Namespace, client.AllocationFilterOptions.Namespaces)
				@clientAllocationFilter("allocation_job", "Job", "All jobs", client.AllocationFilters.Job, client.AllocationFilterOptions.Jobs)
				@clientAllocationFilter("allocation_task_group", "Task group", "All task groups", client.AllocationFilters.TaskGroup, client.AllocationFilterOptions.TaskGroups)
			</div>
			<div class="mt-3 flex justify-end gap-3">
				if hasClientAllocationFilters(client.AllocationFilters) {
					<a class="px-3 py-2 text-sm text-neutral-600 dark:text-neutral-400" href={ templ.SafeURL(clientAllocationsClearURL(client)) }>Clear filters</a>
				}
				<button type="submit" class="rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white">Apply filters</button>
			</div>
		</form>
		if !client.AllocationsAvailable {
			<div class="rounded-lg border border-warning-200 bg-warning-50 p-6 text-sm text-warning-800 dark:border-warning-800 dark:bg-warning-900/20 dark:text-warning-200">{ client.AllocationError }</div>
		} else if len(client.Allocations) == 0 {
			<div class="text-center py-12 bg-neutral-50 dark:bg-neutral-800 rounded-lg">
				<svg class="mx-auto h-12 w-12 text-neutral-400 dark:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
				</svg>
				<h3 class="mt-2 text-sm font-medium text-neutral-900 dark:text-neutral-100">No allocations</h3>
				<p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">No allocations match the selected scope and filters.</p>
			</div>
		} else {
			<div class="overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-700">
				@components.Table(components.TableProps{
					Columns: []components.Column{
						{Key: "id", Label: "ID", Sortable: false, Align: "left", Width: "w-32"},
						{Key: "job", Label: "Job", Sortable: false, Align: "left", Width: "w-1/4"},
						{Key: "namespace", Label: "Namespace", Sortable: false, Align: "left"},
						{Key: "taskgroup", Label: "Task Group", Sortable: false, Align: "left", Width: "w-1/4"},
						{Key: "status", Label: "Status", Sortable: false, Align: "center", Width: "w-32"},
						{Key: "resources", Label: "Resources", Sortable: false, Align: "left"},
					},
					SortColumn: "",
					SortDir:    "",
					Striped:    true,
					Hover:      true,
					SortURL:    "",
				}) {
					@components.TableBody() {
						for _, alloc := range client.Allocations {
							@allocationRow(alloc)
						}
					}
				}
			</div>
		}
	</div>
}

// EventsTab renders the events tab with a timeline of client events
templ EventsTab(client ClientDetail) {
	<div class="pt-4">
		if len(client.Events) == 0 {
			<div class="text-center py-12 bg-neutral-50 dark:bg-neutral-800 rounded-lg">
				<svg class="mx-auto h-12 w-12 text-neutral-400 dark:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
				<h3 class="mt-2 text-sm font-medium text-neutral-900 dark:text-neutral-100">No events</h3>
				<p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">No events recorded for this client.</p>
			</div>
		} else {
			<div class="relative">
				<!-- Timeline line -->
				<div class="absolute left-4 top-0 bottom-0 w-0.5 bg-neutral-200 dark:bg-neutral-700"></div>
				<div class="space-y-4">
					for i, event := range client.Events {
						<div class="relative flex items-start pl-10">
							<!-- Timeline dot -->
							<div class={ eventDotClasses(event.Type, i == 0) }></div>
							<div class="flex-1 min-w-0 bg-neutral-50 dark:bg-neutral-800 rounded-lg p-4">
								<div class="flex items-center justify-between mb-1">
									<span class={ eventTypeTextClasses(event.Type) }>{ event.Type }</span>
									<span class="text-xs text-neutral-500 dark:text-neutral-400">{ event.Time.Format("Jan 2, 2006 15:04:05") }</span>
								</div>
								if event.Message != "" {
									<p class="text-sm text-neutral-600 dark:text-neutral-300">{ event.Message }</p>
								}
							</div>
						</div>
					}
				</div>
			</div>
		}
	</div>
}

// allocationRow renders a single allocation row in the table
templ allocationRow(alloc AllocationSummary) {
	<tr data-alloc-id={ alloc.ID } class="transition-colors duration-100 hover:bg-neutral-50 dark:hover:bg-neutral-800">
		@components.TableCell("left", "w-32") {
			<a
				href={ templ.SafeURL(alloc.DetailURL) }
				hx-get={ alloc.DetailURL }
				hx-target="#main-content"
				hx-push-url="true"
				class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 font-mono text-xs"
			>
				{ truncateID(alloc.ID) }
			</a>
		}
		@components.TableCell("left", "w-1/4") {
			<a
				href={ templ.SafeURL(alloc.JobURL) }
				hx-get={ alloc.JobURL }
				hx-target="#main-content"
				hx-push-url="true"
				class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 font-medium"
			>
				{ alloc.JobID }
			</a>
		}
		@components.TableCell("left", "") {
			{ alloc.Namespace }
		}
		@components.TableCell("left", "w-1/4") {
			<span class="text-neutral-700 dark:text-neutral-300">
				{ alloc.TaskGroup }
			</span>
		}
		@components.TableCell("center", "w-32") {
			@components.Badge(components.BadgeProps{
				Variant: allocationStatusVariant(alloc.Status),
				Dot:     true,
			}) {
				{ alloc.Status }
			}
		}
		@components.TableCell("left", "") {
			<div class="space-y-1">
				<div class="text-xs text-neutral-600 dark:text-neutral-400">
					CPU: <span class="font-medium text-neutral-700 dark:text-neutral-300">{ fmt.Sprintf("%d MHz", alloc.CPUUsed) }</span>
				</div>
				<div class="text-xs text-neutral-600 dark:text-neutral-400">
					Memory: <span class="font-medium text-neutral-700 dark:text-neutral-300">{ formatMemory(alloc.MemUsed) }</span>
				</div>
			</div>
		}
	</tr>
}

templ clientAllocationFilter(name, label, placeholder, selected string, options []string) {
	<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
		<span>{ label }</span>
		<select name={ name } class="mt-1 block w-full rounded-md border-neutral-300 dark:border-neutral-600 text-sm shadow-xs dark:bg-neutral-900 dark:text-neutral-100">
			<option value="">{ placeholder }</option>
			for _, option := range options {
				<option value={ option } selected?={ selected == option }>{ option }</option>
			}
		</select>
	</label>
}

func clientDetailPath(client ClientDetail) string {
	return "/ui/clients/" + url.PathEscape(client.ID)
}

func clientAllocationsClearURL(client ClientDetail) string {
	params := url.Values{"tab": []string{"allocations"}}
	if client.Namespace != "" {
		params.Set("namespace", client.Namespace)
	}
	if client.Region != "" {
		params.Set("region", client.Region)
	}
	return clientDetailPath(client) + "?" + params.Encode()
}

func scopedClientActionURL(client ClientDetail, suffix string) string {
	params := url.Values{}
	if client.Namespace != "" {
		params.Set("namespace", client.Namespace)
	}
	if client.Region != "" {
		params.Set("region", client.Region)
	}
	result := clientDetailPath(client) + suffix
	if encoded := params.Encode(); encoded != "" {
		return result + "?" + encoded
	}
	return result
}

func hasClientAllocationFilters(filters ClientAllocationFilters) bool {
	return filters.Status != "" || filters.Namespace != "" || filters.Job != "" || filters.TaskGroup != ""
}

// statusToBadgeVariant maps client status to badge variant
func statusToBadgeVariant(status string) string {
	switch status {
	case "ready":
		return "success"
	case "down":
		return "error"
	case "draining":
		return "warning"
	default:
		return "neutral"
	}
}

// allocationStatusVariant maps allocation status to badge variant
func allocationStatusVariant(status string) string {
	switch status {
	case "running":
		return "success"
	case "pending":
		return "warning"
	case "complete":
		return "info"
	case "failed":
		return "error"
	default:
		return "neutral"
	}
}

// resourceBar renders a progress bar for CPU usage
templ resourceBar(used int, total int) {
	<div class="w-full bg-neutral-200 dark:bg-neutral-700 rounded-full h-2">
		<div
			class={ "h-2 rounded-full transition-all duration-300", resourceBarColor(used, total) }
			style={ fmt.Sprintf("width: %d%%", calculatePercentage(used, total)) }
		></div>
	</div>
}

// memoryBar renders a progress bar for memory usage
templ memoryBar(used int64, total int64) {
	<div class="w-full bg-neutral-200 dark:bg-neutral-700 rounded-full h-2">
		<div
			class={ "h-2 rounded-full transition-all duration-300", memoryBarColor(used, total) }
			style={ fmt.Sprintf("width: %d%%", calculateMemoryPercentage(used, total)) }
		></div>
	</div>
}

// resourceBarColor returns the appropriate color class based on usage percentage
func resourceBarColor(used int, total int) string {
	if total == 0 {
		return "bg-neutral-400 dark:bg-neutral-500"
	}

	percentage := (used * 100) / total

	if percentage >= 90 {
		return "bg-red-500 dark:bg-red-600"
	} else if percentage >= 75 {
		return "bg-orange-500 dark:bg-orange-600"
	} else if percentage >= 50 {
		return "bg-yellow-500 dark:bg-yellow-600"
	}
	return "bg-green-500 dark:bg-green-600"
}

// memoryBarColor returns the appropriate color class based on memory usage percentage
func memoryBarColor(used int64, total int64) string {
	if total == 0 {
		return "bg-neutral-400 dark:bg-neutral-500"
	}

	percentage := (used * 100) / total

	if percentage >= 90 {
		return "bg-red-500 dark:bg-red-600"
	} else if percentage >= 75 {
		return "bg-orange-500 dark:bg-orange-600"
	} else if percentage >= 50 {
		return "bg-yellow-500 dark:bg-yellow-600"
	}
	return "bg-green-500 dark:bg-green-600"
}

// utilizationBar renders a progress bar for utilization percentage (0-100)
templ utilizationBar(percent float64) {
	<div class="w-full bg-neutral-200 dark:bg-neutral-700 rounded-full h-2">
		<div
			class={ "h-2 rounded-full transition-all duration-300", utilizationBarColor(percent) }
			style={ fmt.Sprintf("width: %.1f%%", percent) }
		></div>
	</div>
}

// bytesBar renders a progress bar for bytes usage
templ bytesBar(used uint64, total uint64) {
	<div class="w-full bg-neutral-200 dark:bg-neutral-700 rounded-full h-2">
		<div
			class={ "h-2 rounded-full transition-all duration-300", bytesBarColor(used, total) }
			style={ fmt.Sprintf("width: %d%%", calculateBytesPercentage(used, total)) }
		></div>
	</div>
}

// utilizationBarColor returns the appropriate color class based on utilization percentage
func utilizationBarColor(percent float64) string {
	if percent >= 90 {
		return "bg-red-500 dark:bg-red-600"
	} else if percent >= 75 {
		return "bg-orange-500 dark:bg-orange-600"
	} else if percent >= 50 {
		return "bg-yellow-500 dark:bg-yellow-600"
	}
	return "bg-green-500 dark:bg-green-600"
}

// bytesBarColor returns the appropriate color class based on bytes usage percentage
func bytesBarColor(used uint64, total uint64) string {
	if total == 0 {
		return "bg-neutral-400 dark:bg-neutral-500"
	}

	percentage := bytesPercentage(used, total)

	if percentage >= 90 {
		return "bg-red-500 dark:bg-red-600"
	} else if percentage >= 75 {
		return "bg-orange-500 dark:bg-orange-600"
	} else if percentage >= 50 {
		return "bg-yellow-500 dark:bg-yellow-600"
	}
	return "bg-green-500 dark:bg-green-600"
}

// calculateBytesPercentage calculates percentage of bytes used
func calculateBytesPercentage(used uint64, total uint64) uint64 {
	return bytesPercentage(used, total)
}

func bytesPercentage(used uint64, total uint64) uint64 {
	if total == 0 {
		return 0
	}
	if used >= total {
		return 100
	}
	high, low := bits.Mul64(used, 100)
	percentage, _ := bits.Div64(high, low, total)
	return percentage
}

// formatBytes formats a byte count into a human-readable string
func formatBytes(bytes uint64) string {
	const unit = 1024
	if bytes < unit {
		return fmt.Sprintf("%d B", bytes)
	}
	div, exp := uint64(unit), 0
	for n := bytes / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %ciB", float64(bytes)/float64(div), "KMGTPE"[exp])
}

// sortedKeys returns keys of a map in sorted order
func sortedKeys(m map[string]string) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

func sortedPointerKeys(m map[string]*string) []string {
	keys := make([]string, 0, len(m))
	for key := range m {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	return keys
}

// driverHealthVariant maps driver health to badge variant
func driverHealthVariant(healthy bool) string {
	if healthy {
		return "success"
	}
	return "error"
}

// eventDotClasses returns CSS classes for timeline event dots
func eventDotClasses(eventType string, isFirst bool) string {
	base := "absolute left-2 w-4 h-4 rounded-full border-2 border-white dark:border-neutral-900 -translate-x-1/2 "
	switch eventType {
	case "Node registered", "Node up":
		return base + "bg-green-500"
	case "Node down", "Node lost", "Node drain started":
		return base + "bg-red-500"
	case "Node drain complete", "Node eligibility changed":
		return base + "bg-yellow-500"
	default:
		if isFirst {
			return base + "bg-primary-500"
		}
		return base + "bg-neutral-300 dark:bg-neutral-600"
	}
}

// eventTypeTextClasses returns CSS classes for event type text
func eventTypeTextClasses(eventType string) string {
	base := "text-sm font-medium "
	switch eventType {
	case "Node registered", "Node up":
		return base + "text-green-600 dark:text-green-400"
	case "Node down", "Node lost", "Node drain started":
		return base + "text-red-600 dark:text-red-400"
	case "Node drain complete", "Node eligibility changed":
		return base + "text-yellow-600 dark:text-yellow-400"
	default:
		return base + "text-neutral-900 dark:text-neutral-100"
	}
}

func hasCurrentStats(stats *ClientStats) bool {
	return stats != nil && (stats.HasCPU || stats.HasMemory || stats.HasDisk)
}

func formatHostUptime(seconds uint64) string {
	days := seconds / (24 * 60 * 60)
	hours := (seconds / (60 * 60)) % 24
	minutes := (seconds / 60) % 60
	if days > 0 {
		return fmt.Sprintf("%dd %dh", days, hours)
	}
	if hours > 0 {
		return fmt.Sprintf("%dh %dm", hours, minutes)
	}
	return fmt.Sprintf("%dm", minutes)
}

// DrainNodeModal renders the modal for draining a node
templ DrainNodeModal(client ClientDetail) {
	<div x-data="drainModalBridge()">
		@components.Modal(components.ModalProps{
			ID:       "drain-node-modal",
			Title:    "Drain Node",
			Size:     "md",
			Closable: true,
		}) {
			@components.ModalBody() {
				<form id="drain-form" method="post" action={ scopedClientActionURL(client, "/drain") }>
					<div class="space-y-4">
						<div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4">
							<div class="flex">
								<svg class="h-5 w-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
								</svg>
								<div class="ml-3">
									<h3 class="text-sm font-medium text-yellow-800 dark:text-yellow-200">Warning</h3>
									<p class="mt-1 text-sm text-yellow-700 dark:text-yellow-300">
										Draining will migrate all allocations off this node. New allocations will not be scheduled on this node while draining.
									</p>
								</div>
							</div>
						</div>
						<p class="text-sm text-neutral-600 dark:text-neutral-400">
							Are you sure you want to drain node <strong class="text-neutral-900 dark:text-neutral-100">{ client.Name }</strong>?
						</p>
						<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300" for="drain-deadline-mode">Drain strategy</label>
						<select id="drain-deadline-mode" name="deadline_mode" class="form-select w-full">
							<option value="default">Default — force remaining allocations after 1 hour</option>
							<option value="custom">Custom deadline</option>
							<option value="none">No deadline — wait indefinitely</option>
							<option value="force">Force immediately</option>
						</select>
						@components.FormField(components.FormFieldProps{
							Label: "Custom deadline",
							ID:    "drain-deadline",
							Hint:  "Used only with Custom deadline; enter a positive duration such as 30m or 2h30m.",
						}) {
							@components.Input(components.InputProps{
								Type:        "text",
								ID:          "drain-deadline",
								Name:        "deadline",
								Placeholder: "e.g., 1h, 30m, 2h30m",
							})
						}
						@components.FormField(components.FormFieldProps{
							Label: "Operator message",
							ID:    "drain-message",
							Hint:  "Optional message stored with the drain operation.",
						}) {
							@components.Input(components.InputProps{Type: "text", ID: "drain-message", Name: "message", Placeholder: "Reason for draining this node"})
						}
						<div class="pt-2">
							@components.Checkbox(components.CheckboxProps{
								ID:    "ignore-system-jobs",
								Name:  "ignore_system",
								Value: "true",
								Label: "Ignore system jobs (system jobs will not be drained)",
							})
						</div>
					</div>
				</form>
			}
			@components.ModalFooter() {
				<button
					type="button"
					@click="close"
					class="btn btn-secondary btn-sm"
				>
					Cancel
				</button>
				<button
					type="submit"
					form="drain-form"
					@click="close"
					class="btn btn-warning btn-sm"
				>
					Start Drain
				</button>
			}
		}
	</div>
}

// CancelDrainModal renders the modal for canceling a drain operation
templ CancelDrainModal(client ClientDetail) {
	<div x-data="modalBridge('cancelDrainModal')">
		@components.Modal(components.ModalProps{
			ID:       "cancel-drain-modal",
			Title:    "Cancel Drain",
			Size:     "md",
			Closable: true,
		}) {
			@components.ModalBody() {
				<form id="cancel-drain-form" method="post" action={ scopedClientActionURL(client, "/drain/cancel") } class="space-y-4">
					<p class="text-sm text-neutral-600 dark:text-neutral-400">
						Are you sure you want to cancel the drain operation on node <strong class="text-neutral-900 dark:text-neutral-100">{ client.Name }</strong>?
					</p>
					<p class="text-sm text-neutral-500 dark:text-neutral-500">By default the node becomes eligible for new allocations again. Migrated allocations will not be returned.</p>
					@components.Checkbox(components.CheckboxProps{ID: "keep-ineligible", Name: "keep_ineligible", Value: "true", Label: "Keep the node ineligible after cancelling"})
					@components.FormField(components.FormFieldProps{Label: "Cancellation message", ID: "cancel-drain-message", Hint: "Optional message stored with the cancelled drain."}) {
						@components.Input(components.InputProps{Type: "text", ID: "cancel-drain-message", Name: "cancel_message", Placeholder: "Reason for cancelling the drain"})
					}
				</form>
			}
			@components.ModalFooter() {
				<button
					type="button"
					@click="close"
					class="btn btn-secondary btn-sm"
				>
					Keep Draining
				</button>
				<button
					type="submit"
					form="cancel-drain-form"
					@click="close"
					class="btn btn-warning btn-sm"
				>
					Cancel Drain
				</button>
			}
		}
	</div>
}
