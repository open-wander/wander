package clientspartials

import (
	"fmt"
	"net/url"
	"strconv"
)

type ClientMonitorProps struct {
	ClientID   string
	ClientName string
	Level      string
}

templ ClientSubnav(clientID, active string) {
	<nav class="mb-6 border-b border-neutral-200 dark:border-neutral-700" aria-label="Client sections">
		<div class="-mb-px flex gap-6">
			<a
				href={ templ.SafeURL("/ui/clients/" + url.PathEscape(clientID)) }
				class={ clientSubnavClass(active == "overview") }
				aria-current={ clientSubnavCurrent(active == "overview") }
			>Overview</a>
			<a
				href={ templ.SafeURL("/ui/clients/" + url.PathEscape(clientID) + "/monitor") }
				class={ clientSubnavClass(active == "monitor") }
				aria-current={ clientSubnavCurrent(active == "monitor") }
			>Monitor</a>
		</div>
	</nav>
}

templ ClientMonitorContent(props ClientMonitorProps) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		@ClientSubnav(props.ClientID, "monitor")
		<section
			x-data={ clientMonitorData(props) }
			x-init="connect()"
			x-on:beforeunload.window="disconnect()"
			class="overflow-hidden rounded-lg bg-white dark:bg-neutral-900 shadow"
			data-client-monitor
		>
			<header class="flex flex-col gap-4 border-b border-neutral-200 dark:border-neutral-700 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<h1 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">Agent Monitor</h1>
					<p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">Live logs from { props.ClientName }</p>
				</div>
				<div class="flex items-center gap-3">
					<label for="monitor-level" class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Level</label>
					<select
						id="monitor-level"
						x-model="level"
						x-on:change="changeLevel()"
						class="rounded-md border-neutral-300 bg-white text-sm text-neutral-900 shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100"
						data-monitor-level
					>
						<option value="error">Error</option>
						<option value="warn">Warn</option>
						<option value="info">Info</option>
						<option value="debug">Debug</option>
						<option value="trace">Trace</option>
					</select>
					<button
						type="button"
						x-on:click="toggle()"
						x-text="isStreaming ? 'Pause' : 'Resume'"
						class="rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm font-medium text-neutral-700 shadow-sm hover:bg-neutral-50 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700"
						data-monitor-toggle
					></button>
				</div>
			</header>
			<div class="flex items-center gap-2 px-6 py-3 text-xs text-neutral-500 dark:text-neutral-400">
				<span
					class="h-2 w-2 rounded-full"
					:class="{'bg-success-500': connectionState === 'connected', 'bg-warning-500': connectionState === 'connecting', 'bg-error-500': connectionState === 'error', 'bg-neutral-400': connectionState === 'paused' || connectionState === 'disconnected'}"
				></span>
				<span x-text="connectionState" class="capitalize" data-monitor-state></span>
				<span x-show="connectionError" x-text="connectionError" class="text-error-600 dark:text-error-400" data-monitor-error></span>
			</div>
			<pre
				x-ref="output"
				x-text="output"
				class="m-0 min-h-[20rem] max-h-[calc(100vh-22rem)] overflow-auto whitespace-pre-wrap break-words bg-neutral-950 p-5 font-mono text-sm leading-6 text-neutral-100"
				aria-live="polite"
				aria-label="Client agent log output"
				data-monitor-output
			></pre>
		</section>
	</div>
}

func clientMonitorData(props ClientMonitorProps) string {
	return fmt.Sprintf("clientAgentMonitor(%s, %s)", strconv.Quote(props.ClientID), strconv.Quote(props.Level))
}

func clientSubnavClass(active bool) string {
	base := "border-b-2 px-1 py-3 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-primary-500"
	if active {
		return base + " border-primary-500 text-primary-600 dark:text-primary-400"
	}
	return base + " border-transparent text-neutral-500 hover:border-neutral-300 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200"
}

func clientSubnavCurrent(active bool) string {
	if active {
		return "page"
	}
	return ""
}
