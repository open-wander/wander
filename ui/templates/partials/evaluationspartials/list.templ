package evaluationspartials

import (
	"fmt"
	"net/url"

	"github.com/open-wander/wander/ui/templates/components"
)

// EvaluationSummary represents a summary view of an evaluation.
type EvaluationSummary struct {
	ID          string
	ShortID     string
	JobID       string
	JobName     string
	Status      string
	Type        string
	TriggeredBy string
	Priority    int
	TimeAgo     string
	DetailURL   string
}

type PaginationMeta struct {
	Page    int
	PerPage int
	Total   int
}

type ListProps struct {
	Evaluations []EvaluationSummary
	Search      string
	Status      string
	Type        string
	Job         string
	SortColumn  string
	SortDir     string
	Namespace   string
	Region      string
	Pagination  PaginationMeta
}

// ListContent renders the evaluations list content for the full page.
templ ListContent(props ListProps) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="sm:flex sm:items-end sm:justify-between gap-4 mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">Evaluations</h1>
				<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">
					View recent Wander evaluations
				</p>
			</div>
			<form method="get" action="/ui/evaluations" hx-get="/ui/evaluations" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true" class="flex items-end gap-2">
				@evaluationListHiddenInputs(props)
				<label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
					<span>Rows per page</span>
					<select name="per_page" class="mt-1 block rounded-md border-neutral-300 dark:border-neutral-600 text-sm shadow-sm focus:border-primary-500 focus:ring-primary-500 dark:bg-neutral-800 dark:text-neutral-100">
						for _, option := range []int{10, 25, 50, 100} {
							<option value={ fmt.Sprintf("%d", option) } selected?={ props.Pagination.PerPage == option }>{ fmt.Sprintf("%d", option) }</option>
						}
					</select>
				</label>
				<button type="submit" class="inline-flex rounded-md bg-primary-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">Apply</button>
			</form>
		</div>
		<div id="evaluations-list-container" class="bg-white dark:bg-neutral-900 shadow rounded-lg overflow-hidden">
			<div class="p-4 space-y-3">
				if len(props.Evaluations) == 0 {
					<div class="text-center py-12">
						<svg
							class="mx-auto h-12 w-12 text-neutral-400"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
							></path>
						</svg>
						<h3 class="mt-2 text-sm font-medium text-neutral-900 dark:text-neutral-100">No evaluations</h3>
						<p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">No recent evaluations to display.</p>
					</div>
				} else {
					for _, eval := range props.Evaluations {
						@evaluationCard(eval)
					}
				}
			</div>
			@components.Pagination(components.PaginationProps{
				Page:     props.Pagination.Page,
				PerPage:  props.Pagination.PerPage,
				Total:    props.Pagination.Total,
				BaseURL:  evaluationListURL(props),
				HxTarget: "#main-content",
				HxSwap:   "innerHTML",
			})
		</div>
	</div>
}

templ evaluationListHiddenInputs(props ListProps) {
	if props.Search != "" {
		<input type="hidden" name="search" value={ props.Search }/>
	}
	if props.Status != "" {
		<input type="hidden" name="status" value={ props.Status }/>
	}
	if props.Type != "" {
		<input type="hidden" name="type" value={ props.Type }/>
	}
	if props.Job != "" {
		<input type="hidden" name="job" value={ props.Job }/>
	}
	if props.SortColumn != "" {
		<input type="hidden" name="sort" value={ props.SortColumn }/>
	}
	if props.SortDir != "" {
		<input type="hidden" name="dir" value={ props.SortDir }/>
	}
	if props.Namespace != "" {
		<input type="hidden" name="namespace" value={ props.Namespace }/>
	}
	if props.Region != "" {
		<input type="hidden" name="region" value={ props.Region }/>
	}
}

// List renders the evaluations list content for the panel (sidebar).
templ List(evalsList []EvaluationSummary) {
	<div class="p-4 space-y-3">
		if len(evalsList) == 0 {
			<div class="text-center py-12">
				<svg
					class="mx-auto h-12 w-12 text-neutral-400"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
					></path>
				</svg>
				<h3 class="mt-2 text-sm font-medium text-neutral-900 dark:text-neutral-100">No evaluations</h3>
				<p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">No recent evaluations to display.</p>
			</div>
		} else {
			for _, eval := range evalsList {
				@evaluationCard(eval)
			}
		}
	</div>
}

// evaluationCard renders a single evaluation card
templ evaluationCard(eval EvaluationSummary) {
	<a
		href={ templ.SafeURL(eval.DetailURL) }
		class="block bg-white dark:bg-neutral-900 rounded-lg border border-neutral-200 dark:border-neutral-700 p-4 hover:border-primary-500 hover:shadow-md transition-all duration-150 cursor-pointer"
	>
		<div class="flex items-start justify-between">
			<div class="flex-1 min-w-0">
				<!-- Job Name and Short ID -->
				<div class="flex items-center gap-2 mb-2">
					<h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 truncate">
						{ eval.JobName }
					</h3>
					<span class="text-xs font-mono text-neutral-500 dark:text-neutral-400">
						{ eval.ShortID }
					</span>
				</div>
				<!-- Status Badge -->
				<div class="flex items-center gap-2 mb-2">
					@components.Badge(components.BadgeProps{
						Variant: evalStatusVariant(eval.Status),
						Dot:     true,
						Size:    "sm",
					}) {
						{ eval.Status }
					}
					<span class="text-xs text-neutral-600 dark:text-neutral-400">
						{ eval.Type }
					</span>
				</div>
				<!-- Triggered By -->
				<div class="flex items-center gap-1 text-xs text-neutral-500 dark:text-neutral-400">
					<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
					</svg>
					<span>{ eval.TriggeredBy }</span>
				</div>
			</div>
			<!-- Time Ago -->
			<div class="flex-shrink-0 ml-4">
				<span class="text-xs text-neutral-500 dark:text-neutral-400 whitespace-nowrap">
					{ eval.TimeAgo }
				</span>
			</div>
		</div>
	</a>
}

func evaluationListURL(props ListProps) string {
	params := url.Values{}
	if props.Search != "" {
		params.Set("search", props.Search)
	}
	if props.Status != "" {
		params.Set("status", props.Status)
	}
	if props.Type != "" {
		params.Set("type", props.Type)
	}
	if props.Job != "" {
		params.Set("job", props.Job)
	}
	if props.SortColumn != "" {
		params.Set("sort", props.SortColumn)
	}
	if props.SortDir != "" {
		params.Set("dir", props.SortDir)
	}
	if props.Namespace != "" {
		params.Set("namespace", props.Namespace)
	}
	if props.Region != "" {
		params.Set("region", props.Region)
	}
	if encoded := params.Encode(); encoded != "" {
		return "/ui/evaluations?" + encoded
	}
	return "/ui/evaluations"
}

// evalStatusVariant maps evaluation status to badge variant
func evalStatusVariant(status string) string {
	switch status {
	case "complete":
		return "success"
	case "pending":
		return "warning"
	case "failed":
		return "error"
	case "blocked":
		return "neutral"
	case "canceled":
		return "neutral"
	default:
		return "neutral"
	}
}
