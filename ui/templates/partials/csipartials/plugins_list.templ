package csipartials

import (
	"fmt"
	"net/url"
	"github.com/open-wander/wander/ui/templates/components"
)

// PluginSummary represents a summary view of a CSI plugin for list display.
type PluginSummary struct {
	ID                  string
	Provider            string
	ControllerRequired  bool
	ControllersHealthy  int
	ControllersExpected int
	NodesHealthy        int
	NodesExpected       int
}

// PluginsListProps contains all props for the CSI plugins list view.
type PluginsListProps struct {
	Plugins    []PluginSummary
	Search     string
	SortColumn string
	SortDir    string
}

// PluginsListContent renders the CSI plugins table content for HTMX partial updates.
templ PluginsListContent(props PluginsListProps) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="sm:flex sm:items-center sm:justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">CSI Plugins</h1>
				<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">
					View and manage Container Storage Interface plugins
				</p>
			</div>
		</div>
		<!-- Search Bar -->
		<div class="mb-6">
			@components.SearchBar(components.SearchBarProps{
				Name:        "search",
				Placeholder: "Search by plugin ID or provider...",
				Value:       props.Search,
				SearchURL:   buildPluginsSearchURL(props.SortColumn, props.SortDir),
				ResultsID:   "plugins-table-container",
				Debounce:    300,
				MinChars:    0,
			})
		</div>
		<!-- Plugins Table Container -->
		<div id="plugins-table-container" class="bg-white dark:bg-neutral-900 shadow rounded-lg overflow-hidden">
			@PluginsTable(props)
		</div>
	</div>
}

// PluginsTable renders just the table (for HTMX updates).
templ PluginsTable(props PluginsListProps) {
	@components.Table(components.TableProps{
		Columns: []components.Column{
			{Key: "id", Label: "Plugin ID", Sortable: true, Align: "left", Width: "w-1/4"},
			{Key: "provider", Label: "Provider", Sortable: true, Align: "left", Width: "w-1/4"},
			{Key: "controllers", Label: "Controllers", Sortable: true, Align: "center", Width: "w-1/5"},
			{Key: "nodes", Label: "Nodes", Sortable: true, Align: "center", Width: "w-1/5"},
		},
		SortColumn: props.SortColumn,
		SortDir:    props.SortDir,
		Striped:    true,
		Hover:      true,
		SortURL:    buildPluginsBaseURL(props.Search),
	}) {
		@components.TableBody() {
			if len(props.Plugins) == 0 {
				@components.TableEmptyState("No plugins found", "Try adjusting your search query")
			} else {
				for _, plugin := range props.Plugins {
					@pluginRow(plugin)
				}
			}
		}
	}
}

// pluginRow renders a single plugin row in the table
templ pluginRow(plugin PluginSummary) {
	<tr
		class="transition-colors duration-100 hover:bg-neutral-50 dark:hover:bg-neutral-800 cursor-pointer"
		hx-get={ fmt.Sprintf("/ui/csi/volumes?plugin=%s", plugin.ID) }
		hx-target="#main-content"
		hx-swap="innerHTML"
		hx-push-url="true"
	>
		@components.TableCell("left", "w-1/4") {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/ui/csi/volumes?plugin=%s", plugin.ID)) }
				class="font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300"
				@click.stop
				hx-get={ fmt.Sprintf("/ui/csi/volumes?plugin=%s", plugin.ID) }
				hx-target="#main-content"
				hx-swap="innerHTML"
				hx-push-url="true"
			>
				{ plugin.ID }
			</a>
		}
		@components.TableCell("left", "w-1/4") {
			<span class="text-neutral-700 dark:text-neutral-300 text-sm font-mono">
				{ plugin.Provider }
			</span>
		}
		@components.TableCell("center", "w-1/5") {
			if plugin.ControllerRequired {
				@healthStatus(plugin.ControllersHealthy, plugin.ControllersExpected)
			} else {
				<span class="text-neutral-500 dark:text-neutral-400 text-sm italic">
					Not required
				</span>
			}
		}
		@components.TableCell("center", "w-1/5") {
			@healthStatus(plugin.NodesHealthy, plugin.NodesExpected)
		}
	</tr>
}

// healthStatus renders a health status indicator with count
templ healthStatus(healthy, expected int) {
	<div class="flex items-center justify-center gap-2">
		if healthy == expected {
			@components.Badge(components.BadgeProps{
				Variant: "success",
				Dot:     true,
				Size:    "sm",
			}) {
				{ fmt.Sprintf("%d / %d", healthy, expected) }
			}
		} else if healthy > 0 {
			@components.Badge(components.BadgeProps{
				Variant: "warning",
				Dot:     true,
				Size:    "sm",
			}) {
				{ fmt.Sprintf("%d / %d", healthy, expected) }
			}
		} else {
			@components.Badge(components.BadgeProps{
				Variant: "error",
				Dot:     true,
				Size:    "sm",
			}) {
				{ fmt.Sprintf("%d / %d", healthy, expected) }
			}
		}
	</div>
}

// buildPluginsBaseURL constructs the base URL for table sorting
func buildPluginsBaseURL(search string) string {
	params := url.Values{}
	if search != "" {
		params.Add("search", search)
	}
	if len(params) > 0 {
		return "/ui/csi/plugins?" + params.Encode()
	}
	return "/ui/csi/plugins"
}

// buildPluginsSearchURL constructs the URL for search with sort params
func buildPluginsSearchURL(sortColumn, sortDir string) string {
	baseURL := "/ui/csi/plugins?"
	params := url.Values{}

	if sortColumn != "" {
		params.Add("sort", sortColumn)
	}
	if sortDir != "" {
		params.Add("dir", sortDir)
	}

	if len(params) > 0 {
		return baseURL + params.Encode() + "&"
	}
	return baseURL
}
