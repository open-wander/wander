package partials

// TabsDemo_JobsTab renders the jobs tab content for the HTMX demo
templ TabsDemo_JobsTab() {
	<div class="p-6 bg-neutral-50 rounded-md">
		<h3 class="text-lg font-medium text-neutral-900 mb-4">Jobs (Lazy-Loaded via HTMX)</h3>
		<p class="text-neutral-600 mb-4">
			This content was fetched from the server when you clicked the tab.
			Notice the loading indicator that appeared while the content was being fetched.
		</p>
		<div class="bg-white rounded-md shadow overflow-hidden">
			<table class="min-w-full divide-y divide-neutral-200">
				<thead class="bg-neutral-50">
					<tr>
						<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Job Name</th>
						<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Status</th>
						<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Type</th>
						<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-neutral-500 uppercase tracking-wider">Running</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-neutral-200">
					<tr>
						<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-neutral-900">web-server</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm">
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
								Running
							</span>
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-neutral-500">service</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-neutral-500">3 / 3</td>
					</tr>
					<tr>
						<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-neutral-900">batch-processor</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm">
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
								Running
							</span>
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-neutral-500">batch</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-neutral-500">1 / 1</td>
					</tr>
					<tr>
						<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-neutral-900">data-sync</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm">
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
								Pending
							</span>
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-neutral-500">periodic</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-neutral-500">0 / 1</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
}

// TabsDemo_AllocationsTab renders the allocations tab content for the HTMX demo
templ TabsDemo_AllocationsTab() {
	<div class="p-6 bg-neutral-50 rounded-md">
		<h3 class="text-lg font-medium text-neutral-900 mb-4">Allocations (Lazy-Loaded via HTMX)</h3>
		<p class="text-neutral-600 mb-4">
			This is another lazy-loaded tab. The content was not present in the initial page load,
			reducing the initial payload size and improving performance.
		</p>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			<div class="bg-white rounded-md shadow-sm border border-neutral-200 p-4">
				<div class="flex items-center justify-between mb-2">
					<h4 class="text-sm font-medium text-neutral-900">web-server[0]</h4>
					<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
						running
					</span>
				</div>
				<dl class="text-xs text-neutral-500 space-y-1">
					<div class="flex justify-between">
						<dt>Client:</dt>
						<dd class="text-neutral-900">node-01</dd>
					</div>
					<div class="flex justify-between">
						<dt>CPU:</dt>
						<dd class="text-neutral-900">256 MHz</dd>
					</div>
					<div class="flex justify-between">
						<dt>Memory:</dt>
						<dd class="text-neutral-900">512 MB</dd>
					</div>
				</dl>
			</div>
			<div class="bg-white rounded-md shadow-sm border border-neutral-200 p-4">
				<div class="flex items-center justify-between mb-2">
					<h4 class="text-sm font-medium text-neutral-900">web-server[1]</h4>
					<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
						running
					</span>
				</div>
				<dl class="text-xs text-neutral-500 space-y-1">
					<div class="flex justify-between">
						<dt>Client:</dt>
						<dd class="text-neutral-900">node-02</dd>
					</div>
					<div class="flex justify-between">
						<dt>CPU:</dt>
						<dd class="text-neutral-900">256 MHz</dd>
					</div>
					<div class="flex justify-between">
						<dt>Memory:</dt>
						<dd class="text-neutral-900">512 MB</dd>
					</div>
				</dl>
			</div>
			<div class="bg-white rounded-md shadow-sm border border-neutral-200 p-4">
				<div class="flex items-center justify-between mb-2">
					<h4 class="text-sm font-medium text-neutral-900">web-server[2]</h4>
					<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
						running
					</span>
				</div>
				<dl class="text-xs text-neutral-500 space-y-1">
					<div class="flex justify-between">
						<dt>Client:</dt>
						<dd class="text-neutral-900">node-03</dd>
					</div>
					<div class="flex justify-between">
						<dt>CPU:</dt>
						<dd class="text-neutral-900">256 MHz</dd>
					</div>
					<div class="flex justify-between">
						<dt>Memory:</dt>
						<dd class="text-neutral-900">512 MB</dd>
					</div>
				</dl>
			</div>
		</div>
	</div>
}

// TabsDemo_HistoryTab renders the history tab content for the HTMX demo
templ TabsDemo_HistoryTab() {
	<div class="p-6 bg-neutral-50 rounded-md">
		<h3 class="text-lg font-medium text-neutral-900 mb-4">History (Lazy-Loaded via HTMX)</h3>
		<p class="text-neutral-600 mb-4">
			This demonstrates how lazy-loading can improve the user experience by only fetching
			data when it's actually needed.
		</p>
		<div class="flow-root">
			<ul role="list" class="-mb-8">
				<li>
					<div class="relative pb-8">
						<span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-neutral-200" aria-hidden="true"></span>
						<div class="relative flex space-x-3">
							<div>
								<span class="h-8 w-8 rounded-full bg-green-500 flex items-center justify-center ring-8 ring-white">
									<svg class="h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
									</svg>
								</span>
							</div>
							<div class="min-w-0 flex-1 pt-1.5 flex justify-between space-x-4">
								<div>
									<p class="text-sm text-neutral-900">Job <strong>web-server</strong> started successfully</p>
								</div>
								<div class="text-right text-sm whitespace-nowrap text-neutral-500">
									<time datetime="2026-01-25T14:32">2 hours ago</time>
								</div>
							</div>
						</div>
					</div>
				</li>
				<li>
					<div class="relative pb-8">
						<span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-neutral-200" aria-hidden="true"></span>
						<div class="relative flex space-x-3">
							<div>
								<span class="h-8 w-8 rounded-full bg-blue-500 flex items-center justify-center ring-8 ring-white">
									<svg class="h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
										<path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"></path>
										<path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"></path>
									</svg>
								</span>
							</div>
							<div class="min-w-0 flex-1 pt-1.5 flex justify-between space-x-4">
								<div>
									<p class="text-sm text-neutral-900">Evaluation <strong>eval-123</strong> created</p>
								</div>
								<div class="text-right text-sm whitespace-nowrap text-neutral-500">
									<time datetime="2026-01-25T14:28">2 hours ago</time>
								</div>
							</div>
						</div>
					</div>
				</li>
				<li>
					<div class="relative pb-8">
						<div class="relative flex space-x-3">
							<div>
								<span class="h-8 w-8 rounded-full bg-neutral-400 flex items-center justify-center ring-8 ring-white">
									<svg class="h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
									</svg>
								</span>
							</div>
							<div class="min-w-0 flex-1 pt-1.5 flex justify-between space-x-4">
								<div>
									<p class="text-sm text-neutral-900">Job <strong>web-server</strong> registered</p>
								</div>
								<div class="text-right text-sm whitespace-nowrap text-neutral-500">
									<time datetime="2026-01-25T14:25">3 hours ago</time>
								</div>
							</div>
						</div>
					</div>
				</li>
			</ul>
		</div>
	</div>
}
