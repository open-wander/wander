package serverspartials

import (
	"github.com/open-wander/wander/ui/templates/components"
)

// ServerSummary represents a summary view of a server for list display.
type ServerSummary struct {
	Name       string
	Address    string
	Port       string
	Status     string
	Leader     bool
	Datacenter string
	Version    string
}

type PaginationMeta struct {
	Page    int
	PerPage int
	Total   int
}

// ListContent renders the servers table content for HTMX partial updates.
templ ListContent(serversList []ServerSummary, sortColumn string, sortDir string, pagination PaginationMeta, listURL string) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="sm:flex sm:items-center sm:justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">Servers</h1>
				<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">
					View and manage Wander servers
				</p>
			</div>
		</div>
		<div class="bg-white dark:bg-neutral-900 shadow rounded-lg overflow-hidden">
			@components.Table(components.TableProps{
				Columns: []components.Column{
					{Key: "name", Label: "Name", Sortable: true, Align: "left"},
					{Key: "status", Label: "Status", Sortable: true, Align: "center", Width: "w-24"},
					{Key: "leader", Label: "Leader", Sortable: true, Align: "center", Width: "w-24"},
					{Key: "address", Label: "Address", Sortable: true, Align: "left"},
					{Key: "port", Label: "Port", Sortable: true, Align: "right", Width: "w-24"},
					{Key: "datacenter", Label: "Datacenter", Sortable: true, Align: "left", Width: "w-28"},
					{Key: "version", Label: "Version", Sortable: true, Align: "left", Width: "w-28"},
				},
				SortColumn: sortColumn,
				SortDir:    sortDir,
				Striped:    false,
				Hover:      true,
				SortURL:    listURL,
				HxTarget:   "#main-content",
			}) {
				@components.TableBody() {
					if len(serversList) == 0 {
						@components.TableEmptyState("No servers found", "There are no servers to display")
					} else {
						for _, server := range serversList {
							@serverRow(server)
						}
					}
				}
			}
			@components.Pagination(components.PaginationProps{
				Page: pagination.Page,
				PerPage: pagination.PerPage,
				Total: pagination.Total,
				BaseURL: serverPaginationURL(listURL, sortColumn, sortDir),
			})
		</div>
	</div>
}

// serverRow renders a single server row in the table with leader highlighting
templ serverRow(server ServerSummary) {
	<tr class={ serverRowClasses(server.Leader) } data-server-row>
		@components.TableCell("left", "") {
			<div class="flex items-center gap-2" data-server-name>
				<a
					href={ templ.URL("/ui/servers/" + server.Name) }
					hx-get={ "/ui/servers/" + server.Name }
					hx-target="#main-content"
					hx-swap="innerHTML"
					hx-push-url="true"
					class="font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 hover:underline"
				>
					{ server.Name }
				</a>
				if server.Leader {
					@components.Badge(components.BadgeProps{
						Variant: "primary",
						Size:    "sm",
						Pill:    true,
					}) {
						Leader
					}
				}
			</div>
		}
		@components.TableCell("center", "w-24") {
			@components.Badge(components.BadgeProps{
				Variant: statusVariant(server.Status),
				Dot:     true,
				Size:    "sm",
			}) {
				{ server.Status }
			}
		}
		@components.TableCell("center", "w-24") {
			@components.Badge(components.BadgeProps{Variant: leaderVariant(server.Leader), Size: "sm"}) {
				{ leaderLabel(server.Leader) }
			}
		}
		@components.TableCell("left", "") {
			<span class="text-neutral-700 dark:text-neutral-300 font-mono text-sm" data-server-address>{ server.Address }</span>
		}
		@components.TableCell("right", "w-24") {
			<span class="text-neutral-700 dark:text-neutral-300 font-mono text-sm" data-server-port>{ server.Port }</span>
		}
		@components.TableCell("left", "w-28") {
			<span class="text-neutral-700 dark:text-neutral-300">
				{ server.Datacenter }
			</span>
		}
		@components.TableCell("left", "w-28") {
			<span class="text-neutral-700 dark:text-neutral-300" data-server-version>{ server.Version }</span>
		}
	</tr>
}

func leaderLabel(leader bool) string {
	if leader { return "True" }
	return "False"
}

func leaderVariant(leader bool) string {
	if leader { return "success" }
	return "neutral"
}

func serverPaginationURL(listURL, sortColumn, sortDir string) string {
	return listURL + "&sort=" + sortColumn + "&dir=" + sortDir
}

// serverRowClasses returns CSS classes for the server row with leader highlighting
func serverRowClasses(isLeader bool) string {
	base := "transition-colors duration-100"
	if isLeader {
		return base + " bg-primary-50 dark:bg-primary-900/20 hover:bg-primary-100 dark:hover:bg-primary-900/30 border-l-4 border-primary-500"
	}
	return base + " hover:bg-neutral-50 dark:hover:bg-neutral-800"
}

// statusVariant maps server status to badge variant
func statusVariant(status string) string {
	switch status {
	case "alive":
		return "success"
	case "failed":
		return "error"
	case "left":
		return "neutral"
	default:
		return "neutral"
	}
}
