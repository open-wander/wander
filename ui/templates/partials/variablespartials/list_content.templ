package variablespartials

import (
	"fmt"
	"github.com/open-wander/wander/ui/templates/components"
	"net/url"
	"time"
)

// VariableSummary represents a summary view of a variable for list display.
type VariableSummary struct {
	Path        string
	Namespace   string
	CreateIndex uint64
	ModifyIndex uint64
	ItemCount   int
	Modified    time.Time
	JobID       string // Associated job ID if this variable is job-related
}

type VariablePathNode struct {
	Segment  string
	Path     string
	Variable *VariableSummary
	Children []VariablePathNode
}

type ListProps struct {
	Variables   []VariableSummary
	PathTree    []VariablePathNode
	View        string
	Namespace   string
	Region      string
	SortColumn  string
	SortDir     string
	SearchQuery string
	Pagination  PaginationMeta
}

// PaginationMeta holds pagination metadata for list views.
type PaginationMeta struct {
	Page       int // Current page (1-indexed)
	PerPage    int // Items per page
	Total      int // Total number of items
	TotalPages int // Total number of pages
}

// ListContent renders the variables table content for HTMX partial updates.
templ ListContent(props ListProps) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="sm:flex sm:items-center sm:justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">Variables</h1>
				<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">
					View and manage Wander variables
				</p>
			</div>
			<div class="mt-4 sm:mt-0">
				<a
					href={ templ.SafeURL(variableScopedURL("/ui/variables/new", props.Namespace, props.Region)) }
					class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-xs text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
				>
					<svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
					</svg>
					Create Variable
				</a>
			</div>
		</div>
		<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center">
			<div class="flex-1">
				@components.SearchBar(components.SearchBarProps{
					Name:        "search",
					Placeholder: "Search variables by path or namespace...",
					Value:       props.SearchQuery,
					SearchURL:   variableWorkspaceURL(props, props.View),
					ResultsID:   "variables-table-container",
					Debounce:    300,
					MinChars:    0,
				})
			</div>
			<nav class="inline-flex rounded-md shadow-xs" aria-label="Variable view">
				@variableViewLink(props, "list", "List")
				@variableViewLink(props, "tree", "Tree")
			</nav>
		</div>
		<!-- Variables Table Container -->
		<div id="variables-table-container" class="bg-white dark:bg-neutral-900 shadow-sm rounded-lg overflow-hidden">
			if props.View == "tree" {
				@variableTreeView(props)
			} else {
				@components.Table(components.TableProps{
					Columns: []components.Column{
						{Key: "path", Label: "Path", Sortable: true, Align: "left", Width: "w-2/5"},
						{Key: "namespace", Label: "Namespace", Sortable: true, Align: "left", Width: "w-32"},
						{Key: "items", Label: "Items", Sortable: true, Align: "center", Width: "w-24"},
						{Key: "job", Label: "Job", Sortable: false, Align: "left", Width: "w-32"},
						{Key: "modified", Label: "Last Modified", Sortable: true, Align: "right"},
					},
					SortColumn: props.SortColumn,
					SortDir:    props.SortDir,
					Striped:    true,
					Hover:      true,
					SortURL:    variableWorkspaceURL(props, "list"),
				}) {
					@components.TableBody() {
						if len(props.Variables) == 0 {
							@components.TableEmptyState("No variables found", "There are no variables to display")
						} else {
							for _, variable := range props.Variables {
								@variableRow(variable, props.Namespace, props.Region)
							}
						}
					}
				}
				<!-- Pagination -->
				@components.Pagination(components.PaginationProps{
					Page:     props.Pagination.Page,
					PerPage:  props.Pagination.PerPage,
					Total:    props.Pagination.Total,
					BaseURL:  buildVariablesURL(props),
					HxTarget: "#main-content",
					HxSwap:   "innerHTML",
				})
			}
		</div>
	</div>
}

// buildVariablesURL constructs the base URL for pagination with sort and search params
func buildVariablesURL(props ListProps) string {
	baseURL := "/ui/variables?"
	params := url.Values{}

	if props.SortColumn != "" {
		params.Add("sort", props.SortColumn)
	}
	if props.SortDir != "" {
		params.Add("dir", props.SortDir)
	}
	if props.SearchQuery != "" {
		params.Add("search", props.SearchQuery)
	}
	addVariableScope(params, props.Namespace, props.Region)

	if len(params) > 0 {
		return baseURL + params.Encode() + "&"
	}
	return baseURL
}

func variableWorkspaceURL(props ListProps, view string) string {
	params := url.Values{}
	addVariableScope(params, props.Namespace, props.Region)
	if view == "tree" {
		params.Set("view", view)
	}
	if props.SearchQuery != "" {
		params.Set("search", props.SearchQuery)
	}
	if encoded := params.Encode(); encoded != "" {
		return "/ui/variables?" + encoded
	}
	return "/ui/variables"
}

func variableScopedURL(path, namespace, region string) string {
	params := url.Values{}
	addVariableScope(params, namespace, region)
	if encoded := params.Encode(); encoded != "" {
		return path + "?" + encoded
	}
	return path
}

func addVariableScope(params url.Values, namespace, region string) {
	if namespace != "" {
		params.Set("namespace", namespace)
	}
	if region != "" {
		params.Set("region", region)
	}
}

templ variableViewLink(props ListProps, view string, label string) {
	<a
		href={ templ.SafeURL(variableWorkspaceURL(props, view)) }
		class={ variableViewLinkClasses(props.View == view) }
		aria-current={ variableViewCurrent(props.View == view) }
		hx-get={ variableWorkspaceURL(props, view) }
		hx-target="#main-content"
		hx-swap="innerHTML"
		hx-push-url="true"
	>
		{ label }
	</a>
}

func variableViewLinkClasses(active bool) string {
	base := "inline-flex items-center border px-4 py-2 text-sm font-medium first:rounded-l-md last:rounded-r-md focus:z-10 focus:outline-hidden focus:ring-2 focus:ring-primary-500"
	if active {
		return base + " border-primary-600 bg-primary-600 text-white"
	}
	return base + " border-neutral-300 bg-white text-neutral-700 hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:bg-neutral-800"
}

func variableViewCurrent(active bool) string {
	if active {
		return "page"
	}
	return "false"
}

templ variableTreeView(props ListProps) {
	<div class="p-4 sm:p-6" data-variable-tree>
		if len(props.PathTree) == 0 {
			<div class="py-10 text-center text-sm text-neutral-500 dark:text-neutral-400">
				No variables found
			</div>
		} else {
			<ul class="space-y-2" aria-label="Variable paths">
				@variableTreeNodes(props.PathTree, props.Namespace, props.Region)
			</ul>
		}
	</div>
}

templ variableTreeNodes(nodes []VariablePathNode, namespace string, region string) {
	for _, node := range nodes {
		<li data-variable-tree-path={ node.Path }>
			if len(node.Children) > 0 {
				<details open class="group">
					<summary class="cursor-pointer rounded-sm px-2 py-1 font-medium text-neutral-800 hover:bg-neutral-50 dark:text-neutral-200 dark:hover:bg-neutral-800">
						{ node.Segment }
					</summary>
					<div class="ml-4 border-l border-neutral-200 pl-3 dark:border-neutral-700">
						if node.Variable != nil {
							@variableTreeRecord(*node.Variable, namespace, region, "View "+node.Path)
						}
						<ul class="mt-1 space-y-1">
							@variableTreeNodes(node.Children, namespace, region)
						</ul>
					</div>
				</details>
			} else if node.Variable != nil {
				@variableTreeRecord(*node.Variable, namespace, region, node.Segment)
			}
		</li>
	}
}

templ variableTreeRecord(variable VariableSummary, namespace string, region string, label string) {
	<a
		href={ templ.SafeURL(variableScopedURL("/ui/variables/"+url.PathEscape(variable.Path), namespace, region)) }
		class="flex items-center justify-between gap-3 rounded-sm px-2 py-2 text-sm text-primary-700 hover:bg-primary-50 hover:text-primary-800 dark:text-primary-400 dark:hover:bg-neutral-800"
		hx-get={ variableScopedURL("/ui/variables/"+url.PathEscape(variable.Path), namespace, region) }
		hx-target="#main-content"
		hx-swap="innerHTML"
		hx-push-url="true"
	>
		<span>{ label }</span>
		<span class="text-xs text-neutral-500 dark:text-neutral-400">{ variable.Namespace }</span>
	</a>
}

// variableRow renders a single variable row in the table
templ variableRow(variable VariableSummary, namespace string, region string) {
	<tr
		class="transition-colors duration-100 hover:bg-neutral-50 dark:hover:bg-neutral-800 cursor-pointer"
		hx-get={ variableScopedURL(fmt.Sprintf("/ui/variables/%s", url.PathEscape(variable.Path)), namespace, region) }
		hx-target="#main-content"
		hx-swap="innerHTML"
		hx-push-url="true"
	>
		@components.TableCell("left", "w-2/5") {
			<div class="font-medium text-neutral-900 dark:text-neutral-100">
				{ variable.Path }
			</div>
			<div class="text-xs text-neutral-500 dark:text-neutral-400">
				Create: { fmt.Sprintf("%d", variable.CreateIndex) } | Modify: { fmt.Sprintf("%d", variable.ModifyIndex) }
			</div>
		}
		@components.TableCell("left", "w-32") {
			@components.Badge(components.BadgeProps{
				Variant: namespaceVariant(variable.Namespace),
				Size:    "sm",
			}) {
				{ variable.Namespace }
			}
		}
		@components.TableCell("center", "w-24") {
			<span class="text-neutral-700 dark:text-neutral-300">
				{ fmt.Sprintf("%d", variable.ItemCount) }
			</span>
		}
		@components.TableCell("left", "w-32") {
			if variable.JobID != "" {
				<a
					href={ templ.SafeURL(variableScopedURL("/ui/jobs/"+url.PathEscape(variable.JobID), namespace, region)) }
					class="inline-flex items-center text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
					hx-get={ variableScopedURL("/ui/jobs/"+url.PathEscape(variable.JobID), namespace, region) }
					hx-target="#main-content"
					hx-swap="innerHTML"
					hx-push-url="true"
					@click.stop
				>
					<svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
					</svg>
					{ variable.JobID }
				</a>
			} else {
				<span class="text-neutral-400 dark:text-neutral-600">-</span>
			}
		}
		@components.TableCell("right", "") {
			<span class="text-neutral-600 dark:text-neutral-400">
				{ formatTimeAgo(variable.Modified) }
			</span>
		}
	</tr>
}

// namespaceVariant maps namespace to badge variant
func namespaceVariant(namespace string) string {
	switch namespace {
	case "default":
		return "neutral"
	case "production":
		return "danger"
	case "staging":
		return "warning"
	default:
		return "primary"
	}
}

// formatTimeAgo formats a time.Time as a relative time string
func formatTimeAgo(t time.Time) string {
	duration := time.Since(t)

	if duration < time.Minute {
		return "just now"
	} else if duration < time.Hour {
		minutes := int(duration.Minutes())
		if minutes == 1 {
			return "1 minute ago"
		}
		return fmt.Sprintf("%d minutes ago", minutes)
	} else if duration < 24*time.Hour {
		hours := int(duration.Hours())
		if hours == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", hours)
	} else {
		days := int(duration.Hours() / 24)
		if days == 1 {
			return "1 day ago"
		}
		return fmt.Sprintf("%d days ago", days)
	}
}
