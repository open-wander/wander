package accesscontrolpartials

import "fmt"

type Counts struct {
	Policies int
	Tokens   int
	Roles    int
}

templ Overview(counts Counts) {
	<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
		<div class="mb-8">
			<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">Access Control</h1>
			<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">Manage policies, tokens, and roles for this Wander cluster.</p>
		</div>
		<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
			@resourceCard("Policies", "Define permissions for Wander resources.", counts.Policies, "/ui/access-control/policies", "/ui/access-control/policies/new", "New Policy")
			@resourceCard("Tokens", "Create credentials and assign policies or roles.", counts.Tokens, "/ui/access-control/tokens", "/ui/access-control/tokens/new", "New Token")
			@resourceCard("Roles", "Group policies into reusable token roles.", counts.Roles, "/ui/access-control/roles", "/ui/access-control/roles/new", "New Role")
		</div>
	</div>
}

templ resourceCard(title, description string, count int, path, createPath, createLabel string) {
	<section class="rounded-lg border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-700 dark:bg-neutral-900">
		<div class="flex items-start justify-between gap-4">
			<div>
				<h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">{ title }</h2>
				<p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{ description }</p>
			</div>
			<span class="rounded-full bg-primary-50 px-3 py-1 text-sm font-semibold text-primary-700">{ fmt.Sprintf("%d", count) }</span>
		</div>
		<div class="mt-6 flex items-center gap-3">
			<a href={ templ.SafeURL(path) } hx-get={ path } hx-target="#main-content" hx-push-url="true" class="text-sm font-medium text-primary-600 hover:text-primary-800">View { title }</a>
			<a href={ templ.SafeURL(createPath) } hx-get={ createPath } hx-target="#main-content" hx-push-url="true" class="rounded-md bg-primary-600 px-3 py-2 text-sm font-medium text-white hover:bg-primary-700">{ createLabel }</a>
		</div>
	</section>
}
