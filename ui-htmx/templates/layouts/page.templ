package layouts

import "github.com/open-wander/wander/ui-htmx/templates/components"

// PageLayoutProps contains parameters for the page wrapper layout
type PageLayoutProps struct {
	Title               string
	Description         string
	CurrentPath         string // Current page path for active navigation highlighting
	Breadcrumbs         []components.Breadcrumb
	User                *components.UserInfo       // Optional user information
	ExpandedSections    []string                   // Sidebar sections to expand by default
	CurrentNamespace    string                     // Current selected namespace
	AvailableNamespaces []components.NamespaceInfo // List of available namespaces
}

// PageLayout provides the full page structure with header, sidebar, and main content area.
// This wraps BaseLayout and adds the application shell using component composition.
templ PageLayout(props PageLayoutProps, content templ.Component) {
	@BaseLayout(BaseLayoutProps{
		Title:       props.Title,
		Description: props.Description,
	}, pageContent(props, content))
}

// pageContent is the inner content for PageLayout that gets passed to BaseLayout
templ pageContent(props PageLayoutProps, content templ.Component) {
	<div class="flex h-full">
		<!-- Sidebar Component -->
		@components.Sidebar(components.SidebarProps{
			CurrentPath:      props.CurrentPath,
			ExpandedSections: props.ExpandedSections,
		})
		<!-- Main Content Area -->
		<div class="flex flex-col flex-1 overflow-hidden">
			<!-- Header Component -->
			@components.Header(components.HeaderProps{
				CurrentPath:         props.CurrentPath,
				User:                props.User,
				Breadcrumbs:         props.Breadcrumbs,
				CurrentNamespace:    props.CurrentNamespace,
				AvailableNamespaces: props.AvailableNamespaces,
			})
			<!-- Main Content Component -->
			@components.Main(components.MainProps{}, content)
		</div>
	</div>
}
