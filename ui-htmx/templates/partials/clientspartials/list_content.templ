package clientspartials

import (
	"fmt"
	"github.com/open-wander/wander/ui-htmx/templates/components"
)

// ClientSummary represents a summary view of a client for list display.
type ClientSummary struct {
	ID          string
	Name        string
	Status      string
	Datacenter  string
	Allocations int
	CPUUsed     int
	CPUTotal    int
	MemUsed     int64
	MemTotal    int64
}

// ListContent renders the clients table content for HTMX partial updates.
templ ListContent(clientsList []ClientSummary) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="sm:flex sm:items-center sm:justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">Clients</h1>
				<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">
					View and manage Nomad client nodes
				</p>
			</div>
		</div>
		<div class="bg-white dark:bg-neutral-900 shadow rounded-lg overflow-hidden">
			@components.Table(components.TableProps{
				Columns: []components.Column{
					{Key: "name", Label: "Name", Sortable: false, Align: "left", Width: "w-1/4"},
					{Key: "status", Label: "Status", Sortable: false, Align: "center", Width: "w-32"},
					{Key: "datacenter", Label: "Datacenter", Sortable: false, Align: "left", Width: "w-32"},
					{Key: "allocations", Label: "Allocations", Sortable: false, Align: "center", Width: "w-32"},
					{Key: "resources", Label: "Resources", Sortable: false, Align: "left"},
				},
				SortColumn: "",
				SortDir:    "",
				Striped:    true,
				Hover:      true,
				SortURL:    "",
			}) {
				@components.TableBody() {
					if len(clientsList) == 0 {
						@components.TableEmptyState("No clients found", "There are no client nodes to display")
					} else {
						for _, client := range clientsList {
							@clientRow(client)
						}
					}
				}
			}
		</div>
	</div>
}

// clientRow renders a single client row in the table
templ clientRow(client ClientSummary) {
	<tr
		class="transition-colors duration-100 hover:bg-neutral-50 dark:hover:bg-neutral-800"
	>
		@components.TableCell("left", "w-1/4") {
			<div class="font-medium text-neutral-900 dark:text-neutral-100">
				{ client.Name }
			</div>
			<div class="text-xs text-neutral-500 dark:text-neutral-400 font-mono">
				{ truncateID(client.ID) }
			</div>
		}
		@components.TableCell("center", "w-32") {
			@components.Badge(components.BadgeProps{
				Variant: statusVariant(client.Status),
				Dot:     true,
			}) {
				{ client.Status }
			}
		}
		@components.TableCell("left", "w-32") {
			<span class="text-neutral-700 dark:text-neutral-300">
				{ client.Datacenter }
			</span>
		}
		@components.TableCell("center", "w-32") {
			<span class="text-neutral-700 dark:text-neutral-300">
				{ fmt.Sprintf("%d", client.Allocations) }
			</span>
		}
		@components.TableCell("left", "") {
			<div class="space-y-2">
				<div>
					<div class="flex items-center justify-between text-xs mb-1">
						<span class="text-neutral-600 dark:text-neutral-400">CPU</span>
						<span class="text-neutral-700 dark:text-neutral-300 font-medium">
							{ fmt.Sprintf("%d / %d MHz", client.CPUUsed, client.CPUTotal) }
						</span>
					</div>
					@resourceBar(client.CPUUsed, client.CPUTotal)
				</div>
				<div>
					<div class="flex items-center justify-between text-xs mb-1">
						<span class="text-neutral-600 dark:text-neutral-400">Memory</span>
						<span class="text-neutral-700 dark:text-neutral-300 font-medium">
							{ formatMemory(client.MemUsed) } / { formatMemory(client.MemTotal) }
						</span>
					</div>
					@memoryBar(client.MemUsed, client.MemTotal)
				</div>
			</div>
		}
	</tr>
}

// resourceBar renders a progress bar for CPU usage
templ resourceBar(used int, total int) {
	<div class="w-full bg-neutral-200 dark:bg-neutral-700 rounded-full h-2">
		<div
			class={ "h-2 rounded-full transition-all duration-300", resourceBarColor(used, total) }
			style={ fmt.Sprintf("width: %d%%", calculatePercentage(used, total)) }
		></div>
	</div>
}

// memoryBar renders a progress bar for memory usage
templ memoryBar(used int64, total int64) {
	<div class="w-full bg-neutral-200 dark:bg-neutral-700 rounded-full h-2">
		<div
			class={ "h-2 rounded-full transition-all duration-300", memoryBarColor(used, total) }
			style={ fmt.Sprintf("width: %d%%", calculateMemoryPercentage(used, total)) }
		></div>
	</div>
}

// statusVariant maps client status to badge variant
func statusVariant(status string) string {
	switch status {
	case "ready":
		return "success"
	case "down":
		return "error"
	case "draining":
		return "warning"
	default:
		return "neutral"
	}
}

// resourceBarColor returns the appropriate color class based on usage percentage
func resourceBarColor(used int, total int) string {
	if total == 0 {
		return "bg-neutral-400 dark:bg-neutral-500"
	}

	percentage := (used * 100) / total

	if percentage >= 90 {
		return "bg-red-500 dark:bg-red-600"
	} else if percentage >= 75 {
		return "bg-orange-500 dark:bg-orange-600"
	} else if percentage >= 50 {
		return "bg-yellow-500 dark:bg-yellow-600"
	}
	return "bg-green-500 dark:bg-green-600"
}

// memoryBarColor returns the appropriate color class based on memory usage percentage
func memoryBarColor(used int64, total int64) string {
	if total == 0 {
		return "bg-neutral-400 dark:bg-neutral-500"
	}

	percentage := (used * 100) / total

	if percentage >= 90 {
		return "bg-red-500 dark:bg-red-600"
	} else if percentage >= 75 {
		return "bg-orange-500 dark:bg-orange-600"
	} else if percentage >= 50 {
		return "bg-yellow-500 dark:bg-yellow-600"
	}
	return "bg-green-500 dark:bg-green-600"
}

// calculatePercentage calculates the usage percentage for CPU
func calculatePercentage(used int, total int) int {
	if total == 0 {
		return 0
	}
	return (used * 100) / total
}

// calculateMemoryPercentage calculates the usage percentage for memory
func calculateMemoryPercentage(used int64, total int64) int {
	if total == 0 {
		return 0
	}
	return int((used * 100) / total)
}

// formatMemory formats bytes into human-readable format
func formatMemory(bytes int64) string {
	const (
		KB = 1024
		MB = KB * 1024
		GB = MB * 1024
		TB = GB * 1024
	)

	switch {
	case bytes >= TB:
		return fmt.Sprintf("%.1f TB", float64(bytes)/float64(TB))
	case bytes >= GB:
		return fmt.Sprintf("%.1f GB", float64(bytes)/float64(GB))
	case bytes >= MB:
		return fmt.Sprintf("%.1f MB", float64(bytes)/float64(MB))
	case bytes >= KB:
		return fmt.Sprintf("%.1f KB", float64(bytes)/float64(KB))
	default:
		return fmt.Sprintf("%d B", bytes)
	}
}

// truncateID truncates a client ID to show first 8 characters
func truncateID(id string) string {
	if len(id) <= 8 {
		return id
	}
	return id[:8]
}
