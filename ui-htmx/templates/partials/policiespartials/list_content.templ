package policiespartials

import (
	"time"
	"fmt"
	"net/url"
	"github.com/open-wander/wander/ui-htmx/templates/components"
)

// PolicySummary represents a summary view of an ACL policy for list display.
type PolicySummary struct {
	Name        string
	Description string
	CreateIndex uint64
	ModifyIndex uint64
	CreatedAt   time.Time
	ModifiedAt  time.Time
}

// ListContent renders the policies table content for HTMX partial updates.
templ ListContent(policiesList []PolicySummary, sortColumn string, sortDir string, searchQuery string) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="sm:flex sm:items-center sm:justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">ACL Policies</h1>
				<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">
					Manage access control policies for Nomad resources
				</p>
			</div>
			<div class="mt-4 sm:mt-0">
				<a href="/ui/policies/new" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
					<svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
					</svg>
					Create Policy
				</a>
			</div>
		</div>
		<!-- Search Bar -->
		<div class="mb-6">
			@components.SearchBar(components.SearchBarProps{
				Name:        "search",
				Placeholder: "Search policies by name or description...",
				Value:       searchQuery,
				SearchURL:   "/ui/policies",
				ResultsID:   "policies-table-container",
				Debounce:    300,
				MinChars:    0,
			})
		</div>
		<!-- Policies Table Container -->
		<div id="policies-table-container" class="bg-white dark:bg-neutral-900 shadow rounded-lg overflow-hidden">
			@components.Table(components.TableProps{
				Columns: []components.Column{
					{Key: "name", Label: "Name", Sortable: true, Align: "left", Width: "w-1/4"},
					{Key: "description", Label: "Description", Sortable: true, Align: "left"},
					{Key: "modified", Label: "Last Modified", Sortable: true, Align: "right", Width: "w-48"},
				},
				SortColumn: sortColumn,
				SortDir:    sortDir,
				Striped:    true,
				Hover:      true,
				SortURL:    "/ui/policies",
			}) {
				@components.TableBody() {
					if len(policiesList) == 0 {
						@components.TableEmptyState("No policies found", "There are no ACL policies to display")
					} else {
						for _, policy := range policiesList {
							@policyRow(policy)
						}
					}
				}
			}
		</div>
	</div>
}

// buildPoliciesURL constructs the base URL with sort and search params
func buildPoliciesURL(sortColumn, sortDir, searchQuery string) string {
	baseURL := "/ui/policies?"
	params := url.Values{}

	if sortColumn != "" {
		params.Add("sort", sortColumn)
	}
	if sortDir != "" {
		params.Add("dir", sortDir)
	}
	if searchQuery != "" {
		params.Add("search", searchQuery)
	}

	if len(params) > 0 {
		return baseURL + params.Encode() + "&"
	}
	return baseURL
}

// policyRow renders a single policy row in the table
templ policyRow(policy PolicySummary) {
	<tr
		class="transition-colors duration-100 hover:bg-neutral-50 dark:hover:bg-neutral-800 cursor-pointer"
		hx-get={ fmt.Sprintf("/ui/policies/%s", policy.Name) }
		hx-target="#main-content"
		hx-swap="innerHTML"
		hx-push-url="true"
	>
		@components.TableCell("left", "w-1/4") {
			<div class="font-medium text-neutral-900 dark:text-neutral-100">
				{ policy.Name }
			</div>
		}
		@components.TableCell("left", "") {
			<span class="text-neutral-700 dark:text-neutral-300">
				{ policy.Description }
			</span>
		}
		@components.TableCell("right", "w-48") {
			<div class="text-neutral-600 dark:text-neutral-400">
				<div>{ formatTimeAgo(policy.ModifiedAt) }</div>
				<div class="text-xs text-neutral-500 dark:text-neutral-500">
					{ formatTimeShort(policy.ModifiedAt) }
				</div>
			</div>
		}
	</tr>
}

// formatTimeShort formats a time.Time in short format
func formatTimeShort(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return t.Format("Jan 2, 2006 15:04")
}

// formatTimeAgo formats a time.Time as a relative time string
func formatTimeAgo(t time.Time) string {
	// Handle zero time (when timestamp is not available)
	if t.IsZero() {
		return "unknown"
	}

	duration := time.Since(t)

	if duration < time.Minute {
		return "just now"
	} else if duration < time.Hour {
		minutes := int(duration.Minutes())
		if minutes == 1 {
			return "1 minute ago"
		}
		return fmt.Sprintf("%d minutes ago", minutes)
	} else if duration < 24*time.Hour {
		hours := int(duration.Hours())
		if hours == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", hours)
	} else {
		days := int(duration.Hours() / 24)
		if days == 1 {
			return "1 day ago"
		}
		return fmt.Sprintf("%d days ago", days)
	}
}
