package serverspartials

import (
	"fmt"
	"github.com/open-wander/wander/ui-htmx/templates/components"
)

// ServerSummary represents a summary view of a server for list display.
type ServerSummary struct {
	Name    string
	Address string
	Status  string
	Leader  bool
	Region  string
	Version string
}

// ListContent renders the servers table content for HTMX partial updates.
templ ListContent(serversList []ServerSummary, sortColumn string, sortDir string) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="sm:flex sm:items-center sm:justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">Servers</h1>
				<p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">
					View and manage Nomad servers
				</p>
			</div>
		</div>
		<div class="bg-white dark:bg-neutral-900 shadow rounded-lg overflow-hidden">
			@components.Table(components.TableProps{
				Columns: []components.Column{
					{Key: "name", Label: "Name", Sortable: true, Align: "left", Width: "w-1/4"},
					{Key: "address", Label: "Address", Sortable: true, Align: "left", Width: "w-1/4"},
					{Key: "status", Label: "Status", Sortable: true, Align: "center", Width: "w-32"},
					{Key: "leader", Label: "Leader", Sortable: true, Align: "center", Width: "w-24"},
					{Key: "region", Label: "Region", Sortable: true, Align: "left", Width: "w-32"},
					{Key: "version", Label: "Version", Sortable: true, Align: "right"},
				},
				SortColumn: sortColumn,
				SortDir:    sortDir,
				Striped:    true,
				Hover:      true,
				SortURL:    "/ui/servers",
			}) {
				@components.TableBody() {
					if len(serversList) == 0 {
						@components.TableEmptyState("No servers found", "There are no servers to display")
					} else {
						for _, server := range serversList {
							@serverRow(server)
						}
					}
				}
			}
		</div>
	</div>
}

// serverRow renders a single server row in the table
templ serverRow(server ServerSummary) {
	<tr class="transition-colors duration-100 hover:bg-neutral-50 dark:hover:bg-neutral-800">
		@components.TableCell("left", "w-1/4") {
			<div class="font-medium text-neutral-900 dark:text-neutral-100">
				{ server.Name }
			</div>
		}
		@components.TableCell("left", "w-1/4") {
			<span class="text-neutral-700 dark:text-neutral-300 font-mono text-sm">
				{ server.Address }
			</span>
		}
		@components.TableCell("center", "w-32") {
			@components.Badge(components.BadgeProps{
				Variant: statusVariant(server.Status),
				Dot:     true,
			}) {
				{ server.Status }
			}
		}
		@components.TableCell("center", "w-24") {
			if server.Leader {
				@components.Badge(components.BadgeProps{
					Variant: "primary",
					Dot:     false,
				}) {
					Leader
				}
			} else {
				<span class="text-neutral-500 dark:text-neutral-400">Peer</span>
			}
		}
		@components.TableCell("left", "w-32") {
			<span class="text-neutral-700 dark:text-neutral-300">
				{ server.Region }
			</span>
		}
		@components.TableCell("right", "") {
			<span class="text-neutral-600 dark:text-neutral-400 font-mono text-sm">
				{ server.Version }
			</span>
		}
	</tr>
}

// statusVariant maps server status to badge variant
func statusVariant(status string) string {
	switch status {
	case "alive":
		return "success"
	case "failed":
		return "danger"
	case "left":
		return "neutral"
	default:
		return "neutral"
	}
}
