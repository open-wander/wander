package jobspartials

// DefinitionTab renders the job definition tab (placeholder)
templ DefinitionTab() {
	<div class="p-6">
		<h3 class="text-lg font-medium text-neutral-900 mb-4">Definition</h3>
		<p class="text-neutral-600">Job definition content will be displayed here.</p>
	</div>
}

// VersionsTab renders the job versions tab (placeholder)
templ VersionsTab() {
	<div class="p-6">
		<h3 class="text-lg font-medium text-neutral-900 mb-4">Versions</h3>
		<p class="text-neutral-600">Job version history will be displayed here.</p>
	</div>
}

