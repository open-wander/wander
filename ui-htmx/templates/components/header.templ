package components

// HeaderProps contains parameters for the page header component
type HeaderProps struct {
	CurrentPath    string
	User           *UserInfo // Optional user information
	Breadcrumbs    []Breadcrumb
	CurrentRegion  string         // Current selected region/datacenter
	AvailableRegions []RegionInfo // List of available regions
}

// UserInfo contains user details for display
type UserInfo struct {
	Name  string
	Email string
}

// Breadcrumb represents a navigation breadcrumb item
type Breadcrumb struct {
	Label string
	URL   string
}

// RegionInfo represents a region/datacenter option
type RegionInfo struct {
	ID   string // e.g., "us-east-1", "global"
	Name string // e.g., "US East (N. Virginia)", "Global"
}

// Header provides the top navigation bar with breadcrumbs, mobile menu toggle, and user menu.
// Uses Alpine.js to communicate with sidebar for mobile toggle.
templ Header(props HeaderProps) {
	<header
		id="header"
		class="flex-shrink-0 border-b border-neutral-200 bg-white shadow-sm"
		aria-label="Page header"
		x-data="{ mobileMenuOpen: false }"
	>
		<div class="flex items-center justify-between h-16 px-4 lg:px-6">
			<!-- Left: Mobile menu button and breadcrumbs -->
			<div class="flex items-center space-x-4 flex-1 min-w-0">
				<!-- Mobile menu button -->
				<button
					type="button"
					@click="$dispatch('toggle-sidebar')"
					class="lg:hidden inline-flex items-center justify-center p-2 rounded-md text-neutral-500 hover:text-neutral-700 hover:bg-neutral-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary-500 transition-colors"
					aria-label="Toggle sidebar"
				>
					<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
				<!-- Breadcrumbs -->
				if len(props.Breadcrumbs) > 0 {
					<nav class="flex min-w-0" aria-label="Breadcrumb">
						<ol class="flex items-center space-x-2">
							for i, crumb := range props.Breadcrumbs {
								<li class="flex items-center">
									if i > 0 {
										<svg class="flex-shrink-0 h-5 w-5 text-neutral-400 mr-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
											<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
										</svg>
									}
									if crumb.URL != "" {
										<a
											href={ templ.SafeURL(crumb.URL) }
											class="text-sm font-medium text-neutral-600 hover:text-neutral-900 transition-colors truncate"
										>
											{ crumb.Label }
										</a>
									} else {
										<span class="text-sm font-medium text-neutral-900 truncate">
											{ crumb.Label }
										</span>
									}
								</li>
							}
						</ol>
					</nav>
				}
			</div>
			<!-- Right: Region selector and user menu -->
			<div class="flex items-center space-x-4 flex-shrink-0">
				<!-- Region/Datacenter Selector -->
				if len(props.AvailableRegions) > 0 {
					@Dropdown(DropdownProps{ID: "region-selector", Position: "right", Width: "md", Class: "hidden sm:inline-block"}) {
						@DropdownTrigger() {
							<button
								type="button"
								class="flex items-center space-x-2 px-3 py-1.5 rounded-md bg-neutral-100 hover:bg-neutral-200 text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500"
								aria-label="Select region"
							>
								<svg class="h-4 w-4 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								<span class="text-neutral-700 font-medium">
									if props.CurrentRegion != "" {
										{ props.CurrentRegion }
									} else {
										Global
									}
								</span>
								<svg class="h-4 w-4 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
								</svg>
							</button>
						}
						@DropdownMenu(DropdownProps{Position: "right", Width: "md"}) {
							for _, region := range props.AvailableRegions {
								@DropdownItemComponent(DropdownItem{
									Label: region.Name,
									HxPost: "/api/region/select",
									HxTarget: "body",
									HxSwap: "none",
								})
							}
						}
					}
				} else {
					<!-- Fallback: Static region badge when no regions configured -->
					<div class="hidden sm:flex items-center space-x-2 px-3 py-1.5 rounded-md bg-neutral-100 text-sm">
						<svg class="h-4 w-4 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span class="text-neutral-700 font-medium">Global</span>
					</div>
				}
				<!-- User Menu -->
				if props.User != nil {
					@Dropdown(DropdownProps{ID: "user-menu", Position: "right", Width: "md"}) {
						@DropdownTrigger() {
							<button
								type="button"
								class="flex items-center space-x-2 p-2 rounded-md hover:bg-neutral-100 focus:outline-none focus:ring-2 focus:ring-primary-500 transition-colors"
								aria-label="User menu"
							>
								<div class="h-8 w-8 rounded-full bg-primary-600 flex items-center justify-center text-white font-medium text-sm">
									{ string(props.User.Name[0]) }
								</div>
								<svg class="h-4 w-4 text-neutral-500 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
								</svg>
							</button>
						}
						@DropdownMenu(DropdownProps{Position: "right", Width: "md"}) {
							<div class="px-4 py-3 border-b border-neutral-100">
								<p class="text-sm font-medium text-neutral-900">{ props.User.Name }</p>
								<p class="text-sm text-neutral-500 truncate">{ props.User.Email }</p>
							</div>
							@DropdownItemComponent(DropdownItem{
								Label: "Settings",
								Href:  "/settings",
								Icon:  "settings",
							})
							@DropdownDividerItem()
							@DropdownItemComponent(DropdownItem{
								Label: "Sign out",
								Href:  "/logout",
								Icon:  "logout",
							})
						}
					}
				} else {
					<!-- Not logged in: show placeholder user icon -->
					<div class="flex items-center space-x-2">
						<div class="h-8 w-8 rounded-full bg-neutral-200 flex items-center justify-center">
							<svg class="h-5 w-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
							</svg>
						</div>
					</div>
				}
			</div>
		</div>
	</header>
}
