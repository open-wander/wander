package components

import "strings"

// SelectOption represents a single option in a select dropdown
type SelectOption struct {
	Value    string
	Label    string
	Disabled bool
}

// SelectProps contains parameters for the Select component
type SelectProps struct {
	Name        string
	ID          string
	Options     []SelectOption
	Selected    string
	Placeholder string
	Required    bool
	Disabled    bool
	Size        string // "sm", "md", "lg"
	Error       string
	Class       string
	// HTMX
	HxGet     string
	HxPost    string
	HxTarget  string
	HxTrigger string
}

// Select renders a styled native select dropdown component with support for various sizes,
// error states, and HTMX attributes for dynamic behavior.
//
// Features:
//   - Native select element with custom styling
//   - Size variants: sm, md (default), lg
//   - Error state with message display
//   - Placeholder option support
//   - Disabled options support
//   - Full HTMX attribute support for dependent selects
//   - Required field support
//   - Disabled state styling
//
// Example Usage:
//
//	@Select(SelectProps{
//	    Name: "country",
//	    ID: "country",
//	    Placeholder: "Select a country",
//	    Options: []SelectOption{
//	        {Value: "us", Label: "United States"},
//	        {Value: "ca", Label: "Canada"},
//	        {Value: "mx", Label: "Mexico"},
//	    },
//	    Required: true,
//	})
//
//	@Select(SelectProps{
//	    Name: "category",
//	    Size: "sm",
//	    Options: []SelectOption{
//	        {Value: "1", Label: "Electronics"},
//	        {Value: "2", Label: "Books"},
//	        {Value: "3", Label: "Clothing", Disabled: true},
//	    },
//	    HxGet: "/api/products",
//	    HxTarget: "#product-list",
//	    HxTrigger: "change",
//	})
//
//	@Select(SelectProps{
//	    Name: "status",
//	    Selected: "active",
//	    Error: "Please select a valid status",
//	    Options: []SelectOption{
//	        {Value: "active", Label: "Active"},
//	        {Value: "inactive", Label: "Inactive"},
//	    },
//	})
templ Select(props SelectProps) {
	<div class="w-full">
		<div class="relative">
			<select
				if props.ID != "" {
					id={ props.ID }
				}
				if props.Name != "" {
					name={ props.Name }
				}
				class={ buildSelectClasses(props) }
				if props.Required {
					required
				}
				if props.Disabled {
					disabled
				}
				if props.HxGet != "" {
					hx-get={ props.HxGet }
				}
				if props.HxPost != "" {
					hx-post={ props.HxPost }
				}
				if props.HxTarget != "" {
					hx-target={ props.HxTarget }
				}
				if props.HxTrigger != "" {
					hx-trigger={ props.HxTrigger }
				}
			>
				if props.Placeholder != "" {
					<option value="" disabled?={ props.Selected == "" } selected?={ props.Selected == "" }>
						{ props.Placeholder }
					</option>
				}
				for _, opt := range props.Options {
					<option
						value={ opt.Value }
						selected?={ opt.Value == props.Selected }
						disabled?={ opt.Disabled }
					>
						{ opt.Label }
					</option>
				}
			</select>
			@chevronDownIcon(props.Size)
		</div>
		if props.Error != "" {
			<p class="form-error">{ props.Error }</p>
		}
	</div>
}

// buildSelectClasses constructs the complete CSS class string for a select element
func buildSelectClasses(props SelectProps) string {
	classes := []string{"select"}

	// Add size class
	size := props.Size
	if size == "sm" {
		classes = append(classes, "select-sm")
	} else if size == "lg" {
		classes = append(classes, "select-lg")
	}

	// Add error state class
	if props.Error != "" {
		classes = append(classes, "select-error")
	}

	// Add custom classes
	if props.Class != "" {
		classes = append(classes, props.Class)
	}

	return strings.Join(classes, " ")
}

// chevronDownIcon renders a chevron down icon for the select dropdown
templ chevronDownIcon(size string) {
	<div class={ chevronIconPosition(size) }>
		<svg
			class={ chevronIconSize(size) }
			xmlns="http://www.w3.org/2000/svg"
			fill="none"
			viewBox="0 0 24 24"
			stroke-width="1.5"
			stroke="currentColor"
			aria-hidden="true"
		>
			<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
		</svg>
	</div>
}

// chevronIconPosition returns the positioning classes for the chevron icon
func chevronIconPosition(size string) string {
	switch size {
	case "sm":
		return "absolute inset-y-0 right-0 pr-2 flex items-center pointer-events-none"
	case "lg":
		return "absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none"
	default:
		return "absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none"
	}
}

// chevronIconSize returns the appropriate size classes for the chevron icon
func chevronIconSize(size string) string {
	switch size {
	case "sm":
		return "h-4 w-4 text-neutral-400"
	case "lg":
		return "h-6 w-6 text-neutral-400"
	default:
		return "h-5 w-5 text-neutral-400"
	}
}
