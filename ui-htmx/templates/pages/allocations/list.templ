package allocations

import (
	"github.com/open-wander/wander/ui-htmx/templates/components"
	"github.com/open-wander/wander/ui-htmx/templates/layouts"
	"github.com/open-wander/wander/ui-htmx/templates/partials/allocationspartials"
)

// List renders the full allocations list page with layout.
templ List(props allocationspartials.ListProps) {
	@layouts.PageLayout(
		layouts.PageLayoutProps{
			Title:       "Allocations - Wander",
			Description: "View and manage Nomad allocations",
			CurrentPath: "/ui/allocations",
			Breadcrumbs: []components.Breadcrumb{
				{Label: "Home", URL: "/ui/"},
				{Label: "Allocations", URL: ""},
			},
		},
		allocationspartials.ListContent(props),
	)
}
