package policies

import (
	"github.com/open-wander/wander/ui-htmx/templates/layouts"
	"github.com/open-wander/wander/ui-htmx/templates/partials/policiespartials"
)

// List renders the full ACL policies list page with layout.
templ List(layoutProps layouts.PageLayoutProps, policiesList []policiespartials.PolicySummary, sortColumn string, sortDir string, searchQuery string) {
	@layouts.PageLayout(layoutProps, policiespartials.ListContent(policiesList, sortColumn, sortDir, searchQuery))
}
