package servers

import (
	"github.com/open-wander/wander/ui-htmx/templates/layouts"
	"github.com/open-wander/wander/ui-htmx/templates/partials/serverspartials"
)

// List renders the full servers list page with layout.
templ List(layoutProps layouts.PageLayoutProps, serversList []serverspartials.ServerSummary, sortColumn string, sortDir string) {
	@layouts.PageLayout(layoutProps, serverspartials.ListContent(serversList, sortColumn, sortDir))
}
