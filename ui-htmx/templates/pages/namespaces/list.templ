package namespaces

import (
	"github.com/open-wander/wander/ui-htmx/templates/layouts"
	"github.com/open-wander/wander/ui-htmx/templates/partials/namespacespartials"
)

// List renders the full namespaces list page with layout.
templ List(layoutProps layouts.PageLayoutProps, namespacesList []namespacespartials.NamespaceSummary) {
	@layouts.PageLayout(layoutProps, namespacespartials.ListContent(namespacesList))
}
