package jobs

import (
	"github.com/open-wander/wander/ui-htmx/templates/layouts"
	"github.com/open-wander/wander/ui-htmx/templates/partials/jobspartials"
)

// List renders the full jobs list page with layout.
templ List(props layouts.PageLayoutProps, jobsList []jobspartials.JobSummary, sortColumn string, sortDir string, searchQuery string, pagination jobspartials.PaginationMeta) {
	@layouts.PageLayout(
		props,
		jobspartials.ListContent(jobsList, sortColumn, sortDir, searchQuery, pagination),
	)
}
