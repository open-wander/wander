package jobs

import (
	"github.com/open-wander/wander/ui-htmx/templates/components"
	"github.com/open-wander/wander/ui-htmx/templates/layouts"
	"github.com/open-wander/wander/ui-htmx/templates/partials/jobspartials"
)

// List renders the full jobs list page with layout.
templ List(jobsList []jobspartials.JobSummary, sortColumn string, sortDir string, searchQuery string, pagination jobspartials.PaginationMeta) {
	@layouts.PageLayout(
		layouts.PageLayoutProps{
			Title:       "Jobs - Wander",
			Description: "View and manage Nomad jobs",
			CurrentPath: "/ui/jobs",
			Breadcrumbs: []components.Breadcrumb{
				{Label: "Home", URL: "/ui/"},
				{Label: "Jobs", URL: ""},
			},
		},
		jobspartials.ListContent(jobsList, sortColumn, sortDir, searchQuery, pagination),
	)
}
