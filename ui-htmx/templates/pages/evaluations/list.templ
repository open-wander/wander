package evaluations

import (
	"github.com/open-wander/wander/ui-htmx/templates/layouts"
	"github.com/open-wander/wander/ui-htmx/templates/partials/evaluationspartials"
)

// List renders the full evaluations list page with layout.
templ List(layoutProps layouts.PageLayoutProps, evalsList []evaluationspartials.EvaluationSummary) {
	@layouts.PageLayout(layoutProps, evaluationspartials.ListContent(evalsList))
}
